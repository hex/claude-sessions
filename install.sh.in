#!/usr/bin/env bash
# ABOUTME: Installation script for cs (Claude Code session manager)
# ABOUTME: Installs binaries, hooks, commands, skills, and shell completions
# ABOUTME: build.sh splices lib/01-manifests.sh in at the marker to write install.sh.

set -euo pipefail

# Colors - Claude warm palette (rust → orange → gold)
# Disable colors if NO_COLOR is set (https://no-color.org) or not a TTY
if [[ -n "${NO_COLOR:-}" ]] || [[ ! -t 1 ]]; then
    RED=''
    GREEN=''
    YELLOW=''
    ORANGE=''
    GOLD=''
    RUST=''
    COMMENT=''
    BOLD=''
    NC=''
else
    RED='\033[38;2;239;83;80m'        # #ef5350 - warm red
    GREEN='\033[38;2;139;195;74m'     # #8bc34a - vibrant green
    YELLOW='\033[38;2;255;183;77m'    # #ffb74d - warm amber
    ORANGE='\033[38;2;255;138;101m'   # #ff8a65 - coral orange
    GOLD='\033[38;2;255;193;7m'       # #ffc107 - golden
    RUST='\033[38;2;230;74;25m'       # #e64a19 - terracotta
    COMMENT='\033[38;2;161;136;127m'  # #a1887f - warm taupe
    BOLD='\033[1m'
    NC='\033[0m'
fi

error() {
    [ -z "${_STEP_LIVE:-}" ] || printf '\r\033[K'
    echo -e "${RED}Error: $1${NC}" >&2
    exit 1
}

# Every line sits in the same three-space gutter as the Installed lines and
# the closing check mark: a dim dot marks a note, an amber triangle a warning.
info() {
    _step_clear
    echo -e "   ${COMMENT}·${NC} ${GREEN}$1${NC}"
    _step_redraw
}

warn() {
    _step_clear
    echo -e "   ${YELLOW}▲ $1${NC}"
    _step_redraw
}

# A follow-on line of the note or warning above it, aligned with its text.
info_more() {
    _step_clear
    echo -e "     ${GREEN}$1${NC}"
    _step_redraw
}

warn_more() {
    _step_clear
    echo -e "     ${YELLOW}$1${NC}"
    _step_redraw
}

# A phase of the install is one line: while it runs, a gold asterisk and its
# present-tense label on a terminal; once done, a green check, the past-tense
# label and, in the second column, what it did. Off a terminal only the done
# line prints. A note or warning raised while a phase is running takes the
# line, and the running label is drawn again under it.
_STEP_LIVE=""
_STEP_LABEL=""
_step() {  # label
    _step_clear
    _STEP_LABEL="$1"
    if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
        _STEP_LIVE=1
        printf '   %b✳%b %s…' "$GOLD" "$NC" "$1"
    fi
}
_step_clear() {
    [ -n "$_STEP_LIVE" ] || return 0
    printf '\r\033[K'
}
_step_redraw() {
    [ -n "$_STEP_LIVE" ] || return 0
    printf '   %b✳%b %s…' "$GOLD" "$NC" "$_STEP_LABEL"
}
_done() {  # label, detail
    _step_clear
    _STEP_LIVE=""
    _STEP_LABEL=""
    printf '   %b✓%b %-24s %b%s%b\n' "$GREEN" "$NC" "$1" "$COMMENT" "$2" "$NC"
}

show_banner() {
    # Smooth gradient: rust (#e64a19) → gold (#ffc107)
    local GT='\033[38;2;230;74;25mc\033[38;2;232;83;24ml\033[38;2;234;91;22ma\033[38;2;235;100;21mu\033[38;2;237;108;20md\033[38;2;239;117;19me\033[38;2;241;125;17m-\033[38;2;243;134;16ms\033[38;2;245;142;15me\033[38;2;246;151;14ms\033[38;2;248;159;12ms\033[38;2;250;168;11mi\033[38;2;252;176;10mo\033[38;2;254;185;9mn\033[38;2;255;193;7ms'
    echo ""
    echo -e "   ${RUST}╭───────────────────────╮${NC}"
    echo -e "   ${RUST}│${NC}    ${GT}${NC}    ${GOLD}│${NC}"
    echo -e "   ${GOLD}╰───────────────────────╯${NC}"
    echo ""
}

# Configuration
INSTALL_DIR="${HOME}/.local/bin"
HOOKS_PARENT_DIR="${HOME}/.claude/hooks"
HOOKS_DIR="${HOOKS_PARENT_DIR}/cs"
COMMANDS_DIR="${HOME}/.claude/commands"
BASH_COMPLETION_DIR="${HOME}/.bash_completion.d"
ZSH_COMPLETION_DIR="${HOME}/.zsh/completions"
# Detect existing zsh completion dir from user's fpath config
if [ -f "$HOME/.zshrc" ]; then
    _detected_dir=$(grep -oE 'fpath.*~/\.zsh/completions?' "$HOME/.zshrc" 2>/dev/null | grep -oE '~/\.zsh/completions?' | head -1 | sed "s|~|$HOME|") || true
    if [ -n "$_detected_dir" ]; then
        ZSH_COMPLETION_DIR="$_detected_dir"
    fi
fi
CLAUDE_SETTINGS="${HOME}/.claude/settings.json"
SESSIONS_DIR="${HOME}/.claude-sessions"
# Payload ref: `cs -update` pins this to the release tag (v<version>) so the
# downloaded scripts/hooks match the verified installer. Without it the
# installer reads CS_DEFAULT_REF: main in the checkout, which the release
# workflow rewrites to the tag in the install.sh it publishes, so either
# fetches the files whose sha256s it carries (CS_PAYLOAD_SHA256 below).
CS_DEFAULT_REF=main
REPO_URL="https://raw.githubusercontent.com/hex/claude-sessions/${CS_INSTALL_REF:-$CS_DEFAULT_REF}"
ARCHIVE_URL="https://codeload.github.com/hex/claude-sessions/tar.gz/${CS_INSTALL_REF:-$CS_DEFAULT_REF}"
RELEASES_URL="https://github.com/hex/claude-sessions/releases/download"

# @@CS_MANIFESTS@@

# The sha256 of every file a web install downloads, as "<sha256>  <repo
# path>", written by build.sh from the files it was built with. This
# installer is authenticated by an SSH-signed manifest before `cs -update`
# runs it, so a payload file that does not
# match is not the file that was released.
# @@CS_PAYLOAD_SHA256@@

# Everything that lands in HOOKS_DIR, for the copy and cleanup loops. The
# libraries go first: a web install that stops partway then leaves new
# libraries under old hooks, which still run, rather than new hooks without
# the library they source.
CS_HOOK_FILES=("${CS_HOOK_LIBS[@]}" "${CS_HOOKS[@]}")

_check_retired_names

# Stop, before anything is deployed, on a settings.json that holds one of the
# events cs registers a hook under (CS_HOOK_EVENTS) as something other than a
# list: that value is the user's and stays as it is, so cs's hook cannot be
# added to it. A missing or null event is one cs creates. Without jq no hook
# is registered at all, and a file jq cannot parse, or one that is not a
# regular file (never opened here), is refused further down, once the
# payload's cs_settings_check is at hand, still before anything is placed.
_refuse_a_hook_event_that_is_not_a_list() {
    local event
    command -v jq >/dev/null 2>&1 || return 0
    [ -f "$CLAUDE_SETTINGS" ] && [ -s "$CLAUDE_SETTINGS" ] || return 0
    event=$(jq -r --arg events "${CS_HOOK_EVENTS[*]}" '
        (if type == "object" then .hooks else null end) as $hooks
        | if ($hooks | type) == "object" then
            first(($events | split(" "))[] | select($hooks[.] != null and ($hooks[.] | type) != "array"))
        else empty end
    ' "$CLAUDE_SETTINGS" 2>/dev/null) || return 0
    [ -z "$event" ] || error "$CLAUDE_SETTINGS holds a hooks.$event that is not a list, so cs's hook cannot be added to it; nothing was installed"
}
_refuse_a_hook_event_that_is_not_a_list

CS_RELEASE_SIGNERS='release namespaces="cs-release-*" ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFMX5MLo9e2hYyqNVkQzfxbFcIk4/UL9Atz01BsbfGZ8'
# Revoked release keys, one per line. cs -update reads this declaration out
# of a downloaded installer as data: exactly one declaration, single-quoted.
CS_RELEASE_REVOKED=''

# Verifies a release manifest against its signature: manifest, signature,
# release version. The signature is bound to the release through its
# namespace, cs-release-v<version>, so a manifest signed for one tag never
# verifies another.
_verify_manifest() {  # manifest, signature, version
    (
        if ! command -v ssh-keygen >/dev/null 2>&1; then
            printf '%s\n' 'ssh-keygen is required to verify release manifests.' >&2
            exit 1
        fi
        trust_dir=$(mktemp -d "${TMPDIR:-/tmp}/cs-release.XXXXXX") || exit 1
        trap 'rm -rf "$trust_dir"' EXIT
        printf '%s\n' "$CS_RELEASE_SIGNERS" > "$trust_dir/signers" || exit 1
        printf '%s' "$CS_RELEASE_REVOKED" > "$trust_dir/revoked" || exit 1
        local revocation_args=()
        [ ! -s "$trust_dir/revoked" ] || revocation_args=(-r "$trust_dir/revoked")
        if ! ssh-keygen -Y verify -f "$trust_dir/signers" -I release -n "cs-release-v$3" \
            -s "$2" ${revocation_args[@]+"${revocation_args[@]}"} < "$1" > "$trust_dir/verify.log" 2>&1; then
            # The verifier's own reason, then the fixed diagnostic last.
            tail -n 5 "$trust_dir/verify.log" >&2
            printf '%s\n' 'Release manifest signature verification failed.' >&2
            exit 1
        fi
    )
}

verify_checksum() {
    local file="$1" checksumfile="$2" asset="${3:-${1##*/}}"
    local expected actual
    expected=$(awk -v asset="$asset" '
        $2 == asset {
            count++
            if (NF != 2 || length($1) != 64 || $1 ~ /[^0-9a-f]/) bad=1
            digest=$1
        }
        END { if (count != 1 || bad) exit 1; print digest }
    ' "$checksumfile") || return 1
    if command -v sha256sum &>/dev/null; then
        actual=$(sha256sum "$file" | awk '{print $1}') || return 1
    elif command -v shasum &>/dev/null; then
        actual=$(shasum -a 256 "$file" | awk '{print $1}') || return 1
    else
        # Fail closed: a verification gate that can't verify must not pass.
        echo "Error: no sha256sum or shasum found — cannot verify download. Install one and retry." >&2
        return 1
    fi
    [ "$expected" = "$actual" ]
}

# Detect if running from cloned repo or web install. An installer read from a
# pipe (curl ... | bash) has no BASH_SOURCE: it is the web install, whatever
# directory it was started in, and never takes that directory as a checkout.
SCRIPT_DIR=""
if [ -n "${BASH_SOURCE[0]:-}" ]; then
    SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
fi
if [ -n "$SCRIPT_DIR" ] && [ -f "$SCRIPT_DIR/bin/cs" ]; then
    # Running from cloned repo
    INSTALL_METHOD="local"
else
    # Running from web (curl | bash)
    INSTALL_METHOD="web"
fi

# One temp dir for everything the web install downloads, removed however the
# install ends.
STAGE_DIR=$(mktemp -d "${TMPDIR:-/tmp}/cs-install.XXXXXX") || error "Could not create a temp dir to download into"
trap 'rm -rf "$STAGE_DIR"' EXIT

# Where the payload is read from: the checkout on a local install; on a web
# install the unpacked archive under STAGE_DIR, or STAGE_DIR itself when the
# files were downloaded one by one.
if [ "$INSTALL_METHOD" = "local" ]; then
    PAYLOAD_DIR="$SCRIPT_DIR"
else
    PAYLOAD_DIR="$STAGE_DIR"
fi

# Download URL $1 to file $2 with curl, or wget when there is no curl.
_download() {  # url, out
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL "$1" -o "$2"
    else
        wget -q "$1" -O "$2"
    fi
}

# The mode a payload file is deployed with, as the repo tracks it: the
# binaries, the hook files and the skill support scripts are executable; the
# Markdown passes /wrap reads from the hooks directory are not.
_payload_mode() {  # repo-path
    case "$1" in
        hooks/*.md) echo 644 ;;
        bin/*|hooks/*|skills/*/scripts/*) echo 755 ;;
        *) echo 644 ;;
    esac
}

# Put file $1 at $2 with mode $3 through a temp file in $2's own directory and
# a rename, so $2 is always either the file it was or the whole new one, never
# a partial copy: a dropped transfer or a full disk leaves the old file whole.
# A symlink at $2 (a dotfiles manager's, or one pointing at a checkout) is
# the user's and is kept, named in a warning and listed at the end, unless
# what it points at is content cs wrote (_cs_owns_file): only then is the
# link replaced by the file, in a line naming the link and where it pointed.
# The rename replaces the link itself, never writing through it, so its
# target is left as it was either way. A directory at $2 is kept and named
# the same way: a rename onto it would drop the file inside it.
# _PLACE_KEPT is set when the destination was kept instead of written, so a
# caller can count or report only what landed.
_PLACE_KEPT=""
_place_file() {  # src, dest, mode
    local dest="$2" dir tmp digest link_target=""
    _PLACE_KEPT=""
    if [ -d "$dest" ] && [ ! -L "$dest" ]; then
        warn "Kept $dest: a directory, so it was not replaced"
        CS_KEPT_PATHS+=("$dest")
        _PLACE_KEPT=1
        return 0
    fi
    if [ -L "$dest" ]; then
        digest=$(_cs_sha256_file "$1") || error "Could not compute the sha256 of $1 (needs sha256sum or shasum)"
        if ! _cs_owns_file "$dest" "$digest"; then
            warn "Kept $dest: a symlink to content cs did not write, so it was not replaced"
            CS_KEPT_PATHS+=("$dest")
            _PLACE_KEPT=1
            return 0
        fi
        link_target=$(readlink "$dest") || error "Could not read the symlink $dest"
    fi
    dir=$(dirname "$dest")
    mkdir -p "$dir" || error "Could not create $dir"
    tmp=$(mktemp "$dir/.cs-install.XXXXXX") || error "Could not create a temp file in $dir"
    if ! { cp "$1" "$tmp" && chmod "$3" "$tmp" && mv -f "$tmp" "$dest"; }; then
        rm -f "$tmp"
        error "Failed to install $dest"
    fi
    if [ -n "$link_target" ]; then
        info "Replaced symlink $dest (to $link_target) with a deployed copy"
    fi
}

# Deploy payload file $1 (its repo path) at $2.
_place() {  # repo-path, dest
    _place_file "$PAYLOAD_DIR/$1" "$2" "$(_payload_mode "$1")"
}

# The install record's lines for the files this install writes under
# ~/.claude, written out once every file is in place.
CS_RECORD_LINES=()
# What the placing phase reports: files written, and files left as they were.
CS_PLACED=0
CS_UNCHANGED=0

# Record sha256 $1 for path $2 (under $HOME) in the install record as soon as
# the file is in place, keeping every other line as it was: a run that stops
# partway then leaves a record true of each file, the placed ones under their
# new sha256 and the rest under the line the last install wrote.
_record_placed() {  # sha256, path-under-home
    local record tmp="$STAGE_DIR/installed.partial"
    record=$(_cs_install_record)
    if [ -f "$record" ]; then
        awk -v p="$2" 'substr($0, 67) != p' "$record" > "$tmp" || error "Could not read $record"
    else
        : > "$tmp"
    fi
    printf '%s  %s\n' "$1" "$2" >> "$tmp"
    _place_file "$tmp" "$record" 644
}

# Deploy payload file $1 at $2 under ~/.claude, unless a file cs did not
# write is already there: that one is kept, named in a warning and listed
# again at the end. A file is cs's as _cs_owns_file decides; a symlink that
# points nowhere holds nothing cs wrote, so it is kept too.
_deploy() {  # repo-path, dest
    local digest record existing=""
    digest=$(_cs_sha256_file "$PAYLOAD_DIR/$1") || error "Could not compute the sha256 of $1 (needs sha256sum or shasum)"
    # A regular file already there is hashed once, for both checks below.
    if [ -f "$2" ] && [ ! -L "$2" ]; then
        existing=$(_cs_sha256_file "$2") || existing=""
    fi
    # A deployed copy that already holds this content is cs's and is left in
    # place, its mode set again in case it drifted. A copy whose mode cannot
    # be set (not this user's file) goes through the replacement below. The
    # record gains its line now only when it lacks one, so a run that stops
    # later still names the file; a record that is not a regular file (a FIFO
    # would hold grep forever) is rewritten the way _record_placed rewrites it.
    if [ -n "$existing" ] && [ "$existing" = "$digest" ] \
        && chmod "$(_payload_mode "$1")" "$2" 2>/dev/null; then
        record=$(_cs_install_record)
        if ! { [ -f "$record" ] && grep -qxF "$digest  ${2#"$HOME"/}" "$record" 2>/dev/null; }; then
            _record_placed "$digest" "${2#"$HOME"/}"
        fi
        CS_RECORD_LINES+=("$digest  ${2#"$HOME"/}")
        CS_UNCHANGED=$((CS_UNCHANGED + 1))
        return 0
    fi
    if { [ -e "$2" ] || [ -L "$2" ]; } && ! _cs_owns_file "$2" "$digest"; then
        warn "Kept $2: cs did not write it, so it was not replaced"
        CS_KEPT_PATHS+=("$2")
        return 0
    fi
    _place "$1" "$2"
    [ -n "$_PLACE_KEPT" ] || CS_PLACED=$((CS_PLACED + 1))
    _record_placed "$digest" "${2#"$HOME"/}"
    CS_RECORD_LINES+=("$digest  ${2#"$HOME"/}")
}

# Check for Claude Code
if ! command -v claude >/dev/null 2>&1; then
    warn "Claude Code (claude) not found in PATH"
    warn "Please install Claude Code before using cs"
    warn "Visit: https://github.com/anthropics/claude-code"
    echo ""
fi

# cs takes every file lock through perl (flock(2) on a descriptor bash
# opened), so without it no session can be opened. Checked before anything
# is written.
if ! perl -MFcntl=:flock -e 1 >/dev/null 2>&1; then
    error "perl not found: cs locks its files through perl. Install perl and run the installer again."
fi

# Show banner
show_banner

# Whether downloaded file $PAYLOAD_DIR/$1 has the sha256 CS_PAYLOAD_SHA256
# carries for repo path $1. A path with no entry, a missing file, or a digest
# that cannot be computed, does not match.
_payload_matches() {  # repo-path
    local entry actual
    actual=$(_cs_sha256_file "$PAYLOAD_DIR/$1") || return 1
    for entry in "${CS_PAYLOAD_SHA256[@]}"; do
        if [ "${entry#*  }" = "$1" ]; then
            [ "${entry%%  *}" = "$actual" ]
            return
        fi
    done
    return 1
}

# Downloads the ref's source archive once and unpacks it under STAGE_DIR, so
# the payload arrives in one transfer instead of one per file. On success
# PAYLOAD_DIR is the unpacked tree; nothing in it is trusted until
# _payload_matches has checked it. Fails, saying why, when there is no tar,
# when the download fails, or when the archive does not unpack, and leaves
# PAYLOAD_DIR as it was so the caller can fetch the files one by one.
_fetch_payload_archive() {
    local tgz="$STAGE_DIR/payload.tar.gz" tree="$STAGE_DIR/tree"
    if ! command -v tar >/dev/null 2>&1; then
        warn "No tar found; downloading the files one by one"
        return 1
    fi
    if ! _download "$ARCHIVE_URL" "$tgz"; then
        warn "Could not download the source archive; downloading the files one by one"
        return 1
    fi
    mkdir -p "$tree" || error "Could not create $tree"
    if ! tar -xzf "$tgz" -C "$tree" --strip-components=1 2>/dev/null; then
        rm -rf "$tree"
        warn "The source archive did not unpack; downloading the files one by one"
        return 1
    fi
    PAYLOAD_DIR="$tree"
}

# A web install fetches the payload and checks every file against the sha256
# this installer carries before it puts any in place, so a transfer that fails
# partway, or a file that is not the released one, leaves the installed files
# as they were. The ref's source archive is one download; when it cannot be
# had, each file is downloaded on its own. A local install copies from its
# own checkout, which is what it was built from, and checks nothing.
if [ "$INSTALL_METHOD" = "web" ]; then
    if ! command -v curl >/dev/null 2>&1 && ! command -v wget >/dev/null 2>&1; then
        error "Neither curl nor wget found. Please install one of them."
    fi
    _step "Downloading release"
    _dl_start=$SECONDS
    if _fetch_payload_archive; then
        _dl_size=$(wc -c < "$STAGE_DIR/payload.tar.gz" | LC_ALL=C awk '{ printf "%.1f MB", $1 / 1048576 }')
        _done "Downloaded release" "$_dl_size · $((SECONDS - _dl_start)) s"
        _step "Verifying files"
        _verified=0
        while IFS= read -r _rel; do
            [ -f "$PAYLOAD_DIR/$_rel" ] || error "$_rel is not in the source archive; nothing was installed"
            _payload_matches "$_rel" \
                || error "$_rel does not match the sha256 this installer carries for it; nothing was installed"
            _verified=$((_verified + 1))
        done < <(_cs_payload_files)
        for _rel in "${CS_COMPLETION_FILES[@]}"; do
            if [ ! -f "$PAYLOAD_DIR/$_rel" ]; then
                warn "$_rel is not in the source archive; not installed"
            elif ! _payload_matches "$_rel"; then
                rm -f "$PAYLOAD_DIR/$_rel"
                warn "$_rel does not match the sha256 this installer carries for it; not installed"
            fi
        done
        _done "Verified $_verified files" "against the installer's digests"
    else
        _step "Downloading files"
        _verified=0
        while IFS= read -r _rel; do
            mkdir -p "$PAYLOAD_DIR/$(dirname "$_rel")"
            _download "$REPO_URL/$_rel" "$PAYLOAD_DIR/$_rel" || error "Failed to download $_rel"
            _payload_matches "$_rel" \
                || error "$_rel does not match the sha256 this installer carries for it; nothing was installed"
            _verified=$((_verified + 1))
        done < <(_cs_payload_files)
        for _rel in "${CS_COMPLETION_FILES[@]}"; do
            mkdir -p "$PAYLOAD_DIR/$(dirname "$_rel")"
            if ! _download "$REPO_URL/$_rel" "$PAYLOAD_DIR/$_rel"; then
                rm -f "$PAYLOAD_DIR/$_rel"
                warn "Failed to download $_rel"
            elif ! _payload_matches "$_rel"; then
                rm -f "$PAYLOAD_DIR/$_rel"
                warn "$_rel does not match the sha256 this installer carries for it; not installed"
            fi
        done
        _done "Downloaded $_verified files" "one by one, each against the installer's digests"
    fi
fi

# Stop, before anything is placed, on a settings.json jq cannot parse or that
# is not a regular file, which the settings step below would refuse only
# after every file was deployed.
# The check is cs_settings_check from the payload's shared library (the
# checkout, or the verified downloads), as the settings step runs it; without
# jq no hook is registered at all, so the file is not read.
# shellcheck source=hooks/cs-shared.sh
. "$PAYLOAD_DIR/hooks/cs-shared.sh" || error "could not load $PAYLOAD_DIR/hooks/cs-shared.sh; nothing was installed"
if command -v jq >/dev/null 2>&1; then
    cs_settings_check "$CLAUDE_SETTINGS" || error "$CS_SETTINGS_ERROR; nothing was installed"
fi

# Create install directory if needed
mkdir -p "$INSTALL_DIR"

# The version this install places, read from the payload's bin/cs:
# $INSTALL_DIR/cs may be a link _place_file kept, which holds content cs did
# not write and may point at anything, a FIFO included. The version installed
# before it, from the hooks' stamp, heads the report as "<old> → <new>".
CS_VERSION=$(grep -m1 "^VERSION=" "$PAYLOAD_DIR/bin/cs" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
CS_PREVIOUS=""
if [ -f "$HOOKS_DIR/.version" ] && [ ! -L "$HOOKS_DIR/.version" ]; then
    CS_PREVIOUS=$(head -n1 "$HOOKS_DIR/.version" 2>/dev/null || true)
fi
if [ -z "$CS_PREVIOUS" ]; then
    echo -e "   ${COMMENT}cs${NC} ${GOLD}${CS_VERSION}${NC}"
elif [ "$CS_PREVIOUS" = "$CS_VERSION" ]; then
    echo -e "   ${COMMENT}cs${NC} ${GOLD}${CS_VERSION}${NC} ${COMMENT}again${NC}"
else
    echo -e "   ${COMMENT}cs${NC} ${RUST}${CS_PREVIOUS}${NC} ${COMMENT}→${NC} ${GOLD}${CS_VERSION}${NC}"
fi
echo ""

_step "Placing files"
# Install cs, cs-secrets, cs-statusline and cs-subagent-statusline. The last
# sources cs-statusline for the shared palette, so the two must land in the
# same dir.
for _bin in cs cs-secrets cs-statusline cs-subagent-statusline; do
    _place "bin/$_bin" "$INSTALL_DIR/$_bin"
    [ -n "$_PLACE_KEPT" ] || CS_PLACED=$((CS_PLACED + 1))
done

# Records where the cs-tui just put in $INSTALL_DIR came from, in
# HOOKS_DIR/.tui-origin beside the .version stamp: "checkout <path>" for a
# copy from this checkout, "release" for the verified release asset. cs -doctor
# reads it from any folder to hold the picker to that checkout's build. It is
# written as soon as the picker is in place, and an install that places no
# picker leaves it as it was, since the picker it describes is still the one
# installed. A link _place_file kept (one to content cs did not write) is the
# user's own picker, not one this install placed, so it leaves the record too:
# a link it replaced is a file once placed, so -L is true only of a kept one.
_record_tui_origin() {  # origin
    [ ! -L "$INSTALL_DIR/cs-tui" ] || return 0
    local tmp="$STAGE_DIR/tui-origin"
    printf '%s\n' "$1" > "$tmp" || error "Could not write $tmp"
    _place_file "$tmp" "$HOOKS_DIR/.tui-origin" 644
}

# Install cs-tui (interactive session manager).
#
# bin/cs-tui is a gitignored build artifact and nothing regenerates it: build.sh
# assembles bin/cs from lib/ and has no TUI arm, while `cargo build --release`
# writes to tui/target/release/. Installing bin/cs-tui unconditionally therefore
# ships whatever binary happens to be sitting there, which has silently deployed
# a picker weeks older than the release being installed. A version check cannot
# catch it either: the picker carries no version of its own, so `cs -version`
# reads correct while the picker is stale. Prefer whichever of the two is newer.
_cs_tui_src="$SCRIPT_DIR/bin/cs-tui"
_cs_tui_built="$SCRIPT_DIR/tui/target/release/cs-tui"
if [ -f "$_cs_tui_built" ] && { [ ! -f "$_cs_tui_src" ] || [ "$_cs_tui_built" -nt "$_cs_tui_src" ]; }; then
    _cs_tui_src="$_cs_tui_built"
fi
CS_PICKER=""
if [ "$INSTALL_METHOD" = "local" ] && [ -f "$_cs_tui_src" ]; then
    _place_file "$_cs_tui_src" "$INSTALL_DIR/cs-tui" 755
    [ -n "$_PLACE_KEPT" ] || CS_PICKER="from this checkout"
    _record_tui_origin "checkout $SCRIPT_DIR"
elif [ "$INSTALL_METHOD" = "web" ]; then
    # The release this install downloaded, read from its verified bin/cs:
    # $INSTALL_DIR/cs may be a link _place_file kept, which is not this
    # release and may point at anything, a FIFO included.
    _cs_version=$(grep -m1 "^VERSION=" "$PAYLOAD_DIR/bin/cs" 2>/dev/null | cut -d'"' -f2 || echo "")
    _os=$(uname -s | tr '[:upper:]' '[:lower:]')
    _arch=$(uname -m)
    [ "$_arch" = "x86_64" ] && _arch="amd64"
    _tui_base="cs-tui-${_os}-${_arch}"
    # Downloaded and verified in the staging dir; only a binary that passes
    # both gates below is put in place.
    _tui_dst="$STAGE_DIR/cs-tui"
    _tui_url="${RELEASES_URL}/v${_cs_version}/${_tui_base}"
    if [ -n "$_cs_version" ] && curl -fsSL --head "$_tui_url" >/dev/null 2>&1 \
        && curl -fsSL "$_tui_url" -o "$_tui_dst"; then
        _manifest_url="${RELEASES_URL}/v${_cs_version}/SHA256SUMS"
        if ! curl -fsSL "$_manifest_url" -o "$STAGE_DIR/SHA256SUMS" 2>/dev/null \
            || ! curl -fsSL "$_manifest_url.sig" -o "$STAGE_DIR/SHA256SUMS.sig" 2>/dev/null; then
            rm -f "$_tui_dst"
            warn "cs-tui could not be verified (manifest or signature unavailable) -- removed"
        elif ! _verify_manifest "$STAGE_DIR/SHA256SUMS" "$STAGE_DIR/SHA256SUMS.sig" "$_cs_version"; then
            rm -f "$_tui_dst"
            warn "cs-tui signature verification failed -- removed"
        elif ! verify_checksum "$_tui_dst" "$STAGE_DIR/SHA256SUMS" "$_tui_base"; then
            rm -f "$_tui_dst"
            warn "cs-tui could not be verified (manifest entry or digest unavailable) -- removed"
        fi
        if [ -f "$_tui_dst" ]; then
            _place_file "$_tui_dst" "$INSTALL_DIR/cs-tui" 755
            [ -n "$_PLACE_KEPT" ] || CS_PICKER="${_os}-${_arch}, signed release"
            _record_tui_origin release
        fi
    else
        info "cs-tui not available for ${_os}-${_arch} — run 'cs' for help, or build from source: cd tui && cargo build --release"
    fi
fi

# Remove a stale opposite-platform TUI binary so a cross-platform reinstall can
# never leave cs-tui and cs-tui.exe side by side — which would let PATH lookup
# or the sibling probe select the wrong one and fail to launch. Keep only the
# name this platform installs.
rm -f "$INSTALL_DIR/cs-tui.exe"

# Install hooks
mkdir -p "$HOOKS_DIR"

# Removes file $1, under a name cs retired, when cs wrote it, and returns 0.
# A file cs did not write is kept and returns 1. It is in the way of nothing
# cs deploys, so it is named (and listed at the end) only the first time an
# install sees that content: the install record remembers it as a
# "kept <sha256>  <path under $HOME>" line, which never matches the
# "<sha256>  <path>" lines _cs_owns_file reads. Content whose sha256 cannot
# be computed, and a path holding a newline (the record holds one path per
# line), are named every time.
_remove_retired() {  # file
    _retired_is_ours "$1" || return 1
    rm -f "$1"
}

# Returns 0 when cs wrote file $1, under a name cs retired; otherwise keeps it
# as _remove_retired describes and returns 1.
_retired_is_ours() {  # file
    local digest line record
    if _cs_owns_file "$1"; then
        return 0
    fi
    record=$(_cs_install_record)
    if [[ "$1" != *$'\n'* ]] && digest=$(_cs_sha256_file "$1"); then
        line="kept $digest  ${1#"$HOME"/}"
        CS_RECORD_LINES+=("$line")
        if [ -f "$record" ] && grep -qxF "$line" "$record"; then
            return 1
        fi
    fi
    warn "Kept $1: cs did not write it"
    CS_KEPT_PATHS+=("$1")
    return 1
}

# Retired hook files that earlier cs versions installed but no longer ship,
# in HOOKS_DIR or, for installs that deployed hooks flat, its parent
# directory. Only a file cs wrote is listed; a user's own file of the same
# name is kept. The listed files go once settings.json no longer registers
# them, below: an install that stops before then, or has no jq to rewrite
# the settings, leaves each one beside its registration, and the install
# record keeps its line, so the next run still knows it as cs's.
# CS_RETIRED_HOOK_DIGESTS holds each listed file's sha256, by index.
CS_RETIRED_HOOK_FILES=()
CS_RETIRED_HOOK_DIGESTS=()
for retired in "${RETIRED_HOOKS[@]}"; do
    for dir in "$HOOKS_DIR" "$HOOKS_PARENT_DIR"; do
        if [ -f "$dir/$retired" ] && _retired_is_ours "$dir/$retired" \
            && _retired_digest=$(_cs_sha256_file "$dir/$retired"); then
            CS_RETIRED_HOOK_FILES+=("$dir/$retired")
            CS_RETIRED_HOOK_DIGESTS+=("$_retired_digest")
            CS_RECORD_LINES+=("$_retired_digest  ${dir#"$HOME"/}/$retired")
        fi
    done
done

# Returns 0 when $1 is a listed retired file that still holds the content cs
# wrote. The questions below can take any time, so the content is checked
# again here: a file replaced since it was listed is the user's, and so is
# anything that is no longer a regular file, which is never read (a link to
# a device or a FIFO would keep the hash, and the settings lock, waiting).
_retired_still_ours() {  # path
    local i digest
    for i in ${CS_RETIRED_HOOK_FILES[@]+"${!CS_RETIRED_HOOK_FILES[@]}"}; do
        [ "${CS_RETIRED_HOOK_FILES[$i]}" = "$1" ] || continue
        [ -f "$1" ] && [ ! -L "$1" ] || return 1
        digest=$(_cs_sha256_file "$1") || return 1
        [ "$digest" = "${CS_RETIRED_HOOK_DIGESTS[$i]}" ]
        return
    done
    return 1
}

# Returns 0 when hook file $1 stays after this install: it is there and is
# not a retired file that still holds what cs wrote.
_hook_file_stays() {  # path
    [ -e "$1" ] || [ -L "$1" ] || return 1
    ! _retired_still_ours "$1"
}

# The subdirectory copy is canonical; remove parent-level copies left by
# installs that deployed hooks flat into ~/.claude/hooks/, when cs wrote them.
for hook in "${CS_HOOK_FILES[@]}"; do
    if [ -f "$HOOKS_PARENT_DIR/$hook" ] && _cs_remove_if_owned "$HOOKS_PARENT_DIR/$hook"; then
        info "Removed $HOOKS_PARENT_DIR/$hook"
    fi
done

for hook in "${CS_HOOK_FILES[@]}"; do
    _deploy "hooks/$hook" "$HOOKS_DIR/$hook"
done


# Install commands
mkdir -p "$COMMANDS_DIR"

for cmd in "${CS_COMMANDS[@]}"; do
    _deploy "commands/$cmd" "$COMMANDS_DIR/$cmd"
done

# Drop commands earlier cs versions installed but no longer ship; only a file
# cs wrote goes, and a user's own file of that name is kept. A linked
# ~/.claude/commands is worked through by design, as the loop above deploys
# into it: only content cs wrote is removed, so the link is no boundary here.
for retired in "${RETIRED_COMMANDS[@]}"; do
    if [ -f "$COMMANDS_DIR/$retired" ] && _remove_retired "$COMMANDS_DIR/$retired"; then
        info "Removed retired command: $COMMANDS_DIR/$retired"
    fi
done

# Install skills
SKILLS_DIR="$HOME/.claude/skills"

# Drop skill directories earlier cs versions installed but no longer ship. A
# skill left on disk keeps answering its slash command, so a rename is not
# complete until the old directory is gone. Only the files cs wrote go; a
# user's own files in it (or a user's skill of that name) are kept.
for retired in "${RETIRED_SKILLS[@]}"; do
    if [ -d "$SKILLS_DIR/$retired" ] && _cs_remove_tree_if_owned "$SKILLS_DIR/$retired" _remove_retired; then
        info "Removed retired skill: $SKILLS_DIR/$retired/"
    fi
done

# Whether the symlinked directory $SKILLS_DIR/$1 points at cs's own mod
# files: every file the manifest deploys under it, read through the link, is
# content cs wrote (_cs_owns_file). A file missing there is not.
_mod_link_holds_cs_files() {  # path under SKILLS_DIR
    local f digest
    for f in "${CS_MOD_FILES[@]}"; do
        case "$f" in "$1"/*) ;; *) continue ;; esac
        digest=$(_cs_sha256_file "$PAYLOAD_DIR/mods/$f") || error "Could not compute the sha256 of mods/$f (needs sha256sum or shasum)"
        _cs_owns_file "$SKILLS_DIR/$f" "$digest" || return 1
    done
}

# The symlinked directories under SKILLS_DIR this install kept, one per line,
# so each is named once however many files sit under it.
_dir_links_kept=$'\n'

# Keeps the symlinked directory $SKILLS_DIR/$1: names it in warning $2 the
# first time, and lists it with the kept files.
_keep_dir_link() {  # path under SKILLS_DIR, warning
    case "$_dir_links_kept" in
        *$'\n'"$SKILLS_DIR/$1"$'\n'*) ;;
        *)
            warn "$2"
            CS_KEPT_PATHS+=("$SKILLS_DIR/$1")
            _dir_links_kept="$_dir_links_kept$SKILLS_DIR/$1"$'\n'
            ;;
    esac
}

# Whether mod file $1 can be deployed without writing through a symlinked
# directory: copying through the link would write into its target instead of
# deploying. A link on the path (the mod directory or the file's directory)
# that points at cs's own mod files (an earlier opt-in had the person link
# the whole directory at the checkout) is replaced by a real directory. One
# that points anywhere else is the user's: it is kept, named once and listed
# with the kept files, and returns 1 so nothing is placed under it. A link at
# the file itself is _deploy's to judge.
_mod_path_real() {
    local rel="$1" p
    for p in "${rel%%/*}" "$(dirname "$rel")"; do
        [ -L "$SKILLS_DIR/$p" ] || continue
        if _mod_link_holds_cs_files "$p"; then
            rm "$SKILLS_DIR/$p"
            info "Replaced symlink $SKILLS_DIR/$p with a deployed copy"
            continue
        fi
        _keep_dir_link "$p" "Kept $SKILLS_DIR/$p: a symlink to files cs did not write, so the mod files under it were not deployed"
        return 1
    done
}

# Whether skill file $1 (its path under SKILLS_DIR) can be deployed without
# writing through a symlinked directory. A link on the path (the skill
# directory or the file's directory) is the user's wherever it points, as cs
# never makes one: it is kept, named once and listed with the kept files, and
# returns 1 so nothing is placed under it. A link at the file itself is
# _deploy's to judge.
_skill_path_real() {
    local rel="$1" p
    for p in "${rel%%/*}" "$(dirname "$rel")"; do
        [ -L "$SKILLS_DIR/$p" ] || continue
        _keep_dir_link "$p" "Kept $SKILLS_DIR/$p: a symlink, so cs wrote nothing through it and the skill files under it were not deployed"
        return 1
    done
}

for skill in "${CS_SKILLS[@]}"; do
    if _skill_path_real "$skill/SKILL.md"; then
        _deploy "skills/$skill/SKILL.md" "$SKILLS_DIR/$skill/SKILL.md"
    fi
done
for skill_file in "${CS_SKILL_FILES[@]}"; do
    if _skill_path_real "$skill_file"; then
        _deploy "skills/$skill_file" "$SKILLS_DIR/$skill_file"
    fi
done
# The cs-update mod's own files are placed at the end of this script.
for mod_file in "${CS_MOD_FILES[@]}"; do
    case "$mod_file" in cs-update/*) continue ;; esac
    if _mod_path_real "$mod_file"; then
        _deploy "mods/$mod_file" "$SKILLS_DIR/$mod_file"
    fi
done

# Record what this install wrote under ~/.claude, so the next install, update
# or uninstall knows those files as cs's by their content. The cs-update mod's
# files are not placed yet, and _deploy at the end of this script asks this
# record whether each one is cs's, so the lines the last install wrote for them
# are carried over. That carry decides ownership: a module a checkout install
# wrote is in no release's known hashes, and without its line _deploy would
# keep it as the user's file and never update the mod. Each carried line stands
# until _deploy replaces that file. A file _deploy keeps keeps its line, which
# names content no longer at that path: the file counts as cs's again only if
# it comes to hold that content.
_record_tmp="$STAGE_DIR/installed"
if [ "${#CS_RECORD_LINES[@]}" -gt 0 ]; then
    printf '%s\n' "${CS_RECORD_LINES[@]}" > "$_record_tmp"
else
    : > "$_record_tmp"
fi
if [ -f "$(_cs_install_record)" ]; then
    awk 'index(substr($0, 67), ".claude/skills/cs-update/") == 1' "$(_cs_install_record)" >> "$_record_tmp" \
        || error "Could not read $(_cs_install_record)"
fi
_place_file "$_record_tmp" "$(_cs_install_record)" 644
if [ -n "$CS_PICKER" ]; then
    _done "Picker cs-tui" "$CS_PICKER"
fi

# Install shell completions. One a web install could not download was
# reported then, and is skipped here.
_completions=""
if [ -f "$PAYLOAD_DIR/completions/cs.bash" ]; then
    _place completions/cs.bash "$BASH_COMPLETION_DIR/cs.bash"
    _completions="bash"
fi
if [ -f "$PAYLOAD_DIR/completions/_cs" ]; then
    _place completions/_cs "$ZSH_COMPLETION_DIR/_cs"
    _completions="${_completions:+$_completions, }zsh"
fi
[ -z "$_completions" ] || _done "Completions" "$_completions"

# Configure Claude Code settings

# Create or merge settings.json
mkdir -p "$(dirname "$CLAUDE_SETTINGS")"

if ! command -v jq >/dev/null 2>&1; then
    warn "jq not found - cannot configure hooks automatically."
    warn "See README for manual hook configuration."
    _done "Hooks not registered" "no jq"
else
    # settings.json is read and rewritten once, by cs_settings_update from
    # the hooks' shared library in the payload (the checkout, or the verified
    # downloads), sourced before anything was placed, never the deployed
    # copy: a deployed cs-shared.sh that cs did not write is kept, and must
    # not run here. Under its lock and after every question below. A file jq
    # cannot parse was refused before anything was placed; one that has
    # become so since stops the install here, before any question, and is
    # left as it is.
    cs_settings_check "$CLAUDE_SETTINGS" || error "$CS_SETTINGS_ERROR"

    # Tilde spelling of HOOKS_DIR (settings.json entries use ~ instead of $HOME)
    HOOKS_TILDE_DIR="~/.claude/hooks/cs"

    # Strip the registration of flat-layout hook $1 (~/.claude/hooks/$1) from
    # SETTINGS, unless the file there stays: the clean-up above removed or
    # listed every flat file cs wrote, so one that stays is the user's own
    # hook, and its registration is theirs too.
    _strip_flat_hook() {  # name
        if _hook_file_stays "$HOOKS_PARENT_DIR/$1"; then
            return 0
        fi
        SETTINGS=$(_strip_hook_registration "$SETTINGS" "$HOOKS_PARENT_DIR/$1" "~/.claude/hooks/$1")
    }

    # The settings JSON in SETTINGS without any cs hook registration that the
    # merge below does not put back.
    _strip_cs_hooks() {
        # Strip retired hooks from any event in settings.json (event-agnostic since
        # we don't know which event the old version registered them under). Covers
        # both deployment layouts.
        # A retired file under HOOKS_DIR that stays was kept as the user's,
        # as for a flat one, so its registration stays too.
        for retired in "${RETIRED_HOOKS[@]}"; do
            _strip_flat_hook "$retired"
            if ! _hook_file_stays "$HOOKS_DIR/$retired"; then
                SETTINGS=$(_strip_hook_registration "$SETTINGS" "$HOOKS_DIR/$retired" "$HOOKS_TILDE_DIR/$retired")
            fi
        done

        # Strip parent-level registrations of current hooks (flat-layout installs);
        # _merge_cs_hook re-registers each one under HOOKS_DIR below.
        for hook in "${CS_HOOKS[@]}"; do
            _strip_flat_hook "$hook"
        done

        # Drop events that emptied out entirely after the strips. An event
        # whose list is empty goes whether the strips emptied it or the user
        # wrote it that way (deliberate, see _strip_hook_registration); an
        # event that is not a list stays.
        SETTINGS=$(echo "$SETTINGS" | jq '
            if .hooks then
                .hooks |= with_entries(select((.value | type) != "array" or (.value | length > 0)))
                | if .hooks == {} then del(.hooks) else . end
            else . end
        ')
    }

    # Merge hooks: strip cs's command from any wrapper's nested .hooks array,
    # drop wrappers that emptied out, then append a fresh standalone wrapper
    # for cs's hook. This preserves non-cs entries that the user co-shipped
    # inside the same wrapper (eg. `~/bin/claude-status` alongside cs's
    # session-end.sh) — the prior shape dropped the entire wrapper whenever
    # it contained cs's command, taking sibling user hooks with it.
    #
    # An entry whose `.hooks` is not an array (flat shape with the command at
    # the top level, a `.hooks` of any other type, or an entry that is not an
    # object) passes through untouched, and so does an element of a `.hooks`
    # array that is not an object: only an object in an array `.hooks` can be
    # cs's registration, as in _strip_hook_registration. A wrapper whose
    # `.hooks` array is empty is dropped whether the strip emptied it or the
    # user wrote it that way (deliberate, see _strip_hook_registration). An
    # event that is not a list (and not null) is the user's and is never
    # rewritten: _refuse_a_hook_event_that_is_not_a_list stops the install on
    # one before anything is deployed, and the filter fails on one that
    # appears afterwards, which leaves settings.json as it was. The
    # spec tests in tests/test_hooks.sh run a copy of this filter,
    # _install_merge_filter, and one of them compares the two texts.
    _merge_cs_hook() {
        local event="$1" file="$2" timeout="$3" matcher="${4:-}" async="${5:-}" rewake="${6:-}"
        local path="$HOOKS_DIR/$file" tilde="$HOOKS_TILDE_DIR/$file"
        local append
        # asyncRewake makes a hook's exit 2 wake the model with its stderr,
        # wrapped in a system-reminder under the rewakeMessage prefix. It
        # implies async, so it does not also need the async flag. Without it the
        # hook still runs and its output is discarded — the wake becomes a
        # five-second toast nobody reads.
        #
        # The labels are static in settings.json while the one FileChanged entry
        # now carries two wake kinds — cross-session mail and the /clear
        # rotation kick — so they name neither. The stderr reason says which it
        # is; a label claiming "mail" would tell the user the wrong story about
        # what started the turn, and was doing exactly that until it was caught
        # in a live rotation.
        append=$(jq -n --arg cmd "$tilde" --argjson timeout "$timeout" \
            --arg matcher "$matcher" --arg async "$async" --arg rewake "$rewake" '
            (if $matcher != "" then {matcher: $matcher} else {} end)
            + {hooks: [
                {type: "command", command: $cmd, timeout: $timeout}
                + (if $async == "true" then {async: true} else {} end)
                + (if $rewake == "true" then {
                       asyncRewake: true,
                       rewakeMessage: "cs woke this session:",
                       rewakeSummary: "cs"
                   } else {} end)
              ]}
        ')
        SETTINGS=$(echo "$SETTINGS" | jq \
            --arg event "$event" \
            --arg path "$path" \
            --arg tilde "$tilde" \
            --argjson append "$append" '
            if .hooks[$event] != null and (.hooks[$event] | type) != "array" then
                error("hooks.\($event) is not a list")
            else
                .hooks[$event] = (
                    ((.hooks[$event] // []) | map(
                        if type == "object" and (.hooks | type) == "array" then
                            .hooks |= map(select(type != "object" or (.command != $path and .command != $tilde)))
                        else . end
                    ) | map(select(type != "object" or (.hooks | type) != "array" or (.hooks | length > 0))))
                    + [$append]
                )
            end
        ')
    }

    # Registration table: event, file, timeout, [matcher], [async], [rewake]
    #
    # FileChanged carries no matcher on purpose: for that event the matcher both
    # seeds the watch path and supplies the dispatch query as the changed file's
    # BASENAME, so a matcher naming the maildir would watch it and then never
    # fire — and maildir filenames are unpredictable, so no basename matcher can
    # be written either. The watch path arrives instead as watchPaths from
    # session-start.sh, and the hook filters file_path to its own mailbox.
    #
    # CwdChanged is registered for one reason: a cwd change REPLACES the
    # session's dynamic watch list with what its CwdChanged hooks return, so
    # answering nothing loses the maildir watch for the rest of the session.
    # Registering FileChanged is itself what opens that path, so the mailbox has
    # to answer the event its own registration enables.
    #
    # Stop carries two entries. stop-blocks.sh's blocks must continue the
    # turn (the queue drain, the staged retire, the mail wake). stop-notices.sh
    # is async: a synchronous Stop hook that hands the model text always draws
    # Claude Code's stop-hook row in the chat, while an async one draws none and
    # its additionalContext reaches the model with the next prompt.
    _register_cs_hooks() {
        _merge_cs_hook SessionStart       session-start.sh       30
        _merge_cs_hook PostToolUse        autosave-commits.sh    10 "Write|Edit" true
        _merge_cs_hook Stop               stop-blocks.sh         10
        _merge_cs_hook Stop               stop-notices.sh        10 "" true
        _merge_cs_hook SessionEnd         session-end.sh         30
        _merge_cs_hook SubagentStart      subagent-context.sh    10
        _merge_cs_hook PostToolUseFailure tool-failure-logger.sh 10 "" true
        _merge_cs_hook PermissionRequest  session-auto-approve.sh 5 "Write|Edit"
        _merge_cs_hook UserPromptSubmit   scope-prompt.sh        10
        _merge_cs_hook FileChanged        stop-blocks.sh         10 "" "" true
        _merge_cs_hook CwdChanged         stop-blocks.sh          5
    }

    # Register cs-statusline as the Claude Code status line. A status line the
    # user already configured is never replaced silently: a bridge that runs
    # cs-statusline is kept without recording a decline, even with a decline
    # marker present. Otherwise prompt when a terminal is attached or keep it
    # and print how to switch. The file is only looked at here; the registration
    # is written with the rest.
    _statusline_cmd="$INSTALL_DIR/cs-statusline"
    _current_statusline=""
    if [ -s "$CLAUDE_SETTINGS" ]; then
        _current_statusline=$(jq -r '.statusLine.command // ""' "$CLAUDE_SETTINGS")
    fi
    # A "no" is remembered here so `cs -update` (which re-runs this installer)
    # stops asking on every release. `cs -statusline enable` clears it,
    # `cs -statusline disable` sets it (KEEP IN SYNC with lib/70-statusline.sh).
    _statusline_declined="${XDG_CONFIG_HOME:-$HOME/.config}/cs/statusline-declined"
    # A preference memo must never take the install down with it. Both writes
    # below run under errexit and `touch` ends the && list, so a failure — an
    # unwritable ~/.config/cs, which an earlier root-run install leaves behind —
    # aborted the run BEFORE settings.json was written: hooks copied but never
    # registered, no version stamp, no completion message. Report and continue.
    # The second message is used when the memo did not land, so the user is not
    # told they will stop being asked when they will.
    # Declining is permanent, so it gets its own line rather than a clause at
    # the end of the outcome. The default answer at the replace prompt is "no",
    # which means a user pressing enter to skip one release opts out for good —
    # a decision they should see stated, not skim past.
    _remember_statusline_decline() {  # outcome_line, undo_hint
        if mkdir -p "$(dirname "$_statusline_declined")" 2>/dev/null \
            && touch "$_statusline_declined" 2>/dev/null; then
            info "$1"
            info_more "You won't be asked again. $2"
        else
            warn "$1"
            warn_more "(could not record the choice in $_statusline_declined, so cs -update will ask again)"
        fi
    }

    # Show what is being offered before asking for it. The payload is fixed and
    # the segments are pinned: the live ones read git state, unread mail and
    # rate limits from whatever session is running, which would put the user's
    # own branch name and inbox into an installer preview. Best-effort — a
    # sample that cannot render must not stop the install, so every failure
    # path here falls through to the question on its own.
    _preview_statusline() {
        command -v jq >/dev/null 2>&1 || return 0
        [ -x "$INSTALL_DIR/cs-statusline" ] || return 0
        local sample
        sample=$(jq -nc '{
            session_name: "my-session",
            context_window: {used_percentage: 34},
            model: {display_name: "Opus 5", id: "claude-opus-5"},
            effort: {level: "high"},
            rate_limits: {five_hour: {used_percentage: 41},
                          seven_day: {used_percentage: 72}}
        }' 2>/dev/null) || return 0
        # Draw it for the terminal it will appear in. The statusline falls back
        # to its dark palette whenever it can measure nothing, and a subprocess
        # inherits no way to measure — so a light terminal saw a dark bar, which
        # is precisely the thing a "what it looks like" sample must not get
        # wrong. install.sh still owns the tty and has just installed the binary
        # that can answer, so it asks; an unknown answer is left unset and the
        # statusline keeps its own fallback.
        # Only signals already in the environment. `cs -detect-theme` would be
        # the accurate answer, but it asks the terminal over OSC 11 and writes
        # that probe straight to /dev/tty — which no capture can intercept, so
        # the escape and its reply paint themselves across the installer's
        # output. A preview is not worth a garbled screen: read what the
        # terminal has already published, and when it has published nothing,
        # leave the statusline its own fallback.
        local _theme="${CS_TERM_THEME:-}"
        if [ -z "$_theme" ] && [ -n "${COLORFGBG:-}" ]; then
            case "${COLORFGBG##*;}" in
                7|9|1[0-5]) _theme="light" ;;
                0|[1-6]|8)  _theme="dark" ;;
            esac
        fi
        case "$_theme" in light|dark) ;; *) _theme="" ;; esac
        # Exported in a subshell rather than as a command prefix: an empty
        # ${_theme:+...} expansion would vanish and leave the binary running as
        # the prefix's own argument list, which renders nothing.
        local rendered
        rendered=$(
            export CS_STATUSLINE_SEGMENTS=logo,session,model,ctx,limits
            [ -z "$_theme" ] || export CS_TERM_THEME="$_theme"
            printf '%s' "$sample" | "$INSTALL_DIR/cs-statusline" 2>/dev/null
        ) || return 0
        [ -n "$rendered" ] || return 0
        # No indent: the statusline opens with a reset that eats leading spaces,
        # so an indented printf produced a bar flush against the margin while
        # every other line sat three spaces in.
        echo ""
        info "This is what it looks like:"
        printf '%s\n' "$rendered"
        echo ""
    }

    # Twin: _statusline_chains_to_cs in lib/60-doctor.sh.
    # Follows a bare path (~-prefixed or absolute) with optional arguments; interpreters, quoted paths and $HOME fall through to the doctor's hedged WARN.
    _statusline_chains_to_cs() {
        local file rest
        read -r file rest <<< "$1"
        file="${file/#\~/$HOME}"
        [ -f "$file" ] && [ -r "$file" ] && grep -qF -- cs-statusline "$file" 2>/dev/null
    }

    # Each branch only decides consent; the registration itself happens once
    # below. "quiet" re-registers an existing cs-statusline entry (refreshing
    # the path) without announcing it.
    _register_statusline=""
    case "$_current_statusline" in
        */cs-statusline)
            _register_statusline=quiet
            ;;
        *)
            if _statusline_chains_to_cs "$_current_statusline"; then
                info "Keeping current status line: $_current_statusline runs cs-statusline."
            elif [ -f "$_statusline_declined" ]; then
                info "Status line not registered (declined earlier). Enable any time with: cs -statusline enable"
            elif [ -z "$_current_statusline" ]; then
                # The status bar is user-visible UI: claim it only with consent.
                # Interactive installs ask (default yes); non-interactive installs
                # leave it off and say how to enable.
                if [ -t 0 ]; then
                    _preview_statusline
                    # read -p prints its argument verbatim, so an escape in it
                    # would show as literal characters. Emit the styled prompt
                    # with echo -e and read with no prompt of its own.
                    echo -en "   Register ${BOLD}cs-statusline${NC} as the Claude Code status line? [Y/n] "
                    read -n 1 -r
                    echo ""
                    if [[ $REPLY =~ ^[Nn]$ ]]; then
                        _remember_statusline_decline \
                            "Status line not registered." \
                            "Turn it on any time with: cs -statusline enable"
                    else
                        _register_statusline=1
                    fi
                else
                    info "Status line not registered. Enable any time with: cs -statusline enable"
                fi
            else
                if [ -t 0 ]; then
                    _preview_statusline
                    echo -en "   Replace current status line ($_current_statusline) with ${BOLD}cs-statusline${NC}? [y/N] "
                    read -n 1 -r
                    echo ""
                    # Anything but y declines, enter included: the point of the
                    # change is that cs -update stops asking, and a default that
                    # left the question open would re-prompt the people it was
                    # written for. The decline says plainly that it is
                    # remembered, and cs -statusline enable reverses it.
                    if [[ $REPLY =~ ^[Yy]$ ]]; then
                        _register_statusline=1
                    else
                        _remember_statusline_decline \
                            "Keeping current status line." \
                            "To switch to cs-statusline: cs -statusline enable"
                    fi
                else
                    warn "Keeping current status line. To switch to cs-statusline:"
                    warn_more "set statusLine.command to $_statusline_cmd in ~/.claude/settings.json"
                fi
            fi
            ;;
    esac
    # The rounded capsule caps are the bar's one private-use glyph, so the
    # renderer draws square ends until this machine has said its font has
    # them. Ask once, here, while the sample is still on screen; the answer
    # is per machine and `cs -statusline caps on|off|ask` rewrites it (KEEP
    # THE PATH IN SYNC with lib/70-statusline.sh and bin/cs-statusline).
    # Non-interactive installs write nothing and say how to answer later.
    _statusline_caps="${XDG_CONFIG_HOME:-$HOME/.config}/cs/statusline-caps"
    if { [ -n "$_register_statusline" ] || _statusline_chains_to_cs "$_current_statusline"; } \
        && [ ! -f "$_statusline_caps" ]; then
        if [ -t 0 ]; then
            printf '\n   %s\n' "$(printf '\xee\x82\xb6')cs-statusline$(printf '\xee\x82\xb4')"
            # An explicit y or n only: the registration question just above
            # reads one key, so an Enter typed after it is still queued and
            # would answer this one. EOF (Ctrl-D) leaves the question
            # unanswered and lets the install finish; `read` returning
            # non-zero must not trip errexit before settings.json is written.
            _caps_answer=""
            while :; do
                echo -en "   Do the ends of that capsule render as rounded shapes (not boxes)? [y/n] "
                if ! read -n 1 -r; then echo ""; break; fi
                echo ""
                case "$REPLY" in
                    [Yy]) _caps_answer=on; break ;;
                    [Nn]) _caps_answer=off; break ;;
                esac
            done
            if [ -z "$_caps_answer" ]; then
                info "Capsule caps: left unanswered (square ends). Answer later with: cs -statusline caps ask"
            elif mkdir -p "$(dirname "$_statusline_caps")" 2>/dev/null \
                && printf '%s\n' "$_caps_answer" > "$_statusline_caps" 2>/dev/null; then
                info "Capsule caps: $_caps_answer. Change later with: cs -statusline caps on|off|ask"
            else
                warn "Capsule caps: $_caps_answer, but the answer could not be recorded in $_statusline_caps"
                warn_more "The bar shows square ends until: cs -statusline caps $_caps_answer"
            fi
        else
            info "Capsule caps: square ends until you answer once with: cs -statusline caps ask"
        fi
    fi
    # Claude Code's spinner tips read one tipsFile, and cs's says how to turn
    # on the band's prompt bars. It is named in settings.json only while no
    # file is named there, the deployed tips file is a regular file (Claude
    # Code refuses a link), and the record allows it: "named" once cs named
    # it, "declined" once the person took it out, so cs -update never puts it
    # back. A record cs cannot read as either counts as declined. A file the
    # user named stays, and cs's tip is left out. The user's own tips, label
    # and excludeDefault are never touched. Read here, as the filter prints
    # nothing; the filter checks again under the lock.
    _cs_tips_deployed=""
    if [ -f "$SKILLS_DIR/cs/tips.json" ] && [ ! -L "$SKILLS_DIR/cs/tips.json" ]; then
        _cs_tips_deployed=1
    fi
    _tips_state=unset _current_tips_file=""
    if [ -s "$CLAUDE_SETTINGS" ]; then
        _tips_state=$(jq -r --arg tilde "$CS_TIPS_FILE" --arg abs "$HOME/.claude/skills/cs/tips.json" '.spinnerTipsOverride
            | if . == null then "unset"
              elif type != "object" then "not-object"
              elif (.tipsFile // "") == "" then "unset"
              elif .tipsFile == $tilde or .tipsFile == $abs then "cs"
              else "foreign" end' "$CLAUDE_SETTINGS")
        _current_tips_file=$(jq -r '.spinnerTipsOverride.tipsFile? // "" | tostring' "$CLAUDE_SETTINGS")
    fi
    _tips_record_file=$(_cs_tips_record_file)
    _tips_record=none
    if [ -e "$_tips_record_file" ] || [ -L "$_tips_record_file" ]; then
        _tips_record=$(cat "$_tips_record_file" 2>/dev/null || true)
        case "$_tips_record" in
            named|declined) ;;
            *)
                warn "Spinner tips: $_tips_record_file holds neither named nor declined, so cs's tip is kept out as declined"
                _tips_record=declined
                ;;
        esac
    fi
    # Like the status line's memo, a record write must never take the install
    # down: report and continue.
    _write_tips_record() {  # named | declined
        mkdir -p "$(dirname "$_tips_record_file")" 2>/dev/null \
            && { printf '%s\n' "$1" > "$_tips_record_file"; } 2>/dev/null
    }
    _tips_not_deployed="Spinner tips: $SKILLS_DIR/cs/tips.json was not deployed as a file, so cs's tip is not in Claude Code's tips"
    _tips_kept_out="Spinner tips: cs's tip stays out of Claude Code's tips, as recorded in $_tips_record_file; to have it back, delete that file and run cs -update"
    _tips_name=""
    case "$_tips_record:$_tips_state" in
        *:foreign)
            info "Spinner tips: ~/.claude/settings.json names its own tipsFile ($_current_tips_file), and Claude Code reads one; cs's tip (turn on the band's prompt bars in /cs) is left out"
            ;;
        *:not-object)
            warn "Spinner tips: spinnerTipsOverride in ~/.claude/settings.json is not an object; left as it is, so cs's tip is not in Claude Code's tips"
            ;;
        none:unset)
            # No record of consent, no pointer: the record is written first.
            if [ -z "$_cs_tips_deployed" ]; then
                warn "$_tips_not_deployed"
            elif _write_tips_record named; then
                _tips_name=1
                info "Spinner tips: named cs's tips file in ~/.claude/settings.json (spinnerTipsOverride.tipsFile)"
            else
                warn "Spinner tips: could not write $_tips_record_file, so cs's tips file is not named in ~/.claude/settings.json"
            fi
            ;;
        none:cs)
            # Named by an install from before the record.
            _write_tips_record named \
                || warn "Spinner tips: could not write $_tips_record_file, so if you take cs's tipsFile out, cs -update puts it back"
            [ -n "$_cs_tips_deployed" ] || warn "$_tips_not_deployed"
            ;;
        named:cs)
            [ -n "$_cs_tips_deployed" ] || warn "$_tips_not_deployed"
            ;;
        named:unset)
            # cs named it and it is gone: the person took it out.
            if _write_tips_record declined; then
                info "$_tips_kept_out"
            else
                warn "Spinner tips: cs's tip stays out of Claude Code's tips, but could not write $_tips_record_file"
            fi
            ;;
        declined:unset)
            info "$_tips_kept_out"
            ;;
        declined:cs)
            # Put back by hand after a decline: left as it is, and saying it
            # stays out would be false.
            ;;
    esac

    # settings.json on stdin, with cs's hooks and the status line the answers
    # above chose, on stdout. cs_settings_update runs it under the lock, so it
    # prints nothing else and asks nothing.
    _cs_settings_filter() {
        SETTINGS=$(cat)
        _strip_cs_hooks
        _register_cs_hooks
        if [ -n "$_register_statusline" ]; then
            # Registers BOTH settings keys and a 60 s refreshInterval, same as
            # `cs -statusline enable`; the two recipes must stay equivalent
            # (KEEP IN SYNC with lib/70-statusline.sh).
            SETTINGS=$(echo "$SETTINGS" | jq --arg cmd "$_statusline_cmd" \
                --arg subcmd "$INSTALL_DIR/cs-subagent-statusline" \
                '.statusLine = {type: "command", command: $cmd, refreshInterval: 60}
                 | .subagentStatusLine = {type: "command", command: $subcmd}')
        fi
        if [ -n "$_tips_name" ]; then
            SETTINGS=$(echo "$SETTINGS" | jq --arg tips "$CS_TIPS_FILE" '
                if .spinnerTipsOverride == null then .spinnerTipsOverride = {tipsFile: $tips}
                elif (.spinnerTipsOverride | type) == "object" and (.spinnerTipsOverride.tipsFile // "") == ""
                then .spinnerTipsOverride.tipsFile = $tips
                else . end')
        fi
        printf '%s\n' "$SETTINGS"
    }
    if ! cs_settings_update "$CLAUDE_SETTINGS" _cs_settings_filter; then
        # The record says cs named its tips file, and it did not: a "named"
        # record with no pointer would read as a decline on the next install.
        [ -z "$_tips_name" ] || rm -f "$_tips_record_file"
        error "$CS_SETTINGS_ERROR"
    fi
    # settings.json no longer registers them, so the retired files can go,
    # each one that still holds what cs wrote; the filter kept the
    # registration of any other
    for retired in ${CS_RETIRED_HOOK_FILES[@]+"${CS_RETIRED_HOOK_FILES[@]}"}; do
        if _retired_still_ours "$retired"; then
            rm -f "$retired"
            info "Removed retired hook: $retired"
        else
            warn "Kept $retired: it changed during the install"
            CS_KEPT_PATHS+=("$retired")
        fi
    done
    if [ "$_register_statusline" = "1" ]; then
        # shellcheck disable=SC2088  # a tilde the user reads, not a path cs opens
        _done "Registered hooks" "~/.claude/settings.json · status line"
    else
        # shellcheck disable=SC2088  # a tilde the user reads, not a path cs opens
        _done "Registered hooks" "~/.claude/settings.json"
    fi

    # Add cs's keys that nothing binds yet to keybindings.json, each into the
    # first block of the context Claude Code wants it in (Chat for the
    # command keys, Global for the chords), or a block of that context of
    # its own, creating the file when there is none. A cs key that sits in a
    # block of another context is moved: its cs bindings leave that block
    # (which goes if that empties it) and the key joins its own context. A
    # key bound to anything else, in any context, is the user's and is
    # reported, never replaced or moved; so is a bare key a chord would
    # shadow. cs's own Option+1 / Option+2 bindings stood for /rotate and
    # /wrap, so they make way unless Ctrl+X R or Ctrl+X W conflicts: then
    # both stay, so the command whose chord is taken keeps a key. A conflict
    # on a band chord leaves both commands their chords and keeps nothing.
    # The chords share one prefix, so the bare key they would shadow is named
    # in one warning for the file. A file of a shape cs cannot read is refused
    # before anything is written. The write is cs_write_atomic's, from the
    # hooks' shared library deployed above: mode kept, and a symlinked file (a
    # dotfiles manager's) rewritten through its link.
    _bind_rotate_wrap_keys() {
        local file doc status state key action prefix added="" command_conflicts=0 retired="" add
        local moved="" moved_chat="" moved_global="" payload="" line=""
        local shadowed="" shadowed_prefix="" shadowed_action=""
        file="$(_cs_keybindings_file)"
        if [ -e "$file" ]; then
            if ! _cs_keybindings_shape_ok "$file"; then
                warn "Rotate/wrap keys: $file is not JSON with a \"bindings\" array; left as it is. Fix it, then run cs -update."
                return 1
            fi
            doc=$(cat "$file") || { warn "Rotate/wrap keys: could not read $file"; return 1; }
        else
            doc='{"bindings":[]}'
        fi
        status=$(printf '%s\n' "$doc" | _cs_rotate_wrap_keys_status) \
            || { warn "Rotate/wrap keys: could not read the bindings in $file"; return 1; }
        while IFS=$'\t' read -r state key action prefix; do
            case "$state" in
                conflict)
                    case "$key" in
                        "ctrl+x r"|"ctrl+x w") command_conflicts=$((command_conflicts + 1)) ;;
                    esac
                    if [ -n "$prefix" ]; then
                        shadowed="${shadowed:+$shadowed, }$key"
                        shadowed_prefix="$prefix"
                        shadowed_action="$action"
                    else
                        warn "Rotate/wrap keys: $key is already bound to $action in $file; left as it is."
                    fi
                    ;;
                free)
                    added="${added:+$added, }$key"
                    payload="${payload:+$payload, }$key"
                    ;;
                misplaced)
                    moved="${moved:+$moved, }$key"
                    payload="${payload:+$payload, }$key"
                    case "$action" in
                        Chat) moved_chat="${moved_chat:+$moved_chat, }$key" ;;
                        Global) moved_global="${moved_global:+$moved_global, }$key" ;;
                        *) warn "Rotate/wrap keys: no such context as \"$action\" for $key; $file left as it is."; return 1 ;;
                    esac
                    ;;
            esac
        done <<< "$status"
        if [ -n "$shadowed" ]; then
            warn "Rotate/wrap keys: $shadowed would shadow $shadowed_prefix, which is bound to $shadowed_action in $file; left as they are."
        fi
        if [ "$command_conflicts" = 0 ]; then
            retired=$(printf '%s\n' "$doc" | _cs_keybindings_held "$CS_RETIRED_OPTION_KEYS") \
                || { warn "Rotate/wrap keys: could not read the bindings in $file"; return 1; }
            if [ -n "$retired" ]; then
                doc=$(printf '%s\n' "$doc" | _cs_keybindings_strip "$CS_RETIRED_OPTION_KEYS") \
                    || { warn "Rotate/wrap keys: could not read the bindings in $file"; return 1; }
            fi
        fi
        [ -n "$payload" ] || [ -n "$retired" ] || return 0
        add=$(jq -cn --argjson cs "$CS_ROTATE_WRAP_KEYS" --arg keys "$payload" \
            '$cs | with_entries(select(.key as $k | $keys | split(", ") | any(.[]; . == $k)))') \
            || { warn "Rotate/wrap keys: could not build the bindings for $file"; return 1; }
        # The payload's copy, as above: never the deployed one.
        # shellcheck source=hooks/cs-shared.sh
        if ! . "$PAYLOAD_DIR/hooks/cs-shared.sh"; then
            warn "Rotate/wrap keys: could not load $PAYLOAD_DIR/hooks/cs-shared.sh; $file left as it is."
            return 1
        fi
        mkdir -p "$(dirname "$file")" 2>/dev/null || true
        # A moved key's cs bindings leave every block of a context that is
        # not the action's home, then the payload joins the first block of
        # each home context, Chat before Global when both are created. A key
        # some block of its home context already holds, under any spelling,
        # is not added again.
        if ! printf '%s\n' "$doc" | cs_write_atomic "$file" jq --argjson cs "$CS_ROTATE_WRAP_KEYS" \
            --argjson add "$add" --arg moved "$moved" "$_CS_KEYBINDING_DEFS"'
            def astray($ctx): ours and ((.key | keynorm) as $k | $moved | split(", ") | any(.[]; . == $k))
                and (.value | home) != $ctx;
            .bindings |= map(. as $b
                | if any((.bindings // {}) | to_entries[]; astray($b.context)) then
                    .bindings |= with_entries(select(astray($b.context) | not)) | select(.bindings != {})
                  else . end)
            | reduce ("Chat", "Global") as $ctx (.;
                [.bindings[] | select(.context == $ctx) | (.bindings // {}) | to_entries[] | select(ours) | .key | keynorm] as $held
                | ($add | with_entries(select((.value | home == $ctx) and (.key as $k | $held | any(.[]; . == $k) | not)))) as $part
                | if $part == {} then .
                  else (first(.bindings | to_entries[] | select(.value.context == $ctx) | .key) // null) as $i
                    | if $i == null then .bindings += [{context: $ctx, bindings: $part}]
                      else .bindings[$i].bindings = ((.bindings[$i].bindings // {}) + $part) end
                  end)'; then
            warn "Rotate/wrap keys: could not write $file"
            return 1
        fi
        [ -z "$added" ] || line="bound $added"
        [ -z "$moved_chat" ] || line="${line:+$line and }moved $moved_chat to the Chat context"
        [ -z "$moved_global" ] || line="${line:+$line and }moved $moved_global to the Global context"
        if [ -z "$line" ]; then
            info "Rotate/wrap keys: removed cs's $retired from $file"
        elif [ -z "$retired" ]; then
            info "Rotate/wrap keys: $line in $file"
        else
            info "Rotate/wrap keys: $line in $file (replacing cs's $retired)"
        fi
    }

    # Ctrl+X R runs /rotate, Ctrl+X W runs /wrap, and Ctrl+X 1 / Ctrl+X 2 press
    # the cs band's keys, through Claude Code's own keybindings.json. Keys are
    # the user's keyboard, so they are offered once per machine and the answer
    # is recorded: a yes is honoured on every
    # install (keys already bound are left as they are), a no is never asked
    # again, and with no terminal nothing is written or recorded. Every step
    # reports and carries on; a keybinding must never take the install down.
    _rotate_wrap_keys_answer_file="$(_cs_rotate_wrap_keys_answer_file)"
    _rotate_wrap_keys_answer=$(cat "$_rotate_wrap_keys_answer_file" 2>/dev/null) || _rotate_wrap_keys_answer=""
    case "$_rotate_wrap_keys_answer" in
        yes) ;;
        no)
            info "Rotate/wrap keys: not bound (declined earlier). To be asked again, remove $_rotate_wrap_keys_answer_file and run cs -update."
            ;;
        *)
            _rotate_wrap_keys_answer=""
            if [ -t 0 ]; then
                # An explicit y or n only: the status-line questions above read
                # one key, so an Enter typed after one of them is still queued
                # and would answer this one. EOF leaves it unanswered.
                while :; do
                    echo -en "   Bind Ctrl+X R to /rotate, Ctrl+X W to /wrap and Ctrl+X 1/2 to the cs band in Claude Code? [y/n] "
                    if ! read -n 1 -r; then echo ""; break; fi
                    echo ""
                    case "$REPLY" in
                        [Yy]) _rotate_wrap_keys_answer=yes; break ;;
                        [Nn]) _rotate_wrap_keys_answer=no; break ;;
                    esac
                done
                if [ -z "$_rotate_wrap_keys_answer" ]; then
                    info "Rotate/wrap keys: left unanswered; the next install asks again."
                elif ! { mkdir -p "$(dirname "$_rotate_wrap_keys_answer_file")" \
                        && printf '%s\n' "$_rotate_wrap_keys_answer" > "$_rotate_wrap_keys_answer_file"; } 2>/dev/null; then
                    warn "Rotate/wrap keys: the answer could not be recorded in $_rotate_wrap_keys_answer_file, so the next install asks again."
                elif [ "$_rotate_wrap_keys_answer" = no ]; then
                    info "Rotate/wrap keys: not bound. You won't be asked again; to change that, remove $_rotate_wrap_keys_answer_file and run cs -update."
                fi
            else
                info "Rotate/wrap keys: not bound. To bind Ctrl+X R to /rotate, Ctrl+X W to /wrap and Ctrl+X 1/2 to the cs band, run cs -update in a terminal."
            fi
            ;;
    esac
    if [ "$_rotate_wrap_keys_answer" = yes ]; then
        _bind_rotate_wrap_keys || true
    fi
fi

# Check if ~/.local/bin is in PATH
if [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
    echo ""
    warn "$INSTALL_DIR is not in your PATH"
    warn_more "Add this line to your ~/.bashrc, ~/.zshrc, or equivalent:"
    warn_more "  export PATH=\"\$HOME/.local/bin:\$PATH\""
fi

# Stamp the deployed-hooks version so cs -doctor can flag installs whose
# deployed artifacts lag behind the running cs binary. Written as .tui-origin
# is, through _place_file: the rename replaces a FIFO at the stamp's path
# rather than opening it, and a link there is kept and named.
if [ "$CS_VERSION" != "unknown" ]; then
    printf '%s\n' "$CS_VERSION" > "$STAGE_DIR/version" || error "Could not write $STAGE_DIR/version"
    _place_file "$STAGE_DIR/version" "$HOOKS_DIR/.version" 644
fi

# The cs-update mod's files go last, with only the report below them. The mod's
# update key runs this installer as a child of the Claude Code process that
# loaded the mod, which reloads a mod soon after its files change (0.4 to 0.7 s
# measured on 2.1.319, debounced) and can end that child with a SIGTERM to its
# process tree as the reload unloads the mod. Everything the install does comes
# first, so a reload lands on a finished install.
for mod_file in "${CS_MOD_FILES[@]}"; do
    case "$mod_file" in cs-update/*) ;; *) continue ;; esac
    if _mod_path_real "$mod_file"; then
        _deploy "mods/$mod_file" "$SKILLS_DIR/$mod_file"
    fi
done
if [ "$CS_UNCHANGED" -gt 0 ]; then
    # shellcheck disable=SC2088  # a tilde the user reads, not a path cs opens
    _done "Placed $CS_PLACED files" "$CS_UNCHANGED unchanged · ~/.local/bin, ~/.claude"
else
    # shellcheck disable=SC2088  # a tilde the user reads, not a path cs opens
    _done "Placed $CS_PLACED files" "~/.local/bin, ~/.claude"
fi

if [ "${#CS_KEPT_PATHS[@]}" -gt 0 ]; then
    echo ""
    warn "Left in place, because cs did not write them:"
    for _kept in "${CS_KEPT_PATHS[@]}"; do
        warn_more "$_kept"
    done
fi

# Check if completion setup is needed
SHELL_NAME=$(basename "$SHELL")
case "$SHELL_NAME" in
    bash)
        if ! grep -q 'bash_completion.d/cs.bash' "$HOME/.bashrc" 2>/dev/null; then
            echo ""
            warn "To enable tab completion, add to ~/.bashrc:"
            warn_more "  [[ -f ~/.bash_completion.d/cs.bash ]] && source ~/.bash_completion.d/cs.bash"
        fi
        ;;
    zsh)
        if ! grep -qE 'fpath.*zsh/completions?' "$HOME/.zshrc" 2>/dev/null; then
            echo ""
            warn "To enable tab completion, add to ~/.zshrc (before compinit):"
            warn_more "  fpath=(~/.zsh/completions \$fpath)"
            warn_more "  autoload -Uz compinit && compinit"
        fi
        ;;
esac

echo ""
if [ -z "$CS_PREVIOUS" ]; then
    echo -e "   ${GREEN}✓${NC} ${ORANGE}cs ${CS_VERSION} installed${NC}"
elif [ "$CS_PREVIOUS" = "$CS_VERSION" ]; then
    echo -e "   ${GREEN}✓${NC} ${ORANGE}cs ${CS_VERSION} installed again${NC}"
else
    echo -e "   ${GREEN}✓${NC} ${ORANGE}cs updated to ${CS_VERSION}${NC}"
fi
echo ""

# A first install says how to start; an update or a repeat install does not.
if [ -z "$CS_PREVIOUS" ]; then
    echo -e "   ${RUST}Usage:${NC} cs ${GOLD}<session-name>${NC}"
    echo ""
    echo -e "   ${COMMENT}Examples:${NC}"
    echo -e "     ${COMMENT}cs${NC} ${GOLD}debug-api${NC}    ${COMMENT}# Create or resume session${NC}"
    echo -e "     ${COMMENT}cs${NC} ${GOLD}server-fix${NC}   ${COMMENT}# Work on server issues${NC}"
    echo ""
    echo "   Getting started:"
    echo "     cs my-first-session    # Create your first session"
    echo "     cs -help               # See all commands"
    echo "     cs -version            # Verify installation"
fi
