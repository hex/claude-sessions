#!/usr/bin/env bash
# ABOUTME: Claude Code session manager with git-synced isolated workspaces
# ABOUTME: Creates isolated session workspaces with automatic documentation and file organization

set -euo pipefail

# Configuration
VERSION="2026.10.11"
# A relative CS_SESSIONS_ROOT names a directory under the one cs started in.
# cs moves into a session before it launches claude, and claude's hooks, the
# status line and cs-secrets read the variable from wherever they run, so it is
# made absolute here, once, in the environment cs hands on. $PWD rather than
# cd, because the root may not exist yet. Unset or empty keeps the default.
# A ./x or ../x root keeps its dots, which _cs_session_root_of's string stop
# never matches, so its link walk runs past that root: accepted, not re-fixed.
case "${CS_SESSIONS_ROOT:-/}" in
    /*) ;;
    *) export CS_SESSIONS_ROOT="${PWD%/}/$CS_SESSIONS_ROOT" ;;
esac
SESSIONS_ROOT="${CS_SESSIONS_ROOT:-$HOME/.claude-sessions}"
CLAUDE_CODE_BIN="${CLAUDE_CODE_BIN:-claude}"

# Claude Code downgrades its branding (logo, "thinking" animation) and statusline
# truecolor to a muted palette when it detects tmux, regardless of actual color
# support (anthropics/claude-code#35148). cs owns the environment before it execs
# claude, so it restores the documented override here for every launch path,
# unless the user has already set the variable themselves. (`if`, not `[ ] &&`,
# so the false branch does not trip `set -e` at top level.)
if [ -z "${CLAUDE_CODE_TMUX_TRUECOLOR+x}" ]; then
    export CLAUDE_CODE_TMUX_TRUECOLOR=1
fi

REPO_URL="https://github.com/hex/claude-sessions"
RELEASES_BASE="https://github.com/hex/claude-sessions/releases"
CHANGELOG_RAW_URL="https://raw.githubusercontent.com/hex/claude-sessions/main/CHANGELOG.md"

# Deployed-hooks directory; CS_HOOKS_DIR overrides it for tests.
HOOKS_DEPLOY_DIR="${CS_HOOKS_DIR:-$HOME/.claude/hooks/cs}"

# Encode an absolute filesystem path the way Claude Code does for project
# directory names under ~/.claude/projects/ (each `/` and `.` becomes `-`).
# Used by setup_auto_memory and _doctor_check_token_cost to locate the
# transcript directory for a given workspace.
# Files a past version deployed into the hooks directory and this one does not:
# retired hooks, and any support file that went with them. Removed on install
# and on uninstall, wherever an older cs left them.
# install.sh and run_uninstall both clean these up.
# When retiring a hook in a release, add its filename here.
# The three retired lists only ever grow and none may be emptied: bash 3.2
# under set -u fails on an empty array expansion, and their loops expand them bare.
RETIRED_HOOKS=(
    narrative-precompact.sh   # retired: PreCompact cannot inject context (no hookSpecificOutput/additionalContext); Stop reminder covers capture
    discovery-commits.sh      # renamed to autosave-commits.sh (general all-file crash recovery, not discoveries-specific)
    discoveries-reminder.sh   # retired: session narrative moved to .cs/memory/narrative.md (native lazy-load, no size budget)
    discoveries-archiver.sh   # retired in v2026.4.7 (archive flow replaced by size-budget compaction)
    aboutme-prereader.sh      # retired: source-file ABOUTME-header nudge experiment
    gotcha-prewriter.sh       # retired: brief pre-write gotcha-surfacing experiment; approach was rethought
    aboutme-validator.sh      # retired: never-shipped PostToolUse-on-Write experiment from a feature branch that registered the hook in settings.json without the file ever landing in source
    command-tracker.sh        # retired: CLI command capture; @-included payload did not influence model behaviour at a rate justifying its context cost
    cs-logo.png               # retired: the icon source for the finished-turn notification, which the iTerm2 sidebar owns now (not a hook; a file the hooks directory carried)
    files-scan.sh             # retired: workspace file indexer for .cs/files.md (assumption that the agent can't introspect file sizes has expired)
    files-context.sh          # retired: PreToolUse:Read context injector that surfaced files.md token estimates
    changes-tracker.sh        # retired: PostToolUse change log re-narrating git history into .cs/changes.md; git log/diff/status is authoritative
    artifact-tracker.sh       # retired: PreToolUse:Write redirect was inert (updatedInput path rewrite is not honored by the harness); tracking removed entirely
    prose-lint.sh             # retired with the `cs -lint` verb it called; MUST stay listed, because a deployed copy calling the removed verb reads error()'s exit 1 as "violations found" and blocks every turn-end
    bash-logger.sh            # retired: PreToolUse:Bash command log cost every Bash call a hook process (~1.4 s), and nothing read the BASH: lines it wrote
)

# Hook scripts cs ships; deployed to ~/.claude/hooks/cs/ and registered in
# settings.json.
CS_HOOKS=(
    session-start.sh
    autosave-commits.sh
    narrative-reminder.sh
    session-end.sh
    subagent-context.sh
    tool-failure-logger.sh
    session-auto-approve.sh
    scope-prompt.sh
)

# Files under hooks/ that the hooks source, or that cs points other tools at,
# rather than files Claude Code invokes as hooks. Deployed and removed alongside
# the hooks, never registered against an event. The prompt-rewriter scripts are
# reached through $EDITOR, not through any hook event; memory-index-guard.sh is
# run by /wrap's memory pass. wrap-sweep.md and wrap-summary.md are the memory
# and summary passes /wrap reads: under ~/.claude/hooks/cs/ no slash menu lists
# them, where a file under ~/.claude/commands/ answers as a command of its own.
CS_HOOK_LIBS=(
    cs-resolve.sh
    cs-shared.sh
    cs-iterm-tab.py
    memory-index-guard.sh
    prompt-rewriter.sh
    prompt-rewriter-model.sh
    prompt-rewriter-vendor.sh
    wrap-sweep.md
    wrap-summary.md
)

# Slash commands cs ships; deployed to ~/.claude/commands/.
CS_COMMANDS=(
    checkpoint.md
    wrap.md
)

# Slash commands past versions deployed to ~/.claude/commands/ and this one
# does not. A command file left behind keeps answering its name, so install.sh
# and run_uninstall both remove each one cs wrote; a user's own file of the
# same name is kept. When retiring a command, add its filename here.
# shellcheck disable=SC2034  # read by install.sh and run_uninstall
RETIRED_COMMANDS=(
    compact-discoveries.md  # retired with the discoveries machinery; the session narrative replaced it
    skillify.md             # retired with CLI command capture (command-tracker.sh), whose log it promoted to skills
    learn.md                # wrapped cs -learn, removed with the learnings log; deployed only by an install from a checkout
    store-secret.md         # moved to skills/store-secret; deployed only by an install from a checkout
    sweep.md                # /wrap's memory pass, deployed as hooks/cs/wrap-sweep.md; /wrap is the one command that runs it
    summary.md              # /wrap's summary pass, deployed as hooks/cs/wrap-summary.md; its standalone prose critic went with the command
)

# Skills cs ships; each deploys as ~/.claude/skills/<name>/SKILL.md.
CS_SKILLS=(
    store-secret
    prose-hygiene
    rotate
    finish
    feature
    write-as-me
)

# Skills retired or renamed in past versions but possibly still installed from
# older cs versions. install.sh and run_uninstall both delete these directories.
# When retiring or renaming a skill in a release, add its OLD name here: a skill
# directory left behind keeps answering its slash command forever, and nothing
# else ever removes it.
#
# Do not add a doctor row for a leftover directory; it cannot report one. The
# only cs that could still hold it is one older than the retirement, and that cs
# has no entry here to check against; the upgrade that gives it the entry is the
# same install that deletes the directory. So the row would warn about a state
# it can never observe.
RETIRED_SKILLS=(
    voice   # renamed to write-as-me; Claude Code 2.1.227 ships a built-in /voice (Toggle voice mode)
    merge   # replaced by finish: integrate and report, never remove
    cs-hint # a mod (deployed under skills/ like every mod): the hint line under the prompt, retired
    cs-rotate # a mod: renamed to cs, cs's in-session mod (the rotate band, forced rotation, the wrap key)
)

# install.sh and run_uninstall join each entry of the three retired lists
# onto one directory (a hook or command file name, a skill directory name),
# so an entry holding a path component would reach outside it, and '..' as a
# skill would name all of ~/.claude. Both call this before they change
# anything: it stops with an error naming the list and the first such entry.
_check_retired_names() {
    _check_retired_entries RETIRED_HOOKS file "${RETIRED_HOOKS[@]}"
    _check_retired_entries RETIRED_COMMANDS file "${RETIRED_COMMANDS[@]}"
    _check_retired_entries RETIRED_SKILLS directory "${RETIRED_SKILLS[@]}"
}

# Stop with an error naming list $1 and the first of its entries ($3...) that
# is not a plain $2 name: empty, '.', '..', or holding a '/'.
_check_retired_entries() {  # list name, kind (file or directory), entries...
    local list="$1" kind="$2" entry
    shift 2
    for entry in "$@"; do
        case "$entry" in
            ''|.|..|*/*) error "$list entry '$entry' is not a $kind name" ;;
        esac
    done
}

# Support files skills ship beyond SKILL.md, as skills/<skill>/<path> entries.
CS_SKILL_FILES=(
    write-as-me/scripts/build-corpus.sh
    finish/scripts/finish.sh
)

# Mod directories under mods/ the installer keeps out: experimental, their
# source and tests in the checkout only. cs-feed is one, so the cs band, which
# draws its feed key only beside cs-feed's /feed, draws none. Every file under
# mods/ outside these and their test/ is in CS_MOD_FILES below
# (tests/test_install.sh holds the two lists to that), and cs -doctor's drift
# scan skips them.
# shellcheck disable=SC2034  # read by cs -doctor and tests/test_install.sh
CS_MODS_KEPT_OUT=(
    cs-feed
)

# Mods cs ships: Claude Code function-hooks plugins, deployed file by file as
# ~/.claude/skills/<mod>/<path> (the mod's bun tests stay in the checkout).
CS_MOD_FILES=(
    cs/.claude-plugin/plugin.json
    cs/hooks/hooks.json
    cs/hooks/register.tsx
    cs/tips.json
    cs-update/.claude-plugin/plugin.json
    cs-update/hooks/hooks.json
    cs-update/hooks/register.tsx
    cs-mermaid/.claude-plugin/plugin.json
    cs-mermaid/hooks/hooks.json
    cs-mermaid/hooks/layout.ts
    cs-mermaid/hooks/parse.ts
    cs-mermaid/hooks/register.tsx
    cs-mermaid/hooks/text.ts
    cs-mermaid/skills/show-me/SKILL.md
)

# The cs tips file as install.sh names it in settings.json's
# spinnerTipsOverride.tipsFile: Claude Code reads that one file for its spinner
# tips, and cs's says how to turn on the band's prompt bars. Deployed with the
# cs mod as cs/tips.json under ~/.claude/skills.
# shellcheck disable=SC2034,SC2088  # read by install.sh and run_uninstall; Claude Code expands the ~
CS_TIPS_FILE="~/.claude/skills/cs/tips.json"

# Whether cs named its tips file, as install.sh records it: "named", or
# "declined" once the person took the pointer out, so cs -update leaves it out.
_cs_tips_record_file() {
    echo "${XDG_CONFIG_HOME:-$HOME/.config}/cs/tips-file"
}

# Every file install.sh deploys from the repo, one repo path per line: the
# binaries, then the files deployed under ~/.claude. The web install
# downloads exactly these.
_cs_payload_files() {
    printf '%s\n' bin/cs bin/cs-secrets bin/cs-statusline bin/cs-subagent-statusline
    _cs_claude_payload_files
}

# The files install.sh deploys under ~/.claude, one repo path per line: the
# hook files (libraries first), commands, skills, skill support files and mod
# files. build.sh --add-release-hashes adds their sha256s to CS_KNOWN_SHA256.
_cs_claude_payload_files() {
    local f
    for f in "${CS_HOOK_LIBS[@]}" "${CS_HOOKS[@]}"; do printf 'hooks/%s\n' "$f"; done
    for f in "${CS_COMMANDS[@]}"; do printf 'commands/%s\n' "$f"; done
    for f in "${CS_SKILLS[@]}"; do printf 'skills/%s/SKILL.md\n' "$f"; done
    for f in "${CS_SKILL_FILES[@]}"; do printf 'skills/%s\n' "$f"; done
    for f in "${CS_MOD_FILES[@]}"; do printf 'mods/%s\n' "$f"; done
}

# The shell completions install.sh deploys. A web install that cannot fetch
# one warns and goes on without it.
# shellcheck disable=SC2034  # read by install.sh
CS_COMPLETION_FILES=(
    completions/cs.bash
    completions/_cs
)

# The events install.sh registers a cs hook under: the first column of
# _register_cs_hooks, which a test compares with this list. install.sh reads
# it before it deploys anything, to refuse a settings.json that holds one of
# them as something other than a list.
# shellcheck disable=SC2034  # read by install.sh
CS_HOOK_EVENTS=(
    SessionStart
    PostToolUse
    Stop
    SessionEnd
    SubagentStart
    PostToolUseFailure
    PermissionRequest
    UserPromptSubmit
    FileChanged
    CwdChanged
)

# Remove a hook registration from any event in a settings JSON string,
# matching either path spelling; drops wrappers that empty out. An entry with
# no .hooks array (its command at the top level, or not an object at all)
# passes through untouched, and so does an element of a .hooks array that is
# not an object: neither can be cs's registration. An event whose value is
# not a list is the user's and stays as it is.
# A wrapper whose .hooks array is empty goes whether the strip emptied it or
# the user wrote it that way; the filter cannot tell the two apart and an
# empty one does nothing in Claude Code. Deliberate: not a defect to fix.
# Prints the updated JSON.
_strip_hook_registration() {
    local settings="$1" p="$2" t="$3"
    echo "$settings" | jq --arg p "$p" --arg t "$t" '
        if .hooks then
            .hooks |= with_entries(
                .value |= (
                    if type == "array" then
                        map(if type == "object" and (.hooks | type) == "array" then .hooks |= map(select(type != "object" or (.command != $p and .command != $t))) else . end)
                        | map(select(type != "object" or (.hooks | type) != "array" or (.hooks | length > 0)))
                    else . end
                )
            )
        else . end
    '
}

# The Claude Code keybindings cs offers to add. Ctrl+X R and Ctrl+X W are
# "command:<name>" actions, which submit /<name>. Ctrl+X 1 and Ctrl+X 2 bind
# the engine actions the cs mod's band Buttons answer to: they press the
# band's rotate (or /clear) and wrap keys. KEEP IN SYNC with ROTATE_ACTION and
# WRAP_ACTION in mods/cs/hooks/register.tsx; its FEED_ACTION has no key while
# cs-feed is kept out (CS_MODS_KEPT_OUT above). install.sh
# asks once per machine and binds each in the context block Claude Code wants
# it in (home, below): the command keys in Chat, the chords in Global, where
# the mod reads them. cs -uninstall takes back only the keys that still hold
# these values, and cs -doctor reports them.
CS_ROTATE_WRAP_KEYS='{"ctrl+x r":"command:rotate","ctrl+x w":"command:wrap","ctrl+x 1":"strip:jump1","ctrl+x 2":"strip:jump2"}'

# Option+1 and Option+2 on the same two commands, as cs 2026.10.6 bound them.
# iTerm2 selects panes with Option+number, so there they never reach Claude
# Code. Wherever they still hold these values, an install that binds the
# chords takes them back, and so does cs -uninstall.
# shellcheck disable=SC2034  # read by install.sh's _bind_rotate_wrap_keys, cs -uninstall and cs -doctor
CS_RETIRED_OPTION_KEYS='{"alt+1":"command:rotate","alt+2":"command:wrap"}'

# The jq definitions shared by the filters below. keynorm follows Claude
# Code's key parser (2.1.291) as far as the keys cs compares need: case
# ignored, control is ctrl, opt and option are alt, command, super and win
# are cmd, esc, return and del are escape, enter and delete, modifiers in
# any order, and a chord's keys split on any run of spaces. It keeps meta
# apart from alt and leaves space and arrow glyphs as typed, which no cs key
# uses. cs's own keys are already in that form. ours: whether a to_entries pair from a context block is one of
# the bindings in $cs, key and value both. home: the context block an action
# belongs in, as Claude Code rules it (2.1.310 warns of a "command:" binding
# in any named context but "Chat"): Chat for a command, Global for anything
# else.
_CS_KEYBINDING_DEFS='
    def keynorm:
        ["alt", "cmd", "ctrl", "meta", "shift"] as $mods
        | [splits("\\s+") | select(length > 0) | ascii_downcase | split("+")
            | map({"control": "ctrl", "opt": "alt", "option": "alt", "command": "cmd",
                   "super": "cmd", "win": "cmd", "esc": "escape", "return": "enter",
                   "del": "delete"}[.] // .)
            | ([.[] | select(. as $p | any($mods[]; . == $p))] | unique)
              + [.[] | select(. as $p | any($mods[]; . == $p) | not)]
            | join("+")]
        | join(" ");
    def ours: . as $e | ($e.key | keynorm) as $k | $cs | has($k) and .[$k] == $e.value;
    def home: if type == "string" and startswith("command:") then "Chat" else "Global" end;
'

# Claude Code reads its keybindings from its config dir. Inside an encrypted
# session that dir is the session's .cs/claude-config, which no other session
# reads; it links the shell's keybindings.json instead, so cs's keys belong in
# the shell's config dir, which launch records in
# CLAUDE_SECURESTORAGE_CONFIG_DIR (empty for ~/.claude).
_cs_keybindings_file() {
    local dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
    case "$dir" in
        */.cs/claude-config) dir="${CLAUDE_SECURESTORAGE_CONFIG_DIR:-$HOME/.claude}" ;;
    esac
    printf '%s\n' "$dir/keybindings.json"
}

# This machine's answer to the installer's question, yes or no; absent until
# it has been asked on a terminal. The file keeps the name it had when the
# keys were Option+1 / Option+2, so a machine that said yes then gets the
# chords on its next install.
_cs_rotate_wrap_keys_answer_file() {
    printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/cs/option-keys"
}

# Whether a keybindings file has the shape cs reads and merges into: one JSON
# object whose "bindings" is an array of context blocks, each an object whose
# own "bindings", when present, is an object. Slurped, so a file holding two
# documents is refused rather than read as two; -e turns invalid JSON, an
# empty file and a false answer alike into a non-zero exit. Only a regular
# file (or a link to one) is read: a FIFO waits for a writer that never comes
# and a device may never end, so one of those, a directory or a link to any of
# them fails the check unread, and every caller asks this before it reads.
_cs_keybindings_shape_ok() {  # file
    [ -f "$1" ] || return 1
    jq -se 'length == 1 and (.[0] | type == "object" and (.bindings | type == "array")
        and all(.bindings[]; type == "object" and ((.bindings // {}) | type == "object")))' \
        "$1" > /dev/null 2>&1
}

# Reads a keybindings document that passed the shape check on stdin and prints
# one line per cs key: "bound<TAB>key" when every binding of it holds cs's
# value and sits in a block of the action's home context; "misplaced<TAB>key<TAB>home"
# when every binding holds cs's value but one sits in a block of another
# context (a block with no context counts as another); "free<TAB>key" when
# nothing binds it; and "conflict<TAB>key<TAB>action" when something else
# does, in any context. A chord also conflicts when its first key is bound on
# its own to an action, which Claude Code would stop reaching once it waits
# for the chord's second key: "conflict<TAB>key<TAB>action<TAB>prefix". Keys
# compare as keynorm spells them. An action that is not a non-empty string (a
# null that unbinds the key, an empty "") prints as JSON, so no field is ever
# empty; a null on the prefix is no conflict, as it binds nothing.
_cs_rotate_wrap_keys_status() {
    jq -r --argjson cs "$CS_ROTATE_WRAP_KEYS" "$_CS_KEYBINDING_DEFS"'
        def show: if type == "string" and length > 0 then . else tojson end;
        [.bindings[] | .context as $ctx | (.bindings // {}) | to_entries[] | .key |= keynorm | .ctx = $ctx] as $all
        | $cs | to_entries[] | . as $c
        | [$all[] | select(.key == $c.key)] as $hits
        | [$hits[] | .value] as $vals
        | ($c.key | split(" ") | if length > 1 then .[0] else null end) as $prefix
        | [$all[] | select(.key == $prefix and .value != null) | .value] as $pvals
        | if any($vals[]; . != $c.value) then
            "conflict\t\($c.key)\t\([$vals[] | select(. != $c.value)][0] | show)"
          elif ($pvals | length) > 0 then "conflict\t\($c.key)\t\($pvals[0] | show)\t\($prefix)"
          elif ($vals | length) == 0 then "free\t\($c.key)"
          elif any($hits[]; .ctx != ($c.value | home)) then "misplaced\t\($c.key)\t\($c.value | home)"
          else "bound\t\($c.key)"
          end'
}

# Prints, comma-separated, the keys of a keybindings document on stdin that
# hold one of the bindings in the JSON object $1, spelled as the file spells
# them; empty when none does.
_cs_keybindings_held() {  # bindings-json
    jq -r --argjson cs "$1" "$_CS_KEYBINDING_DEFS"'
        [.bindings[] | (.bindings // {}) | to_entries[] | select(ours) | .key] | unique | join(", ")'
}

# Prints a keybindings document on stdin, compact, without the bindings in the
# JSON object $1 (key and value both; a key bound to anything else stays). A
# block that held one of them and is left empty goes, whatever its context; a
# block that held none is never touched, so a user's own empty block stays.
_cs_keybindings_strip() {  # bindings-json
    jq -c --argjson cs "$1" "$_CS_KEYBINDING_DEFS"'
        .bindings |= map(
            if any((.bindings // {}) | to_entries[]; ours) then
                .bindings |= with_entries(select(ours | not))
                | select(.bindings != {})
            else . end)'
}

# Which files under ~/.claude are cs's is decided by content, never by name:
# a user's own hook, command or skill may share a name with one cs ships or
# once shipped. A file is cs's when its sha256 is the one the install record
# holds for its path, the one of the payload being deployed there, or one in
# CS_KNOWN_SHA256. install.sh overwrites and removes, and cs -uninstall
# removes, only such files; any other is kept and named in a warning.

# The install record: one "<sha256>  <path under $HOME>" line for each file
# install.sh last wrote under ~/.claude, beside the hooks' .version stamp.
_cs_install_record() {
    printf '%s\n' "$HOME/.claude/hooks/cs/.installed"
}

# Prints the sha256 of file $1. Fails when $1 is not a regular file or a
# link to one, without reading it: a FIFO or a device can keep a read
# waiting forever. Fails too when the file cannot be read or there is no
# sha256sum or shasum to compute it.
_cs_sha256_file() {  # file
    local out
    [ -f "$1" ] || return 1
    if command -v sha256sum >/dev/null 2>&1; then
        out=$(sha256sum < "$1") || return 1
    elif command -v shasum >/dev/null 2>&1; then
        out=$(shasum -a 256 < "$1") || return 1
    else
        return 1
    fi
    out="${out%% *}"
    [ "${#out}" = 64 ] || return 1
    printf '%s\n' "$out"
}

# Whether file $1 holds content cs wrote: the sha256 the install record
# holds for its path, $2 (the sha256 of the payload the caller deploys at
# that path, so a file already equal to it is cs's), or one in
# CS_KNOWN_SHA256. A file whose sha256 cannot be computed is not cs's. The
# record holds one path per line, so a path holding a newline is never
# looked up there: it is judged by its content alone.
_cs_owns_file() {  # file, [payload-sha256]
    local digest record
    digest=$(_cs_sha256_file "$1") || return 1
    if [ -n "${2:-}" ] && [ "$digest" = "$2" ]; then
        return 0
    fi
    record=$(_cs_install_record)
    if [ -f "$record" ] && [[ "$1" != *$'\n'* ]] && grep -qxF "$digest  ${1#"$HOME"/}" "$record"; then
        return 0
    fi
    case " ${CS_KNOWN_SHA256[*]} " in
        *" $digest "*) return 0 ;;
    esac
    return 1
}

# Paths a removal or an install left in place because cs did not write them.
CS_KEPT_PATHS=()

# Removes file $1 when cs wrote it ($2 as for _cs_owns_file) and returns 0;
# otherwise keeps it, warns once naming it, adds it to CS_KEPT_PATHS and
# returns 1.
_cs_remove_if_owned() {  # file, [payload-sha256]
    if _cs_owns_file "$1" "${2:-}"; then
        rm -f "$1"
        return 0
    fi
    warn "Kept $1: cs did not write it"
    CS_KEPT_PATHS+=("$1")
    return 1
}

# Removes the files under directory $1 that cs wrote, then every directory
# that leaves empty; keeps the rest as _cs_remove_if_owned does, or as
# function $2 does when given one (it takes a file and removes it or keeps
# it). Returns 0 when the directory is gone. Names come from find
# NUL-separated, so a name holding a newline is judged whole.
_cs_remove_tree_if_owned() {  # dir, [remove-function]
    local f remove="${2:-_cs_remove_if_owned}"
    while IFS= read -r -d '' f; do
        "$remove" "$f" || true
    done < <(find "$1" ! -type d -print0)
    find "$1" -depth -type d -exec rmdir {} \; 2>/dev/null || true
    [ ! -e "$1" ]
}

