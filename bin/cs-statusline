#!/usr/bin/env bash
# ABOUTME: Claude Code statusLine command — renders one line of rounded capsules on the terminal's own background
# ABOUTME: Reads the statusline JSON on stdin and prints session/ctx/model/git/limits/cost

set -uo pipefail

SESSIONS_ROOT="${CS_SESSIONS_ROOT:-$HOME/.claude-sessions}"

# This file re-invokes itself for the out-of-band usage refresh, so it needs its
# own path — resolved at load, since $0 is the sourcing shell under the library
# mode the test suite uses.
_SL_SELF="${BASH_SOURCE[0]}"

# Read-only status query; never take the index lock from a render.
export GIT_OPTIONAL_LOCKS=0

# Current epoch for this render, read at most once. Honors CS_STATUSLINE_NOW
# (test/pin), then the fork-free printf builtin, then a date fork (macOS bash
# 3.2 lacks %(...)T). Memoized so the limits stamp, countdown, and attention
# pulse share one clock instead of forking date up to three times a render.
# The memo gate is a dedicated flag, not the value: even when every clock source
# fails and _NOW ends empty, the flag records that this render already tried, so
# a later caller does not re-fork date. main() zeroes both _NOW and the flag at
# render start, so an inherited value can never seed the memo. Always overwrites
# _NOW in-process and validates it numeric; leaves it empty when every source
# fails, so callers apply their own fallback.
_sl_now() {
    [ -n "${_SL_NOW_READY:-}" ] && return 0
    _SL_NOW_READY=1
    if [ -n "${CS_STATUSLINE_NOW:-}" ]; then
        _NOW="$CS_STATUSLINE_NOW"
    else
        printf -v _NOW '%(%s)T' -1 2>/dev/null
        [[ "${_NOW:-}" =~ ^[0-9]+$ ]] || _NOW=$(date +%s 2>/dev/null)
    fi
    # Normalize to canonical base-10: a leading-zero value (e.g. a pin of 08) is
    # read as octal by bash arithmetic and aborts on an 8/9 digit. 10# forces
    # base-10 so the countdown, stamp, and pulse all get a safe integer.
    if [[ "${_NOW:-}" =~ ^[0-9]+$ ]]; then _NOW=$((10#$_NOW)); else _NOW=""; fi
}

# Resolve SL_THEME for this render. CS_TERM_THEME set on its own (no
# CS_TERM_THEME_AUTO marker) is an explicit user pin (see `cs -help`) and wins.
# When launch auto-detected the theme it exports CS_TERM_THEME plus the
# CS_TERM_THEME_AUTO=1 marker: that value can't follow a mid-session terminal
# theme switch (macOS auto dark mode), and re-querying the terminal here would
# corrupt claude's TUI, so the ladder below asks the terminal instead. Assigns
# SL_THEME directly rather than via `$(...)`, per this file's fork-free-hot-path
# convention.
#
# The ladder asks the terminal, never the operating system. What macOS is
# wearing says nothing about a terminal with a fixed scheme or one embedded in
# an app, and that is exactly where it was reliably wrong; a terminal that can
# answer for itself does so through the rungs below, and one that cannot is
# taken to be dark rather than guessed at from the system.

# The attached client's own reported theme, which tmux records when the terminal
# tells it (Ghostty, kitty, WezTerm and the like; most terminals report nothing,
# and then this answers nothing). Live, unlike anything captured at launch, and
# it describes the terminal rather than the OS. Talks to the tmux server over
# its socket, never the tty, so it is safe from a render.
_sl_theme_from_tmux_client() {
    _sl_tmux_client
    case "${_TMUX_CLIENT_THEME:-}" in
        dark|light) SL_THEME="$_TMUX_CLIENT_THEME"; return 0 ;;
        *) return 1 ;;
    esac
}

# Ask the tmux server, once per render, what the attached client reports as
# its theme and which tty it is on: the two rungs that need them used to fork
# tmux once each. Tab-separated so an empty theme (most terminals report none)
# still leaves the tty in its own field. Sets _TMUX_CLIENT_THEME and
# _TMUX_CLIENT_TTY; both empty when tmux cannot answer.
_TMUX_CLIENT_ASKED=""; _TMUX_CLIENT_THEME=""; _TMUX_CLIENT_TTY=""
_sl_tmux_client() {
    [ -z "$_TMUX_CLIENT_ASKED" ] || return 0
    _TMUX_CLIENT_ASKED=1
    local out
    out=$(tmux display-message -p '#{client_theme}'$'\t''#{client_tty}' 2>/dev/null) || return 0
    case "$out" in
        *$'\t'*) _TMUX_CLIENT_THEME="${out%%$'\t'*}"; _TMUX_CLIENT_TTY="${out#*$'\t'}" ;;
    esac
}

# COLORFGBG, outside tmux only. Inside it is the tmux server's start-time
# snapshot and goes stale across theme changes — 15;0 has been observed there
# under a light terminal — which is why the launch detector consults it in its
# non-tmux branch alone. KEEP the classification IN SYNC with
# _theme_from_colorfgbg in lib/70-statusline.sh.
_sl_theme_from_colorfgbg() {
    case "${COLORFGBG##*;}" in
        7|9|1[0-5]) SL_THEME="light"; return 0 ;;
        [0-8])      SL_THEME="dark";  return 0 ;;
        *)          return 1 ;;
    esac
}

# Whether this process is genuinely inside the tmux server $TMUX names.
#
# TMUX is ordinary environment and is inherited wholesale: a program launched
# from a tmux pane passes it to everything it spawns, including a window it
# opens in a terminal of its own. That child then claims a tmux membership it
# does not have, and every rung that keys off TMUX reads the wrong terminal —
# the client rung asks a client that is not ours, and the COLORFGBG rung is
# skipped to avoid a tmux staleness that does not apply.
#
# The second field of TMUX is the tmux SERVER pid (a daemon, reparented to 1).
# It is the one part of the claim that can be checked rather than believed: a
# process in a real pane has that server among its ancestors, an impostor does
# not. One `ps` covers the whole walk, so this costs a single fork.
#
# $1: pid to start from (defaults to this process; the parameter exists so the
# walk can be tested against a fixed table instead of the live process tree).
# Cached per parent process: the parent (Claude Code, for a render) is the same
# across every render of a conversation, and a process the parent did not spawn
# into this pane cannot inherit its verdict because the parent pid is not
# environment. Keyed on the parent pid and the TMUX claim, expiring after
# TMUX_REAL_CACHE_TTL so a recycled pid cannot inherit a stale verdict for
# long. The walk itself is two forks (ps and awk), so a hit saves both.
TMUX_REAL_CACHE_TTL=300

_sl_tmux_is_real() {
    [ -n "${TMUX:-}" ] || return 1
    local srv start
    srv=${TMUX#*,}; srv=${srv%%,*}
    case "$srv" in ''|*[!0-9]*) return 1 ;; esac
    start=${1:-$$}
    local key="" entry="" line="" when verdict
    if [ -z "${1:-}" ]; then
        key="$PPID,${TMUX//\//-}"
        case "$key" in *[!A-Za-z0-9._,-]*) key="" ;; esac
    fi
    if [ -n "$key" ]; then
        entry="$HOME/.cache/cs/tmux-real/$key"
        if [ -f "$entry" ] && IFS= read -r line < "$entry"; then
            when="${line%% *}"; verdict="${line#* }"
            _sl_now
            if [[ "$when" =~ ^[0-9]+$ ]] && [[ "${_NOW:-}" =~ ^[0-9]+$ ]] \
                && [ $(( _NOW - when )) -le "$TMUX_REAL_CACHE_TTL" ]; then
                case "$verdict" in
                    real) return 0 ;;
                    foreign) return 1 ;;
                esac
            fi
        fi
    fi
    _sl_tmux_walk "$start" "$srv"
    local rc=$?
    if [ -n "$entry" ] && [ "$rc" -ne 2 ]; then
        _sl_now
        [ -d "${entry%/*}" ] || mkdir -p "${entry%/*}" 2>/dev/null
        verdict=foreign; [ "$rc" -eq 0 ] && verdict=real
        { printf '%s %s\n' "${_NOW:-0}" "$verdict" > "$entry"; } 2>/dev/null || true
    fi
    [ "$rc" -eq 2 ] && rc=0
    return "$rc"
}

# The walk itself: 0 when the tmux server pid $2 is an ancestor of $1, 1 when
# it is not, 2 when ps could not answer (treated as real by the caller, and
# never cached, because a tool failure is not evidence of the negative).
_sl_tmux_walk() {  # start-pid server-pid
    local start="$1" srv="$2"
    # The loop is capped: a ppid table can be cyclic if a pid is reused between
    # the read and the walk, and an uncapped walk would spin on the render path.
    # Capture first: under `set -o pipefail` a failing ps would decide the
    # pipeline's status whatever awk concluded. An empty table means ps is
    # missing or restricted, not that the server is absent — return 2 there,
    # because a tool failure is not evidence of the negative, and scoring it as
    # one makes a genuine pane render dark and lose its pane id.
    local table
    table=$(ps -ax -o pid=,ppid= 2>/dev/null) || table=""
    [ -n "$table" ] || return 2
    printf '%s\n' "$table" | awk -v p="$start" -v s="$srv" '
        { pp[$1] = $2 }
        END {
            for (n = 0; n < 24; n++) {
                if (p == s) exit 0
                if (!(p in pp)) exit 1
                p = pp[p]
                if (p <= 1) exit 1
            }
            exit 1
        }'
}

# Whether the environment describes a terminal this process is not in. Settled
# once per render, before anything reads it: an explicit CS_TERM_THEME pin
# short-circuits theme detection, but the pane id still needs to know, and
# "am I in this tmux" is a fact about the environment rather than the palette.
_sl_mark_foreign_env() {
    SL_ENV_FOREIGN=""
    [ -n "${TMUX:-}" ] || return 0
    _sl_tmux_is_real || SL_ENV_FOREIGN=1
}

# The terminal cs measured, found by the one identity a render can establish
# for itself: which tmux client this pane is attached to.
#
# A pane cs did not launch carries none of cs's environment — an agent-teams
# teammate is spawned straight off the tmux server and inherits TMUX but no
# CS_TERM_*, so it falls to the dark default and draws a dark bar on a light
# terminal. It can still ask tmux which client it is on, over the socket and
# never the tty, which is safe from a render. cs writes its launch measurement
# under that key, so every pane on the same client finds it.
#
# Keying on the client tty is what makes this safe where a tmux session
# variable was not (see the attach-probe revert): a session variable is shared
# by every pane whatever terminal they are on, while the tty IS the terminal's
# identity. Re-attach from a different terminal and the key differs, so the
# lookup misses and the ladder falls through. The key is not sufficient on its
# own, though — tty names are recycled — so entries also expire by age.
TERM_CACHE_MAX_AGE=43200   # twelve hours, a plausible terminal session

_sl_theme_from_client_cache() {
    local tty key line theme rgb
    # Inside tmux the terminal is the attached client; outside it, it is this
    # process's own tty — which is the key _write_term_cache already uses, so
    # refusing to look there left the answer on disk unreachable.
    if [ -n "${TMUX:-}" ]; then
        _sl_tmux_client
        tty="${_TMUX_CLIENT_TTY:-}"
    else
        tty=$(tty 2>/dev/null) || return 1
    fi
    [ -n "$tty" ] || return 1
    key=${tty#/dev/}; key=${key//\//-}
    # Refuse anything that is not a plain device name, so a hostile or garbled
    # client tty cannot reach outside the cache directory.
    case "$key" in ''|*[!A-Za-z0-9._-]*|.|..) return 1 ;; esac
    local entry="$HOME/.cache/cs/term/$key"
    [ -f "$entry" ] || return 1
    # tty device names are recycled by the OS: a dark terminal on ttys002
    # closes, a light one opens on the same device, and the entry becomes a
    # confidently wrong answer rather than the miss the key alone would give.
    # Age is the only signal available here, so an entry that has outlived a
    # plausible terminal session is refused rather than trusted. The entry
    # carries the epoch it was written at (third field; the writer is
    # _write_term_cache in lib/70-statusline.sh, KEEP IN SYNC), so the age
    # check is arithmetic rather than a find fork; an entry without one is
    # refused the same way.
    local written
    IFS= read -r line < "$entry" || return 1
    theme=${line%% *}
    case "$theme" in dark|light) ;; *) return 1 ;; esac
    written=${line##* }
    [[ "$written" =~ ^[0-9]+$ ]] || return 1
    _sl_now
    [[ "${_NOW:-}" =~ ^[0-9]+$ ]] || return 1
    [ $(( _NOW - written )) -le "$TERM_CACHE_MAX_AGE" ] || return 1
    rgb=${line#* }; rgb=${rgb% *}
    [ "$rgb" = "-" ] && rgb=""
    SL_THEME="$theme"
    # Only supplies what is missing: a background set by hand is the user's and
    # outranks anything cs measured earlier.
    if [ -n "$rgb" ] && [ -z "${CS_TERM_BG_RGB:-}" ]; then
        case "$rgb" in
            *[!0-9\;]*) ;;
            *) export CS_TERM_BG_RGB="$rgb" ;;
        esac
    fi
    return 0
}

_sl_detect_theme() {
    # One tmux query serves every rung of this pass; a later pass asks again.
    _TMUX_CLIENT_ASKED=""
    # An explicit pin outranks every measurement, so it is read before the probe
    # file is allowed to overwrite anything.
    if [ -n "${CS_TERM_THEME:-}" ] && [ -z "${CS_TERM_THEME_AUTO:-}" ]; then
        SL_THEME="$CS_TERM_THEME"
        return 0
    fi
    # TMUX set but this process is not in that server: the environment was
    # inherited from a terminal that is not the one being drawn on, so every
    # value in it describes somewhere else. CS_TERM_THEME included — it is cs's
    # measurement of the ORIGINAL terminal, and believing it is what paints a
    # light bar on a dark window. Take dark, the answer cs gives everywhere it
    # has nothing trustworthy to go on, and mark the environment so the
    # background RGB and the pane id are not trusted either.
    if [ -n "${SL_ENV_FOREIGN:-}" ]; then
        SL_THEME="dark"
        return 0
    fi
    if [ -n "${TMUX:-}" ] && _sl_theme_from_tmux_client; then
        : # SL_THEME set from the attached client's own reported theme
    elif [ -z "${TMUX:-}" ] && [ -n "${COLORFGBG:-}" ] && _sl_theme_from_colorfgbg; then
        : # SL_THEME set from the terminal's own statement about itself
    elif _sl_theme_from_client_cache; then
        : # the terminal cs measured, found by which tmux client this pane is on
    else
        # Whatever cs measured at launch, and dark when it measured nothing.
        #
        # The OS appearance is not consulted. It describes the system, and the
        # capsules are drawn on the terminal — unrelated for a terminal with a
        # fixed scheme or one embedded in an app, which is where it was reliably
        # wrong. It was only ever a guess that happened to be right when the
        # terminal followed the system, and the rungs above now cover the
        # terminals that can answer for themselves. Dark is the same assumption
        # the rest of cs makes with nothing to go on (lib/05-term.sh, and the
        # rewriter shim), so one unknown yields one palette.
        #
        # The cost, accepted: a light terminal that reports nothing and was not
        # launched by cs renders the dark palette. Pin CS_TERM_THEME=light there.
        SL_THEME="${CS_TERM_THEME:-dark}"
    fi
}

# Blank CS_TERM_BG_RGB when the launch-captured background is stale: once the
# live theme (SL_THEME) has switched away from the theme cs detected at launch
# (CS_TERM_THEME, present with the auto marker), the RGB no longer matches the
# terminal, so drop it and let the gauge surface fall back to
# theme-based values instead of tinting toward the old background (which could
# leave light text on a near-light surface). A manually-set RGB carries no auto
# marker and is never dropped.
_sl_invalidate_stale_bg() {
    if [ -n "${CS_TERM_BG_RGB:-}" ] && [ -n "${CS_TERM_THEME_AUTO:-}" ] &&
       { [ -n "${SL_ENV_FOREIGN:-}" ] || [ "$SL_THEME" != "${CS_TERM_THEME:-}" ]; }; then
        CS_TERM_BG_RGB=""
    fi
}

_sl_mark_foreign_env
_sl_detect_theme
_sl_invalidate_stale_bg

# Parsed stdin fields (filled by _parse_stdin).
SL_SESSION=""; SL_CTX=""; SL_MODEL=""; SL_EFFORT=""
SL_5H=""; SL_5H_RESET=""; SL_WK=""; SL_WK_RESET=""; SL_COST=""; SL_DIR=""

# Collected segments (parallel arrays) and chosen color level.
_SEG_TEXT=(); _SEG_GROUP=(); _SEG_INK=(); _SEG_BOLD=(); _SEG_JOIN=()
_GROUPS=(); _GROUPS_SEEN=""
LEVEL="basic"

# Scratch globals used in place of command substitution (keeps the per-render
# hot path fork-free; this script runs on every assistant message).
_SGR=""; _COLOR=""; _HOT_WEIGHT=""; _RGB=""
_WIDTH=""; _R=""; _G=""; _B=""; _LUM=""
# The gauge surface is a shade of the terminal background — the same for every
# gauge — so it is resolved once per render (process) and cached here.
_SURFACE_RGB=""

# Per-segment icons. Standard Unicode (Geometric Shapes + dingbats) that render
# in any monospace font — not Nerd Font private-use glyphs — so the bar looks
# right without a patched font. The session segment carries no icon.
ICON_CTX=$'\xe2\x97\x94 '       # U+25D4 quarter pie (gauge, the healthy band)
ICON_CTX_EMPTY=$'\xe2\x97\x8b ' # U+25CB empty pie (a fresh context)
ICON_CTX_HALF=$'\xe2\x97\x91 '  # U+25D1 half pie (the amber band)
ICON_CTX_3Q=$'\xe2\x97\x95 '    # U+25D5 three-quarter pie (crit)
ICON_CTX_FULL=$'\xe2\x97\x8f '  # U+25CF full pie (88 and up)
ICON_MODEL=$'\xe2\x9c\xa6 '     # U+2726 four-pointed star
ICON_GIT=$'\xe2\x8e\x87 '       # U+2387 branch
ICON_5H=$'\xe2\x97\xb7 '        # U+25F7 clock
ICON_WK=$'\xe2\x97\xb6 '        # U+25F6 lower-left quadrant (the week; ◑ is the ctx half pie)
ICON_NOTES=$'\xe2\x96\xa4 '     # U+25A4 square with horizontal fill (notes queue)
ICON_MAIL=$'\xe2\x9c\x89 '      # U+2709 envelope (unread cross-session mail)
ICON_LOGO=$'\xe2\x9c\xb3'       # U+2733 eight-spoked asterisk (Claude mark)
ICON_PANE=$'\xe2\x97\xab '      # U+25EB square with vertical bisect (tmux pane)
ICON_FABLE=$'\xe2\x9c\xa7 '     # U+2727 white four-pointed star (model-scoped limit)

# --- stdin -----------------------------------------------------------------

# Run a command with a wall-clock cap when timeout(1) is available, else plain.
_timeout() {
    local secs="$1"; shift
    if command -v timeout >/dev/null 2>&1; then
        timeout "$secs" "$@"
    elif command -v gtimeout >/dev/null 2>&1; then
        gtimeout "$secs" "$@"
    else
        "$@"
    fi
}

# Slurp stdin into _STDIN with a builtin read so no subprocess is spawned and
# a stuck pipe cannot hang the render past one second. Handles single-line
# compact JSON (the common case) and multi-line pretty JSON alike.
_read_stdin() {
    _STDIN=""
    [ -t 0 ] && return 0
    local line=""
    while IFS= read -r -t 1 line; do
        _STDIN+="$line"$'\n'
    done
    _STDIN+="$line"   # trailing partial line (no newline) or empty
}


# Extract every field we need in one jq pass, one value per line. Returns
# non-zero (caller falls back) when jq is missing, stdin is empty, or the JSON
# does not parse. One value per line (not @tsv) because `read` collapses
# consecutive tab delimiters, which would drop empty fields and shift values.
_parse_stdin() {
    local input="$1" fields
    command -v jq >/dev/null 2>&1 || return 1
    [ -n "$input" ] || return 1
    fields=$(printf '%s' "$input" | jq -r '
        [ (.session_id // ""),
          (.session_name // ""),
          (.context_window.used_percentage // "" | tostring),
          (.model.display_name // ""),
          (.model.id // ""),
          (.effort.level // ""),
          (.rate_limits.five_hour.used_percentage // "" | tostring),
          (.rate_limits.five_hour.resets_at // "" | tostring),
          (.rate_limits.seven_day.used_percentage // "" | tostring),
          (.rate_limits.seven_day.resets_at // "" | tostring),
          (.cost.total_cost_usd // "" | tostring),
          (.workspace.current_dir // .cwd // "")
        ] | .[]' 2>/dev/null) || return 1
    {
        IFS= read -r SL_SESSION_ID
        IFS= read -r SL_SESSION
        IFS= read -r SL_CTX
        # Stamp context % for the task-queue gate (the Stop hook reads this file).
        # Machine-local, per the .cs/local partition; truncated to an integer.
        # The file is also the liveness heartbeat (its mtime), so every
        # conversation touches it, but only the launched conversation named in
        # .cs/local/state writes the value: a tmux teammate shares this
        # directory and runs this same statusline with nothing in its
        # environment to tell it apart, and its reading would replace the
        # lead's for every gate that reads the file.
        #
        # The write is a fork (mv, or touch), and the bar repaints once a
        # second, so it runs only when the value changed or the last write is
        # older than STAMP_EVERY: the heartbeat readers allow 900 s, the limits
        # readers 1800 s. The sibling `.at` file holds the last write's epoch,
        # because a render cannot read an mtime without forking stat.
        if [ -n "${CLAUDE_SESSION_NAME:-}" ] && [ -n "${SL_CTX:-}" ]; then
            _pctdir="$SESSIONS_ROOT/$CLAUDE_SESSION_NAME/.cs/local"
            if [ -d "$_pctdir" ] || mkdir -p "$_pctdir" 2>/dev/null; then
                _read_state_key "$_pctdir/state" claude_session_id
                if [ -z "$_STATE_VALUE" ] || [ "$_STATE_VALUE" = "${SL_SESSION_ID:-}" ]; then
                    _stamp_due "$_pctdir/context-pct" "${SL_CTX%%.*}"
                    if [ -n "$_STAMP_DUE" ]; then
                        printf '%s\n' "${SL_CTX%%.*}" > "$_pctdir/context-pct.tmp" 2>/dev/null \
                            && mv "$_pctdir/context-pct.tmp" "$_pctdir/context-pct" 2>/dev/null \
                            && _stamp_written "$_pctdir/context-pct"
                    fi
                else
                    _stamp_due "$_pctdir/context-pct" ""
                    if [ -n "$_STAMP_DUE" ]; then
                        touch "$_pctdir/context-pct" 2>/dev/null && _stamp_written "$_pctdir/context-pct"
                    fi
                fi
            fi
        fi
        IFS= read -r SL_MODEL
        IFS= read -r SL_MODEL_ID
        IFS= read -r SL_EFFORT
        IFS= read -r SL_5H
        IFS= read -r SL_5H_RESET
        IFS= read -r SL_WK
        IFS= read -r SL_WK_RESET
        IFS= read -r SL_COST
        IFS= read -r SL_DIR
    } <<EOF
$fields
EOF
    # Stamp rate-limit state for cs -usage window anchoring. Same partition
    # rules as context-pct: machine-local, atomic, best-effort.
    if [ -n "${CLAUDE_SESSION_NAME:-}" ] && { [ -n "${SL_5H:-}" ] || [ -n "${SL_WK:-}" ]; }; then
        _limdir="$SESSIONS_ROOT/$CLAUDE_SESSION_NAME/.cs/local"
        if [ -d "$_limdir" ] || mkdir -p "$_limdir" 2>/dev/null; then
            _sl_now
            _stamp_due "$_limdir/limits" "${SL_5H%%.*} ${SL_5H_RESET:-} ${SL_WK%%.*} ${SL_WK_RESET:-}"
            if [ -n "$_STAMP_DUE" ]; then
                {
                    printf 'five_hour_used_pct: %s\n' "${SL_5H%%.*}"
                    printf 'five_hour_resets_at: %s\n' "${SL_5H_RESET:-}"
                    printf 'seven_day_used_pct: %s\n' "${SL_WK%%.*}"
                    printf 'seven_day_resets_at: %s\n' "${SL_WK_RESET:-}"
                    printf 'stamped_at: %s\n' "${_NOW}"
                } > "$_limdir/limits.tmp" 2>/dev/null \
                    && mv "$_limdir/limits.tmp" "$_limdir/limits" 2>/dev/null \
                    && _stamp_written "$_limdir/limits"
            fi
        fi
    fi
    return 0
}

# Seconds between rewrites of a stamp file whose value has not changed. The
# stamp files are read for their mtime (the liveness heartbeat, 900 s window)
# and their stamped_at (the limits readers, 1800 s window); a minute keeps
# both fresh without a fork per second.
STAMP_EVERY=60

# Whether stamp file $1 needs rewriting for value $2: yes when its sibling
# `$1.at` does not record a write, records a different value, or records one
# older than STAMP_EVERY. Sets _STAMP_DUE (1 or empty). Builtins only.
_stamp_due() {  # file value
    _STAMP_DUE=1; _STAMP_VALUE="$2"
    local at="$1.at" line="" when
    [ -f "$at" ] || return 0
    IFS= read -r line < "$at" || return 0
    when="${line%% *}"
    [[ "$when" =~ ^[0-9]+$ ]] || return 0
    [ "${line#* }" = "$2" ] || return 0
    _sl_now
    [[ "${_NOW:-}" =~ ^[0-9]+$ ]] || return 0
    [ $(( _NOW - when )) -ge "$STAMP_EVERY" ] || _STAMP_DUE=""
}

# Record that stamp file $1 was just written with value $2 (the value _stamp_due
# was asked about). A builtin write; a torn read of it only costs one early
# rewrite.
_stamp_written() {  # file
    _sl_now
    { printf '%s %s\n' "${_NOW:-0}" "$_STAMP_VALUE" > "$1.at"; } 2>/dev/null || true
}

# Print the dir basename as a last-resort plain status, then exit cleanly.
_fallback() {
    printf '%s\n' "$(basename "${PWD:-/}")"
    exit 0
}

# --- color ladder ----------------------------------------------------------

# Choose the richest color level the terminal advertises.
_detect_level() {
    if [ "${FORCE_COLOR:-}" = "0" ] || [ -n "${NO_COLOR:-}" ] || [ "${TERM:-}" = "dumb" ]; then
        LEVEL="plain"
    # Inside tmux the host mutes a truecolor status line to a fallback palette
    # unless CLAUDE_CODE_TMUX_TRUECOLOR is set; cs exports it at launch, so a
    # pane cs launched keeps full colour. A pane cs did NOT launch — an
    # agent-teams teammate is spawned straight off the tmux server and inherits
    # nothing — does not have it, and its 24-bit output is snapped to the 256
    # cube. That snap is not neutral: a warm off-white's nearest neighbour is
    # index 224, a pink, so a smooth ramp came out as flat blocks with a pink
    # one in the middle. When the output is going to be quantised anyway, emit
    # palette entries in the first place and the quantisation becomes a no-op.
    elif [ -n "${TMUX:-}" ] && [ -z "${SL_ENV_FOREIGN:-}" ] \
        && [ -z "${CLAUDE_CODE_TMUX_TRUECOLOR:-}" ]; then
        # SL_ENV_FOREIGN is settled before this runs: a process that merely
        # inherited TMUX is drawing on its own terminal, nothing is muting it,
        # and downgrading would cost it colour for no reason. And the mute is
        # the host's decision, not TERM's — gating on a "256color" substring
        # skipped every tmux whose default-terminal is screen or similar,
        # which is the population the workaround exists for.
        LEVEL="256"
    elif [ "${COLORTERM:-}" = "truecolor" ] || [ "${COLORTERM:-}" = "24bit" ] \
        || [ "${TERM_PROGRAM:-}" = "iTerm.app" ] || [ "${TERM_PROGRAM:-}" = "WezTerm" ]; then
        LEVEL="truecolor"
    elif [[ "${TERM:-}" == *256color* ]]; then
        LEVEL="256"
    else
        LEVEL="basic"
    fi
}

# Set _SGR to the SGR parameters painting a color name for the active level.
# $1 = 38 (foreground) or 48 (background); $2 = color name. No subprocess.
_sgr() {
    local kind="$1" name="$2"
    case "$LEVEL" in
        truecolor)
            local rgb
            case "$name" in
                # Session-color palette: Claude Code's own /color values (the
                # shared dark/light theme `*_FOR_SUBAGENTS_ONLY` tokens): the tab
                # color and Claude Code's own session accent share this palette.
                # KEEP IN SYNC with _session_color_rgb in bin/cs (tab color).
                red)    rgb="220;38;38" ;;
                blue)   rgb="106;155;204" ;;
                green)  rgb="22;163;74" ;;
                yellow) rgb="202;138;4" ;;
                purple) rgb="130;125;189" ;;
                orange) rgb="217;119;87" ;;
                pink)   rgb="196;102;134" ;;
                cyan)   rgb="8;145;178" ;;
                # The agent rows' model name: a violet distinct from the
                # session palette and from amber.
                periwinkle)
                    [ "$SL_THEME" = "dark" ] && rgb="196;181;253" || rgb="76;29;149" ;;
                rowname)
                    # A subagent row's agent name sits on the bare terminal, not
                    # a capsule, so it takes ink that contrasts the canvas: near-white
                    # on a dark terminal, dark on a light one.
                    [ "$SL_THEME" = "dark" ] && rgb="240;242;255" || rgb="48;42;36" ;;
                rowmeta)
                    # The row's description, ctx and elapsed: quieter than the
                    # name, still readable against the terminal on either theme.
                    [ "$SL_THEME" = "dark" ] && rgb="170;161;148" || rgb="128;116;106" ;;
                # Inks. `amber` is a foreground: the hot number's colour on
                # the neutral capsule, dark enough to hold contrast on cream and
                # bright enough on a dark surface. Nothing paints amber as a fill.
                # It pivots on the measured terminal background when there is
                # one (the bar's surface is a shade of it, the agent rows sit on
                # it directly) and on the theme flag only without a measurement:
                # a light background under a theme that resolved dark would
                # otherwise get the pale amber on cream. The pivot is `ink`'s
                # (1530000), not `_bg_shade`'s: a mid-grey terminal gets white
                # ink, so its amber must be the pale one too.
                amber)
                    if _parse_rgb_triplet "${CS_TERM_BG_RGB:-}"; then
                        _luminance
                        [ "$_LUM" -ge 1530000 ] && rgb="180;83;9" || rgb="253;230;138"
                    elif [ "$SL_THEME" = "dark" ]; then rgb="253;230;138"
                    else rgb="180;83;9"; fi ;;
                # Primary text on the capsule surface: a warm 35% shade of the
                # surface on a light one, the soft white on a dark one — the same
                # contrast pivot the old surface text used, resolved from the
                # surface's own luminance rather than the theme flag.
                ink)
                    _sgr 48 surface
                    if _parse_rgb_triplet "$_RGB" && { _luminance; [ "$_LUM" -ge 1530000 ]; }; then
                        rgb="$((_R * 35 / 100));$((_G * 35 / 100));$((_B * 35 / 100))"
                    elif [ "$SL_THEME" = "dark" ]; then rgb="230;230;230"
                    else rgb="255;255;255"; fi ;;
                # Secondary text: separators, effort, gauge labels, resting
                # numbers. A shade of the surface like `ink`, so it tracks both
                # the measured background and the taupe fallback; the 256 and
                # basic arms instead pick fixed values that contrast their
                # fixed fills.
                ink2)
                    _sgr 48 surface
                    _parse_rgb_triplet "$_RGB"
                    _luminance
                    if [ "$_LUM" -ge 1530000 ]; then
                        rgb="$((_R * 55 / 100));$((_G * 55 / 100));$((_B * 55 / 100))"
                    else
                        rgb="$((_R + (255 - _R) * 55 / 100));$((_G + (255 - _G) * 55 / 100));$((_B + (255 - _B) * 55 / 100))"
                    fi ;;
                # The inverted capsule at crit. Its own token, never the session
                # palette's red: that palette is the tab colour and may change.
                crit)
                    [ "$SL_THEME" = "dark" ] && rgb="255;69;58" || rgb="215;0;21" ;;
                # White on the red fill whatever the theme: the fill is the
                # same hue on both, so its ink is too.
                critink) rgb="255;255;255" ;;
                # The crit pulse's dim phase: white warmed toward the fill.
                critshade) rgb="255;205;200" ;;
                # The effort word wears Claude Code's own /effort picker
                # colours (pixel-sampled from the light picker); on dark they
                # are lifted a third of the way to white so they keep reading
                # on the dark surface. max is a gradient across its letters.
                effort-low)    [ "$SL_THEME" = "dark" ] && rgb="187;159;109" || rgb="150;108;30" ;;
                effort-medium) [ "$SL_THEME" = "dark" ] && rgb="118;169;126" || rgb="44;122;57" ;;
                effort-high)   [ "$SL_THEME" = "dark" ] && rgb="146;158;250" || rgb="87;105;247" ;;
                effort-xhigh)  [ "$SL_THEME" = "dark" ] && rgb="177;89;255" || rgb="135;0;255" ;;
                effort-max-1)  [ "$SL_THEME" = "dark" ] && rgb="174;200;232" || rgb="130;170;220" ;;
                effort-max-2)  [ "$SL_THEME" = "dark" ] && rgb="190;174;219" || rgb="155;130;200" ;;
                effort-max-3)  [ "$SL_THEME" = "dark" ] && rgb="219;174;206" || rgb="200;130;179" ;;
                brand)  rgb="217;119;87" ;;   # Claude coral (#D97757)
                brandshade)
                    # The mark's dim pulse phase: a coral a shade darker than
                    # brand, distinct enough to read as a change without
                    # looking like a foreign color.
                    rgb="184;101;74" ;;
                white)
                    # Softer text on dark terminals to avoid glare.
                    [ "$SL_THEME" = "dark" ] && rgb="230;230;230" || rgb="255;255;255" ;;
                surface)
                    # The capsule surface, tinted from the terminal background
                    # so they harmonize with it instead of sitting on top: a
                    # shade of CS_TERM_BG_RGB (darker on a light terminal,
                    # lighter on a dark one), resolved once per render and cached
                    # since every gauge shares it. Falls back to the warm neutral
                    # when the real background is unknown (no OSC 11 at launch).
                    if [ -z "$_SURFACE_RGB" ]; then
                        if _bg_shade "${CS_TERM_BG_RGB:-}"; then _SURFACE_RGB="$_R;$_G;$_B"
                        elif [ "$SL_THEME" = "dark" ]; then _SURFACE_RGB="140;132;122"
                        else _SURFACE_RGB="128;120;110"; fi
                    fi
                    rgb="$_SURFACE_RGB" ;;
                *)
                    # Warm neutral (R>G>B) so the quiet blocks read as taupe,
                    # not steel; light enough that the gauges recede beside the
                    # identity capsule's ink while white label text holds.
                    [ "$SL_THEME" = "dark" ] && rgb="140;132;122" || rgb="128;120;110" ;;
            esac
            _SGR="${kind};2;${rgb}"; _RGB="$rgb" ;;
        256)
            local idx
            case "$name" in
                red)    idx=160 ;;
                blue)   idx=25 ;;
                green)  idx=28 ;;
                yellow) idx=136 ;;
                purple) idx=55 ;;
                orange) idx=166 ;;
                pink)   idx=162 ;;
                cyan)   idx=30 ;;
                periwinkle) [ "$SL_THEME" = "dark" ] && idx=147 || idx=55 ;;
                rowname) [ "$SL_THEME" = "dark" ] && idx=231 || idx=235 ;;
                rowmeta) [ "$SL_THEME" = "dark" ] && idx=248 || idx=244 ;;
                amber)   [ "$SL_THEME" = "dark" ] && idx=221 || idx=130 ;;
                ink)     [ "$SL_THEME" = "dark" ] && idx=255 || idx=236 ;;
                ink2)    [ "$SL_THEME" = "dark" ] && idx=250 || idx=241 ;;
                crit)    [ "$SL_THEME" = "dark" ] && idx=203 || idx=160 ;;
                critink) idx=231 ;;
                critshade) idx=224 ;;
                effort-low)    [ "$SL_THEME" = "dark" ] && idx=179 || idx=136 ;;
                effort-medium) [ "$SL_THEME" = "dark" ] && idx=71  || idx=28 ;;
                effort-high)   [ "$SL_THEME" = "dark" ] && idx=105 || idx=63 ;;
                effort-xhigh)  [ "$SL_THEME" = "dark" ] && idx=135 || idx=93 ;;
                effort-max-1)  [ "$SL_THEME" = "dark" ] && idx=153 || idx=110 ;;
                effort-max-2)  [ "$SL_THEME" = "dark" ] && idx=183 || idx=140 ;;
                effort-max-3)  [ "$SL_THEME" = "dark" ] && idx=218 || idx=175 ;;
                brand)  idx=173 ;;
                brandshade) idx=167 ;;
                white)
                    [ "$SL_THEME" = "dark" ] && idx=254 || idx=255 ;;
                # The capsule fill: reads like the truecolor surface on a
                # cream terminal without CS_TERM_BG_RGB to shade (a tmux pane
                # cs did not launch has no truecolor flag and no measured
                # background, so this is what an agent-team teammate's row
                # renders in).
                surface)
                    [ "$SL_THEME" = "dark" ] && idx=237 || idx=254 ;;
                # Unknown names fall back to the surface value rather than a
                # stray grey. Safe only because every ink this file paints is
                # one of the named cases above: an unlisted foreground token
                # would land on the same code as its own fill and paint
                # invisible. _seg_session's colour-name allow-list is what
                # keeps a bogus claude_session_color from ever reaching here
                # as a foreground name.
                *)
                    [ "$SL_THEME" = "dark" ] && idx=237 || idx=254 ;;
            esac
            _SGR="${kind};5;${idx}" ;;
        *)
            local base
            case "$name" in
                red)    base=31 ;;
                blue)   base=34 ;;
                green)  base=32 ;;
                yellow) base=33 ;;
                purple) base=35 ;;
                orange) base=33 ;;
                pink)   base=95 ;;
                cyan)   base=36 ;;
                periwinkle) [ "$SL_THEME" = "dark" ] && base=95 || base=35 ;;
                rowname) [ "$SL_THEME" = "dark" ] && base=97 || base=30 ;;
                rowmeta) base=90 ;;
                amber)  [ "$SL_THEME" = "dark" ] && base=93 || base=33 ;;
                ink)     base=97 ;;
                ink2)    [ "$SL_THEME" = "dark" ] && base=97 || base=37 ;;
                crit)    base=31 ;;
                critink) base=97 ;;
                critshade) base=97 ;;
                effort-low)    base=33 ;;
                effort-medium) base=32 ;;
                effort-high)   base=34 ;;
                effort-xhigh)  base=35 ;;
                effort-max-1)  base=36 ;;
                effort-max-2)  base=35 ;;
                effort-max-3)  base=95 ;;
                white)  base=97 ;;
                brand)  base=33 ;;
                brandshade) base=33 ;;
                *)      base=90 ;;
            esac
            if [ "$kind" = "48" ]; then _SGR=$((base + 10)); else _SGR="$base"; fi ;;
    esac
}

# --- segment helpers -------------------------------------------------------

# Append one item to a capsule. $1 text; $2 capsule group ("identity", "ctx",
# "lim-5h", "cost" …) — items sharing a group render inside one capsule, in
# first-seen order; $3 ink token (default the secondary ink); $4 "bold" or
# empty; $5 how this item joins the one before it inside the capsule: "dot"
# (default) a secondary-ink "  ·  ", "pad" two fill spaces, "space" one,
# "none" nothing. The first item of a capsule never gets a joiner.
_add() {
    _SEG_TEXT+=("$1")
    _SEG_GROUP+=("$2")
    _SEG_INK+=("${3:-ink2}")
    _SEG_BOLD+=("${4:-}")
    _SEG_JOIN+=("${5:-dot}")
    # First-seen group order, the order capsules render in.
    case " ${_GROUPS_SEEN:-} " in *" $2 "*) ;; *) _GROUPS+=("$2"); _GROUPS_SEEN="${_GROUPS_SEEN:-} $2" ;; esac
}

# Mark a capsule crit: the renderer fills it with `crit` and paints every item
# in it critink bold. A space-delimited list so bash 3.2 needs no map.
_CRIT_GROUPS=""
_invert() {
    _CRIT_GROUPS="$_CRIT_GROUPS $1 "
}

# Resolve a threshold override into _NUM: the value when it is a plain integer
# of at most three digits, the default otherwise. Thresholds arrive from the
# environment and land in `[ ... -ge ... ]`, where a word and a number too wide
# for a signed integer both error to stderr and leave the band unrendered. Three
# digits rather than 0-100 so a value above 100 still reads as "turn this band
# off", the idiom the Stop hook's tiers already use.
_num_or() {  # value, default -> _NUM (the hook's namesake prints instead)
    case "$1" in
        ''|*[!0-9]*|????*) _NUM="$2" ;;
        *)                 _NUM="$1" ;;
    esac
}

# Set _COLOR by mapping a value against warn/crit thresholds: `crit` at or past
# crit, `amber` at or past warn, else the healthy name ($4, default the
# secondary ink). Callers paint the NUMBER with it; `crit` also tells the
# renderer to invert the whole capsule.
_thresh_color() {
    local v="$1" warn="$2" crit="$3" healthy="${4:-ink2}"
    _HOT_WEIGHT=""
    if [ "$v" -ge "$crit" ]; then
        _COLOR=crit
    elif [ "$v" -ge "$warn" ]; then
        _COLOR=amber; _HOT_WEIGHT=bold
    else
        _COLOR="$healthy"
    fi
}

# Convert an ISO 8601 timestamp into epoch seconds in _EPOCH; empty when the
# value is missing or unparseable. The usage endpoint sends fractional seconds
# and an explicit "+00:00" offset ("2026-08-29T03:59:59.686034+00:00"), so both
# are trimmed and the remainder read as UTC.
#
# Any other offset is refused rather than assumed: reading "+02:00" as UTC would
# put the reset two hours late, and a countdown that is confidently wrong is
# worse than no countdown. The glob then pins the field widths so a value that
# is not a timestamp at all never reaches `date`. It does NOT catch day
# overflow — BSD `date -j -f` normalises "2026-02-31" into March — which is
# tolerable only because the field this parses is machine-generated.
#
# BSD date (macOS, the 3.2 floor) takes -j -f; GNU date takes -d, and each
# rejects the other's flags, so trying both in order needs no platform probe.
_iso_epoch() {
    _EPOCH=""
    local iso="${1:-}" base
    [ -n "$iso" ] || return 0
    case "$iso" in
        *+00:00|*+0000|*Z) ;;                 # explicit UTC
        *+*|*T*-*) return 0 ;;                # any other offset: refuse
    esac
    base="${iso%%.*}"     # drop fractional seconds
    base="${base%%+*}"    # drop the "+00:00" offset
    base="${base%Z}"      # drop a trailing Z
    case "$base" in
        [0-9][0-9][0-9][0-9]-[0-1][0-9]-[0-3][0-9]T[0-2][0-9]:[0-5][0-9]:[0-6][0-9]) ;;
        *) return 0 ;;
    esac
    _EPOCH=$(TZ=UTC date -j -f "%Y-%m-%dT%H:%M:%S" "$base" +%s 2>/dev/null)
    [ -n "$_EPOCH" ] || _EPOCH=$(date -u -d "$base" +%s 2>/dev/null)
    [[ "${_EPOCH:-}" =~ ^[0-9]+$ ]] || _EPOCH=""
}

# Format seconds-until-reset into a compact "2h14m" / "45m" countdown in _REST.
# $1 is the resets_at value (Unix epoch seconds, per the statusline schema).
# Empty when it is missing, non-numeric, or already in the past. `now` comes
# from the printf builtin (bash 4.2+) so the hot path stays fork-free; on an
# older bash (e.g. macOS stock 3.2) the builtin is unavailable, so it falls
# back to a `date +%s` fork so the countdown still renders.
_fmt_rest() {
    _REST=""
    local at="$1" now rem h m
    [[ "$at" =~ ^[0-9]+$ ]] || return 0
    # Shared per-render clock (see _sl_now); empty only if every source failed.
    _sl_now
    now="${_NOW:-}"
    [[ "$now" =~ ^[0-9]+$ ]] || return 0
    rem=$(( at - now ))
    [ "$rem" -gt 0 ] || return 0
    local d
    d=$(( rem / 86400 ))
    h=$(( (rem % 86400) / 3600 ))   # hours within the day; == rem/3600 when d==0
    m=$(( (rem % 3600) / 60 ))
    if [ "$d" -gt 0 ]; then
        # Past a day, read in days+hours (dropping minutes, which are noise at
        # that scale) so a weekly window shows "5d16h", not "136h14m".
        _REST="${d}d${h}h"
    elif [ "$h" -gt 0 ]; then
        _REST="${h}h${m}m"
    elif [ "$m" -gt 0 ]; then
        _REST="${m}m"
    else
        _REST="<1m"
    fi
}

# --- fable usage cache ------------------------------------------------------
#
# Fable's weekly window is model-scoped, and Claude Code puts only the two
# plan-wide windows on the statusline's stdin, so this one figure has to be
# fetched. It is fetched out of band and read from a cache: the render itself
# never touches the network.
#
# The cache is machine-global, not per-session, because the endpoint admits only
# ~28-30 requests per account per rolling hour — capacity returns as old
# requests age out, so a burst saturates the account for a full hour — and that
# budget is shared with Claude Code itself and anything else on the machine. One
# cache plus the interval floor below holds cs to ~6 requests an hour per
# account, however many sessions are open.
USAGE_URL="https://api.anthropic.com/api/oauth/usage"
USAGE_BETA="oauth-2025-04-20"
# 600, not 300: the endpoint's ceiling is ~28-30 requests per account per hour,
# and claude-swap — which many cs users run alongside — polls the same account
# on its own 180s floor. At 300 the two together (12/h + 20/h) already exceed
# the ceiling before Claude Code's own polls. 600 costs nothing visible, since
# USAGE_MAX_AGE is 1800.
USAGE_MIN_INTERVAL=600     # floor between successful polls
USAGE_FAIL_BACKOFF=600     # a 429 does not reliably clear at its stated horizon

_usage_cache_dir() { printf '%s\n' "${CS_USAGE_DIR:-$SESSIONS_ROOT/.usage}"; }

# The cache file for one account. Per-account, not one file for the machine:
# with a single file an org mismatch had to override the interval (a cache
# holding someone else's reading must be replaced now, not when its window
# elapses), so two sessions signed into different accounts each bypassed the
# other's stamped backoff and fetched on every render — measured at 12 requests
# inside one 600s window against a ~28-30/hour budget. Giving each account its
# own file lets the interval and the account check stop competing: every record
# belongs to the account reading it, so the cadence is simply honoured.
#
# The org is a server-supplied UUID and lands in a path, so it is reduced to the
# characters a UUID actually uses; anything else (including the traversal that a
# hostile value would need) cannot survive. An empty org has no file at all.
# The organizationUuid of the account signed in now, from $1 (Claude Code's
# global config), in _ORG; empty when the file is missing or will not parse.
# `--stream` walks the document instead of building it: this file accumulates
# per-project prompt history and grows without bound, and the render path reads
# it once a second. Measured on a 5.5 MB config, streaming a single key beats
# parsing the whole document by roughly an order of magnitude.
# The account changes at a sign-in, not once a second, so the answer is kept
# for ORG_CACHE_TTL under the config's path: a swap shows within five minutes
# instead of costing a jq walk of a multi-megabyte file per render.
ORG_CACHE_TTL=300

_read_org_from() {
    _ORG=""
    local cfg="${1:-}"
    [ -f "$cfg" ] || return 0
    local key="${cfg//\//-}" entry="" line="" when
    key="${key//[^A-Za-z0-9._-]/_}"
    case "${#key}" in [1-9][0-9][0-9]|[1-9][0-9][0-9][0-9]*) key="${key: -200}" ;; esac
    if [ -n "$key" ]; then
        entry="$HOME/.cache/cs/org/$key"
        _sl_now
        if [[ "${_NOW:-}" =~ ^[0-9]+$ ]] && [ -f "$entry" ] && IFS= read -r line < "$entry"; then
            when="${line%% *}"
            if [[ "$when" =~ ^[0-9]+$ ]] && [ $(( _NOW - when )) -le "$ORG_CACHE_TTL" ]; then
                [ "$line" != "$when" ] && _ORG="${line#* }"
                return 0
            fi
        fi
    fi
    # `first(...)` inside jq rather than a `head` pipe: piping would add a fork
    # and, worse, a PATH dependency on a render path that must keep working
    # when PATH holds little more than jq.
    _ORG=$(jq -r --stream 'first(
        select(length == 2 and .[0] == ["oauthAccount","organizationUuid"]) | .[1]
    ) // empty' "$cfg" 2>/dev/null) || _ORG=""
    [ "${_ORG:-}" = "null" ] && _ORG=""
    if [ -n "$entry" ] && [[ "${_NOW:-}" =~ ^[0-9]+$ ]]; then
        [ -d "${entry%/*}" ] || mkdir -p "${entry%/*}" 2>/dev/null
        { printf '%s %s\n' "$_NOW" "$_ORG" > "$entry"; } 2>/dev/null || true
    fi
    return 0
}

_usage_cache_file() {
    _CACHE_FILE=""
    local org="${1:-}"
    org="${org//[^A-Za-z0-9._-]/}"
    org="${org//../}"
    [ -n "$org" ] || return 1
    _CACHE_FILE="$(_usage_cache_dir)/fable.$org.json"
}

# Claude Code's global config, whose oauthAccount names the account now signed
# in. Mirrors Claude Code's own resolution: CLAUDE_CONFIG_DIR, else the homedir
# (note the asymmetry — .claude.json sits beside ~/.claude, not inside it).
_claude_config_file() { printf '%s\n' "${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json"; }

# Seconds since $1 was last modified, in _AGE; empty when it cannot be read.
# BSD stat takes -f %m and GNU stat -c %Y, and each rejects the other's flag, so
# trying both in order needs no platform probe.
_file_age() {
    _AGE=""
    local m
    m=$(stat -f %m "$1" 2>/dev/null) || m=$(stat -c %Y "$1" 2>/dev/null) || return 0
    [[ "$m" =~ ^[0-9]+$ ]] || return 0
    _sl_now
    [[ "${_NOW:-}" =~ ^[0-9]+$ ]] || return 0
    _AGE=$(( _NOW - m ))
}

# Run "$@" with a hard wall-clock bound, echoing its stdout. Prefers coreutils
# timeout, then perl's alarm (present on every macOS, where coreutils is not),
# then bare execution. Unlike _timeout this never silently drops the bound on a
# stock macOS, which matters when the caller holds a lock across the call.
_bounded_capture() {
    local secs="$1"; shift
    if command -v timeout >/dev/null 2>&1; then
        timeout "$secs" "$@"
    elif command -v gtimeout >/dev/null 2>&1; then
        gtimeout "$secs" "$@"
    elif [ -x /usr/bin/perl ]; then
        /usr/bin/perl -e 'alarm shift; exec @ARGV or exit 127' "$secs" "$@"
    else
        "$@"
    fi
}

# Rewrite the cache atomically. $1 org, $2 pct (or "-" to carry the previous
# reading forward untouched), $3 resets_at, $4 seconds until the next poll.
# Carrying forward matters on a failed fetch: a transient 429 should cost the
# bar its freshness, not its number — but it must not restamp fetched_at, or a
# permanently failing account would look fresh forever.
_usage_write() {
    local org="$1" pct="$2" reset="$3" offset="$4"
    local dir cache tmp
    dir=$(_usage_cache_dir)
    # A reading nobody can attribute must not be stored: _read_org_from yields
    # empty for a torn or missing config, and an unattributed reading would be
    # rendered by whichever account looked next. But the request still spent
    # budget, so the schedule is recorded under a reserved name — no reading,
    # no attribution, just a next_poll_at the cadence check can honour.
    # Without it an unreadable config meant no file, so no interval was read
    # and none written, and every render fetched again.
    if ! _usage_cache_file "$org"; then
        _CACHE_FILE="$dir/fable.unattributed.json"
        pct=null; reset=""
    fi
    cache="$_CACHE_FILE"; tmp="$cache.tmp.$$"
    _sl_now
    [[ "${_NOW:-}" =~ ^[0-9]+$ ]] || return 0
    local fetched="$_NOW"
    if [ "$pct" = "-" ]; then
        pct=null; reset=""; fetched=0
        if [ -f "$cache" ]; then
            local prev prev_org=""
            prev=$(jq -r '[(.org // ""), (.pct // "null" | tostring), (.resets_at // ""), (.fetched_at // 0 | tostring)] | .[]' \
                "$cache" 2>/dev/null) || prev=""
            if [ -n "$prev" ]; then
                { IFS= read -r prev_org; IFS= read -r pct; IFS= read -r reset; IFS= read -r fetched; } <<EOF
$prev
EOF
                # Carrying a reading forward is only ever valid within one
                # account. Across a swap the old number would be re-labelled
                # with the new org and keep the old fetched_at, so it would read
                # as fresh — blanking nothing and suppressing the retry.
                if [ "$prev_org" != "$org" ]; then pct=null; reset=""; fetched=0; fi
            fi
        fi
    fi
    [ -n "$pct" ] || pct=null
    [[ "${fetched:-}" =~ ^[0-9]+$ ]] || fetched=0
    if jq -n --arg org "$org" --argjson pct "$pct" --arg reset "$reset" \
        --argjson fetched "$fetched" --argjson next "$(( _NOW + offset ))" \
        '{org:$org, pct:$pct, resets_at:$reset, fetched_at:$fetched, next_poll_at:$next}' \
        > "$tmp" 2>/dev/null && mv "$tmp" "$cache" 2>/dev/null; then
        local shown="$pct"; [ "$shown" = "null" ] && shown=""
        _iso_epoch "$reset"
        _usage_fields_write "$cache" "$shown" "$reset" "$fetched" "$(( _NOW + offset ))" "${_EPOCH:-}"
    fi
    rm -f "$tmp" 2>/dev/null
}

# Fetch the Fable weekly window and rewrite the cache. Detached from the render
# and serialised machine-wide by a mkdir lock, so concurrent sessions cannot
# stampede the endpoint. Every exit path stamps next_poll_at, including the
# failures: without that, a broken account would make every render fire another
# request at a budget that is already the scarce resource here.
_refresh_usage() {
    command -v jq >/dev/null 2>&1 || return 0
    command -v curl >/dev/null 2>&1 || return 0
    local dir lock
    dir=$(_usage_cache_dir); lock="$dir/.lock"
    mkdir -p "$dir" 2>/dev/null || return 0
    # Reclaim a lock left behind by a refresher killed mid-flight. The reclaim
    # is a rename, not an rmdir: with rmdir, two contenders that both see the
    # stale lock can both proceed — the second removes the first's *fresh* lock
    # and takes its own, and the first's EXIT trap then releases the second's.
    # `mv` is atomic, so exactly one contender can move the stale directory
    # aside and the loser's mv fails harmlessly.
    if [ -d "$lock" ]; then
        _file_age "$lock"
        if [ -n "${_AGE:-}" ] && [ "$_AGE" -gt 120 ]; then
            mv "$lock" "$lock.reclaimed.$$" 2>/dev/null && rmdir "$lock.reclaimed.$$" 2>/dev/null
        fi
    fi
    mkdir "$lock" 2>/dev/null || return 0
    # The trap body is evaluated at exit, by which point a `local` is long out
    # of scope; the path has to survive in a global for the release to fire.
    _USAGE_LOCK="$lock"
    _USAGE_TMP="$dir/.resp.$$ $dir/.hdr.$$"
    # shellcheck disable=SC2064
    trap 'rm -f ${_USAGE_TMP:-} 2>/dev/null; rmdir "${_USAGE_LOCK:-}" 2>/dev/null' EXIT
    # Sweep anything a SIGKILLed predecessor left behind — the EXIT trap cannot
    # fire for that one, and nothing else ever prunes this directory.
    find "$dir" -maxdepth 1 -type f -name '.resp.*' -mmin +5 -delete 2>/dev/null
    find "$dir" -maxdepth 1 -type f -name '.hdr.*' -mmin +5 -delete 2>/dev/null
    # And any lock a reclaim renamed aside but could not remove; -type f above
    # never matches a directory, so nothing else would ever clear these.
    find "$dir" -maxdepth 1 -type d -name '.lock.reclaimed.*' -mmin +5 -exec rm -rf {} + 2>/dev/null

    local org="" cfg
    cfg=$(_claude_config_file)
    _read_org_from "$cfg"; org="$_ORG"

    # Honour the cadence under the lock. The render kicks on _FABLE_DUE, which
    # is deliberately raised by conditions that are not "the interval elapsed" —
    # a corrupt cache, an unreadable config — so without this a stray DUE spends
    # a request the schedule had already booked. Re-read here rather than trust
    # the caller: this is the one place that sees the cache under the lock,
    # after any concurrent refresher has written.
    #
    # The account check comes FIRST and overrides the interval: a cache holding
    # another account's reading must be replaced now, not when its window
    # happens to elapse. Ordering these the other way silently reintroduced the
    # cross-account defect this file's own test exists to catch.
    # Honour the cadence under the lock, reading THIS account's own record. The
    # render kicks on _FABLE_DUE, which is deliberately raised by conditions
    # that are not "the interval elapsed" — a corrupt cache, an unreadable
    # config — so without this a stray DUE spends a request the schedule had
    # already booked. Because the record is per-account, the account check and
    # the interval no longer compete: no mismatch can bypass a backoff.
    local cache=""
    _usage_cache_file "$org" || _CACHE_FILE="$dir/fable.unattributed.json"
    if [ -f "$_CACHE_FILE" ]; then
        cache="$_CACHE_FILE"
        local due_at
        due_at=$(jq -r '(.next_poll_at // 0 | tostring)' "$cache" 2>/dev/null) || due_at=0
        [[ "${due_at:-}" =~ ^[0-9]+$ ]] || due_at=0
        _sl_now
        if [[ "${_NOW:-}" =~ ^[0-9]+$ ]] && [ "$_NOW" -lt "$due_at" ]; then return 0; fi
    fi

    # Claude Code's own credential, read and never written: it owns the refresh
    # cycle, so an expired token is a 401 to back off from, not ours to repair.
    # The default path is absolute so a `security` planted earlier on PATH
    # cannot intercept a credential read. CS_SECURITY_BIN overrides it for the
    # test suite; that is not a weakening, because anyone who can set the
    # environment of this process can already redirect its `curl` and `jq`.
    local creds="" token="" sec="${CS_SECURITY_BIN:-/usr/bin/security}"
    if [ -x "$sec" ]; then
        # A locked login keychain can put `security` behind a SecurityAgent
        # prompt that never gets answered on a headless or ssh host, and this
        # process holds the machine-wide refresh lock while it waits.
        #
        # _timeout is not enough here: it falls through to bare execution when
        # neither timeout nor gtimeout exists, and stock macOS ships neither —
        # which is the only platform where that prompt exists at all, so the
        # bound would be missing exactly where it is needed. /usr/bin/perl is on
        # every macOS and its alarm() needs no coreutils.
        creds=$(_bounded_capture 5 "$sec" find-generic-password \
            -a "${USER:-$(id -un 2>/dev/null)}" -s "Claude Code-credentials" -w 2>/dev/null) || creds=""
    fi
    if [ -z "$creds" ]; then
        # Linux and WSL2 have no Keychain; Claude Code keeps the same document
        # in plaintext there. Same shape, so the same extraction works.
        local plain="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.credentials.json"
        [ -f "$plain" ] && creds=$(cat "$plain" 2>/dev/null)
    fi
    if [ -n "$creds" ]; then
        token=$(printf '%s' "$creds" | jq -r '.claudeAiOauth.accessToken // empty' 2>/dev/null) || token=""
    fi
    creds=""
    if [ -z "$token" ]; then
        _usage_write "$org" - "" "$USAGE_FAIL_BACKOFF"
        return 0
    fi

    local body="$dir/.resp.$$" hdr="$dir/.hdr.$$" code
    # The bearer goes to curl on stdin as a -K config line. On argv it would sit
    # in `ps` output for every process on the machine to read.
    code=$(printf 'header = "Authorization: Bearer %s"\n' "$token" | curl -sS -K - \
        --max-time 8 -o "$body" -D "$hdr" -w '%{http_code}' \
        -H "anthropic-beta: $USAGE_BETA" -H "User-Agent: cs-statusline" \
        "$USAGE_URL" 2>/dev/null) || code=000
    token=""

    # An account swap during the request would otherwise stamp the account we
    # asked about with the org that is signed in now — the same defect as
    # re-labelling a carried-forward reading, but reached through success, so
    # the carry-forward guard cannot see it. Discard rather than guess.
    #
    # Only two populated, differing values are evidence of a swap. An empty
    # reading means the config was briefly unreadable, which _fable_read already
    # treats as unknown; disagreeing with it here would throw away a good
    # reading for the right account and blank the capsule for a whole interval.
    _read_org_from "$cfg"
    if [ -n "$_ORG" ] && [ -n "$org" ] && [ "$_ORG" != "$org" ]; then
        # Discard the result: it belongs to the account we started under, which
        # is no longer signed in. Record the schedule against THAT account —
        # its budget paid for the request — and leave the account swapped TO
        # untouched. Writing to $_ORG here would blank a reading it already
        # holds and restamp it fresh, emptying the capsule for a full interval on
        # the account that just became active, which is the swap case the whole
        # feature is for. If it has no reading, the next render is due anyway.
        _usage_write "$org" - "" "$USAGE_MIN_INTERVAL"
        rm -f "$body" "$hdr" 2>/dev/null
        return 0
    fi

    # A 200 whose body is not this API's JSON — a captive portal or proxy
    # interstitial — parses to no Fable window, which is indistinguishable from
    # "this account has no Fable bucket" and would wipe the last good reading
    # AND stamp it fresh. Require the response to be the shape we asked for;
    # anything else is a failure, and the failure paths carry forward.
    if [ "$code" = "200" ] && ! jq -e 'has("limits") or has("five_hour") or has("seven_day")' "$body" >/dev/null 2>&1; then
        code="bad-body"
    fi

    if [ "$code" = "200" ]; then
        # The unified windows ride in the same limits[] array with a null model
        # scope, so the Fable bucket is selected by its model display name —
        # never by position, which would silently record the 5-hour number.
        local fable pct="" reset=""
        fable=$(jq -r 'first(.limits[]? | select((.scope.model.display_name // "") | test("^fable"; "i")))
                       | [(.percent // "" | tostring), (.resets_at // "")] | .[]' "$body" 2>/dev/null) || fable=""
        if [ -n "$fable" ]; then
            { IFS= read -r pct; IFS= read -r reset; } <<EOF
$fable
EOF
        fi
        [[ "${pct:-}" =~ ^[0-9]+(\.[0-9]+)?$ ]] || pct=""
        _usage_write "$org" "${pct:-null}" "${reset:-}" "$USAGE_MIN_INTERVAL"
    else
        local wait="$USAGE_FAIL_BACKOFF" ra=""
        if [ "$code" = "429" ] && [ -f "$hdr" ]; then
            # No `exit` in the awk: an early-exiting pipe consumer SIGPIPEs its
            # producer, which under `set -o pipefail` reports failure.
            ra=$(tr -d '\r' < "$hdr" | awk 'tolower($1)=="retry-after:"{v=$2} END{print v}') || ra=""
            # 10# forces base 10: a zero-padded value would otherwise be read
            # as octal by $(( )) and abort the arithmetic on an 8 or 9.
            if [[ "${ra:-}" =~ ^[0-9]+$ ]] && [ $(( 10#$ra + 60 )) -gt "$wait" ]; then
                wait=$(( 10#$ra + 60 ))
            fi
        fi
        _usage_write "$org" - "" "$wait"
    fi
    rm -f "$body" "$hdr" 2>/dev/null
}

USAGE_MAX_AGE=1800   # past this a reading is too old to sit beside a live countdown

# Read the cached Fable window into _FABLE_PCT (integer) and _FABLE_RESET
# (epoch), and raise _FABLE_DUE when a refresh should be kicked. Identity is
# structural rather than checked: the record is addressed by the account signed
# in now, so a reading can never be found under the wrong one and no comparison
# is needed. Anything unreadable or too old yields no reading at all — the capsule
# may be absent, but it must never carry a number that is not this account's.
_fable_read() {
    _FABLE_PCT=""
    _FABLE_RESET=""
    _FABLE_DUE=""
    command -v jq >/dev/null 2>&1 || return 0
    local cache cfg
    cfg=$(_claude_config_file)
    [ -f "$cfg" ] || return 0
    # Read this account's own record. Addressing by account rather than
    # filtering one shared file means a reading can never be found under the
    # wrong identity; an unreadable config yields no account and so no file.
    _read_org_from "$cfg"
    _usage_cache_file "${_ORG:-}" || return 0
    cache="$_CACHE_FILE"
    if [ ! -f "$cache" ]; then _FABLE_DUE=1; return 0; fi
    _sl_now
    [[ "${_NOW:-}" =~ ^[0-9]+$ ]] || return 0
    # The record's fields, one per line, from the sibling `.fields` file when
    # the writer left one (see _usage_fields_write): pct, resets_at, fetched_at,
    # next_poll_at, and resets_at as an epoch, so the render neither parses
    # JSON nor forks date. Without one, jq reads the JSON and the file is
    # written here so the next render has it.
    local pct="" reset="" fetched="" next="" reset_epoch=""
    if [ -f "$cache.fields" ]; then
        {
            IFS= read -r pct
            IFS= read -r reset
            IFS= read -r fetched
            IFS= read -r next
            IFS= read -r reset_epoch
        } < "$cache.fields"
    else
        local fields
        fields=$(jq -r '
            [ (.pct // "" | tostring),
                (.resets_at // ""),
                (.fetched_at // 0 | tostring),
                (.next_poll_at // 0 | tostring) ] | .[]' "$cache" 2>/dev/null) || { _FABLE_DUE=1; return 0; }
        if [ -z "$fields" ]; then _FABLE_DUE=1; return 0; fi
        {
            IFS= read -r pct
            IFS= read -r reset
            IFS= read -r fetched
            IFS= read -r next
        } <<EOF
$fields
EOF
        _iso_epoch "$reset"; reset_epoch="${_EPOCH:-}"
        _usage_fields_write "$cache" "$pct" "$reset" "$fetched" "$next" "$reset_epoch"
    fi
    [[ "${next:-}" =~ ^[0-9]+$ ]] || next=0
    [ "$_NOW" -ge "$next" ] && _FABLE_DUE=1
    [[ "${fetched:-}" =~ ^[0-9]+$ ]] || return 0
    [ $(( _NOW - fetched )) -le "$USAGE_MAX_AGE" ] || return 0
    [[ "${pct:-}" =~ ^[0-9]+(\.[0-9]+)?$ ]] || return 0
    _FABLE_PCT="${pct%%.*}"
    [[ "${reset_epoch:-}" =~ ^[0-9]+$ ]] || reset_epoch=""
    _FABLE_RESET="$reset_epoch"
}

# The render-side copy of a usage record: cache file $1's fields one per line
# (pct, resets_at, fetched_at, next_poll_at, resets_at as an epoch). Written
# beside the JSON by whoever last had the values parsed, so a render reads it
# with builtins. Best effort; a missing file only costs the next render a jq.
_usage_fields_write() {  # cache pct reset fetched next reset_epoch
    { printf '%s\n' "$2" "$3" "$4" "$5" "$6" > "$1.fields.tmp.$$" \
        && mv "$1.fields.tmp.$$" "$1.fields"; } 2>/dev/null || rm -f "$1.fields.tmp.$$" 2>/dev/null
}

# Read one key from a session's machine-local state file (.cs/local/state)
# into _STATE_VALUE (empty if none). Pure bash: this runs per render, where an
# awk fork is real cost. KEEP THE FORMAT IN SYNC WITH bin/cs's
# _read_local_state.
_read_state_key() {  # state-file key
    _STATE_VALUE=""
    local state="$1" key="$2" line v
    [ -f "$state" ] || return 0
    while IFS= read -r line; do
        case "$line" in
            "$key":*)
                v="${line#"$key":}"
                v="${v#"${v%%[![:space:]]*}"}"
                _STATE_VALUE="${v//\"/}"
                return 0
                ;;
        esac
    done < "$state"
}

# Format the git segment text for a workspace dir into _GIT_TEXT, empty when
# it is not a git repo / git is unavailable / git times out.
# git status is the one fork here that also reads the working tree, and the bar
# repaints once a second; a reading is reused for GIT_CACHE_TTL seconds, keyed
# by the workspace path, so at most one render in five pays for it. The entry
# is `epoch text` on one line, written by a builtin; a torn read is a miss.
GIT_CACHE_TTL=5

_git_text() {
    _GIT_TEXT=""
    local dir="$1"
    [ -n "$dir" ] || return 0
    [ -e "$dir/.git" ] || return 0
    local key="${dir//\//-}" entry="" line="" when
    key="${key//[^A-Za-z0-9._-]/_}"
    case "${#key}" in [1-9][0-9][0-9]|[1-9][0-9][0-9][0-9]*) key="${key: -200}" ;; esac
    if [ -n "$key" ]; then
        entry="$HOME/.cache/cs/git/$key"
        _sl_now
        if [[ "${_NOW:-}" =~ ^[0-9]+$ ]] && [ -f "$entry" ] && IFS= read -r line < "$entry"; then
            when="${line%% *}"
            if [[ "$when" =~ ^[0-9]+$ ]] && [ $(( _NOW - when )) -le "$GIT_CACHE_TTL" ]; then
                [ "$line" != "$when" ] && _GIT_TEXT="${line#* }"
                return 0
            fi
        fi
    fi
    _git_status_text "$dir"
    if [ -n "$entry" ] && [[ "${_NOW:-}" =~ ^[0-9]+$ ]]; then
        [ -d "${entry%/*}" ] || mkdir -p "${entry%/*}" 2>/dev/null
        { printf '%s %s\n' "$_NOW" "$_GIT_TEXT" > "$entry"; } 2>/dev/null || true
    fi
}

# One git status, parsed into _GIT_TEXT (empty when git is unavailable, times
# out, or reports no branch).
_git_status_text() {
    local dir="$1" out
    out=$(_timeout 2 git -C "$dir" status --porcelain=v1 -b 2>/dev/null) || return 0
    local branch="" ahead=0 behind=0 staged=0 modified=0 first=1 line x y h
    while IFS= read -r line; do
        if [ "$first" = "1" ]; then
            first=0
            h="${line#\#\# }"
            case "$h" in
                "No commits yet on "*) branch="${h#No commits yet on }" ;;
                "HEAD (no branch)")    branch="HEAD" ;;
                *)
                    branch="${h%%...*}"
                    [[ "$h" =~ ahead\ ([0-9]+) ]] && ahead="${BASH_REMATCH[1]}"
                    [[ "$h" =~ behind\ ([0-9]+) ]] && behind="${BASH_REMATCH[1]}"
                    ;;
            esac
        else
            x="${line:0:1}"; y="${line:1:1}"
            # Untracked entries are `??` in both columns; exclude `?` from both
            # counts so untracked files do not show as a phantom modified `!`.
            [ "$x" != " " ] && [ "$x" != "?" ] && staged=$((staged + 1))
            [ "$y" != " " ] && [ "$y" != "?" ] && modified=$((modified + 1))
        fi
    done <<EOF
$out
EOF
    [ -n "$branch" ] || return 0
    local text="$branch"
    # Brace the expansion: a bare $text↑ would let set -u read the arrow's first
    # UTF-8 byte as part of the variable name and abort on "unbound variable".
    [ "$ahead" -gt 0 ] && text="${text}↑${ahead}"
    [ "$behind" -gt 0 ] && text="${text}↓${behind}"
    local marks=""
    [ "$staged" -gt 0 ] && marks="+$staged"
    [ "$modified" -gt 0 ] && marks="$marks!$modified"
    [ -n "$marks" ] && text="$text $marks"
    _GIT_TEXT="$text"
}

# --- segments --------------------------------------------------------------

# The Claude mark, coral ink on the identity capsule. While the session's
# attention marker exists (raised by the Stop hook when Claude finishes a turn,
# cleared on the next prompt) the mark alternates brand/brandshade by epoch-
# second parity; the statusLine registration's refreshInterval repaints the bar
# every second while idle so the phase keeps advancing. CS_STATUSLINE_NOW pins
# the clock for tests. Plain mode has no colour, so no mark.
_seg_logo() {
    [ "$LEVEL" = "plain" ] && return 0
    local ink=brand
    if [ -n "${CLAUDE_SESSION_NAME:-}" ] \
        && [ -f "$SESSIONS_ROOT/$CLAUDE_SESSION_NAME/.cs/local/attention" ]; then
        _sl_now
        [ $(( ${_NOW:-0} % 2 )) -eq 1 ] && ink=brandshade
    fi
    _add "${ICON_LOGO}" identity "$ink" bold
}

# The session name, bold, in its own claude_session_color when the session has
# one (the same palette Claude Code's own tab and /color share), else primary
# ink. A colour outside that palette (state hand-edited or from a future
# claude release) falls back to ink rather than reaching _sgr with a name it
# does not resolve. KEEP IN SYNC with the eight names in _sgr and
# _session_color_rgb in bin/cs.
_seg_session() {
    local name="$SL_SESSION"
    [ -n "$name" ] || name="${CLAUDE_SESSION_NAME:-}"
    if [ -z "$name" ]; then
        local dir="${SL_DIR:-$PWD}"
        name="${dir##*/}"
    fi
    _add "${name}" identity ink bold space
}

# Count of queued tasks for the current session (one file per task in
# .cs/local/queue/), shown right after the session name. Hidden when the
# queue is empty or absent. Only regular files count, so a subdirectory or
# an unmatched glob (bash 3.2 has no nullglob) never inflates the count.
_seg_notes() {
    [ -n "${CLAUDE_SESSION_NAME:-}" ] || return 0
    local qdir="$SESSIONS_ROOT/$CLAUDE_SESSION_NAME/.cs/local/queue"
    [ -d "$qdir" ] || return 0
    local n=0 f
    for f in "$qdir"/*; do
        [ -f "$f" ] || continue
        n=$((n + 1))
    done
    [ "$n" -gt 0 ] || return 0
    _add "${ICON_NOTES}${n}" identity amber "" pad
}

# Unread cross-session mail for the current session, shown after the notes
# queue. Hidden when nothing is unread or the maildir is absent. Unread is the
# count of mail/new/*.json documents (cs -msg moves what it prints to cur/) —
# the same basis as the shell reader and the TUI. Only *.json files count: a
# .DS_Store, a staging leftover or a subdirectory must not show a phantom
# unread that never clears. The [ -f ] guard also covers bash 3.2's lack of
# nullglob (an unmatched glob comes back literal).
_seg_mail() {
    [ -n "${CLAUDE_SESSION_NAME:-}" ] || return 0
    local mdir="$SESSIONS_ROOT/$CLAUDE_SESSION_NAME/.cs/local/mail"
    [ -d "$mdir/new" ] || return 0
    local unread=0 f
    for f in "$mdir"/new/*.json; do
        [ -f "$f" ] || continue
        unread=$((unread + 1))
    done
    [ "$unread" -gt 0 ] || return 0
    _add "${ICON_MAIL}${unread}" identity amber "" pad
}

# The tmux pane hosting this conversation, "◫ 7": the number without its "%"
# so it cannot read as a percentage; prefix it back for a tmux target. Both
# vars are inherited environment, so neither is evidence on its own (see
# SL_ENV_FOREIGN). Off the default order; renders when named.
_seg_pane() {
    [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ] || return 0
    [ -z "${SL_ENV_FOREIGN:-}" ] || return 0
    _add "${ICON_PANE}${TMUX_PANE#%}" identity ink2 "" pad
}

# The ctx icon is a pie that fills as context does. Its quarter and
# three-quarter steps sit at the warn and crit thresholds so the shape changes
# exactly where the ink does; the empty and full ends sit at fixed 13 and 88.
_ctx_pie() {  # pct warn crit -> _PIE
    local v="$1" warn="$2" crit="$3"
    if [ "$v" -ge 88 ]; then _PIE="$ICON_CTX_FULL"
    elif [ "$v" -ge "$crit" ]; then _PIE="$ICON_CTX_3Q"
    elif [ "$v" -ge "$warn" ]; then _PIE="$ICON_CTX_HALF"
    elif [ "$v" -ge 13 ]; then _PIE="$ICON_CTX"
    else _PIE="$ICON_CTX_EMPTY"
    fi
}

# Two items in the ctx capsule: the pie and label in secondary ink, the number
# in the threshold colour. At crit the whole capsule inverts.
_seg_ctx() {
    local v="${SL_CTX%%.*}"
    [ -n "$v" ] || return 0
    local warn crit
    _num_or "${CS_STATUSLINE_CTX_WARN:-}" 40; warn="$_NUM"
    _num_or "${CS_STATUSLINE_CTX_CRIT:-}" 65; crit="$_NUM"
    _thresh_color "$v" "$warn" "$crit"
    [ "$_COLOR" = "crit" ] && _invert ctx
    _ctx_pie "$v" "$warn" "$crit"
    _add "${_PIE}ctx" ctx ink2 "" none
    _add "${v}%" ctx "$_COLOR" "$_HOT_WEIGHT" space
}

# The effort word after the model wears Claude Code's own /effort colour for
# that level, regular weight; max is painted letter by letter through its
# gradient. A level the picker does not have stays secondary ink.
_seg_model() {
    [ -n "$SL_MODEL" ] || return 0
    _add "${ICON_MODEL}${SL_MODEL}" identity ink bold
    [ -n "$SL_EFFORT" ] || return 0
    case "$SL_EFFORT" in
        low|medium|high|xhigh)
            _add "$SL_EFFORT" identity "effort-$SL_EFFORT" "" space ;;
        max)
            _add "m" identity effort-max-1 "" space
            _add "a" identity effort-max-2 "" none
            _add "x" identity effort-max-3 "" none ;;
        *)
            _add "$SL_EFFORT" identity ink2 "" space ;;
    esac
    return 0
}

_seg_git() {
    _git_text "$SL_DIR"
    local t="$_GIT_TEXT"
    [ -n "$t" ] || return 0
    _add "${ICON_GIT}${t}" identity ink bold
}

# One rate-limit window: label in secondary ink, the number in the threshold
# colour. $4 is the usage floor at or above which the reset countdown is
# appended (5h at 70, the reveal; the seven-day windows at 80: the coarse
# windows only make time-to-reset actionable near exhaustion). $6 is the
# capsule the window lands in and $7 the join before its label: 5h and wk
# share the quota capsule, joined by a vertical ellipsis (U+22EE, text height); fable has its own. A crit window
# inverts its whole capsule, so one hot window reddens the pair: throttling is
# near for the account, whichever window tripped.
_limits_render() {
    local name="$1" pct="$2" reset="$3" gate="$4" icon="$5" group="$6" join="$7"
    _thresh_color "$pct" 70 90
    [ "$_COLOR" = "crit" ] && _invert "$group"
    local label="${pct}%"
    if [ "$pct" -ge "$gate" ]; then
        _fmt_rest "$reset"
        [ -n "$_REST" ] && label="$label · $_REST"
    fi
    _add "${icon}${name}" "$group" ink2 "" "$join"
    _add "$label" "$group" "$_COLOR" "$_HOT_WEIGHT" space
}

# Read the Fable window into the candidate list. Model-scoped, so it is only
# ever a candidate on a Fable session; the cache read and the refresh kick run
# whether or not the capsule is shown, so a hidden window keeps polling at its
# floor. See _fable_read and _refresh_usage.
_fable_candidate() {
    _FABLE_KICKED=""
    case "${SL_MODEL_ID:-}" in claude-fable*) ;; *) return 0 ;; esac
    _fable_read
    # A machine with no curl can never write the cache, so every render would be
    # due and every render would fork a subshell plus a whole bash load of this
    # script just to bail — once a second, per open Fable session. Check here
    # instead, where the check is free.
    if [ -n "$_FABLE_DUE" ] && [ "${CS_USAGE_NO_REFRESH:-}" != "1" ] \
        && command -v curl >/dev/null 2>&1; then
        _FABLE_KICKED=1
        # Detached, so the render never waits on the network: the subshell exits
        # at once and the refresher is orphaned. Its own lock is what keeps
        # concurrent sessions from stampeding the endpoint.
        ( "${BASH:-bash}" "$_SL_SELF" --refresh-usage >/dev/null 2>&1 & ) >/dev/null 2>&1
    fi
    [ -n "$_FABLE_PCT" ] || return 0
    _LIM_NAME+=("fable"); _LIM_PCT+=("$_FABLE_PCT"); _LIM_RESET+=("$_FABLE_RESET")
    _LIM_GATE+=(80); _LIM_ICON+=("$ICON_FABLE"); _LIM_SHOW+=(50); _LIM_GROUP+=("lim-fable")
}

# The 5h window is the one being spent right now, so it is always on the bar.
# The coarse windows — wk from stdin and, on a Fable session, the model-scoped
# weekly window from the usage cache — arrive at 50 and stay hidden below it;
# their arrival is the signal. The order is fixed: 5h, wk, fable. Reveal and
# colour are separate: every window is neutral below 70, amber from 70, crit
# from 90 (see _limits_render).
_seg_limits() {
    _LIM_NAME=(); _LIM_PCT=(); _LIM_RESET=(); _LIM_GATE=(); _LIM_ICON=(); _LIM_SHOW=(); _LIM_GROUP=()
    local h="${SL_5H%%.*}" w="${SL_WK%%.*}"
    if [ -n "$h" ]; then
        _LIM_NAME+=("5h"); _LIM_PCT+=("$h"); _LIM_RESET+=("$SL_5H_RESET"); _LIM_GATE+=(70); _LIM_ICON+=("$ICON_5H"); _LIM_SHOW+=(0); _LIM_GROUP+=("limits")
    fi
    if [ -n "$w" ]; then
        _LIM_NAME+=("wk"); _LIM_PCT+=("$w"); _LIM_RESET+=("$SL_WK_RESET"); _LIM_GATE+=(80); _LIM_ICON+=("$ICON_WK"); _LIM_SHOW+=(50); _LIM_GROUP+=("limits")
    fi
    _fable_candidate
    _limits_emit_hot
}

# The `fable` name alone: the Fable window only. When `limits` is also named
# (in either order) that segment owns all three windows and this one is a
# no-op, so the two-capsule cap holds across the whole bar. Kept so a
# CS_STATUSLINE_SEGMENTS written before `limits` covered the Fable window still
# shows it.
_seg_fable() {
    [ -z "${_LIMITS_NAMED:-}" ] || return 0
    _LIM_NAME=(); _LIM_PCT=(); _LIM_RESET=(); _LIM_GATE=(); _LIM_ICON=(); _LIM_SHOW=(); _LIM_GROUP=()
    _fable_candidate
    _limits_emit_hot
}

# Render every candidate at or past its own reveal floor (_LIM_SHOW), in the
# order they were registered: 5h, wk, fable. The order is fixed so capsules
# never swap places as the numbers move.
_limits_emit_hot() {
    local n=${#_LIM_NAME[@]} i join opened=" "
    for ((i = 0; i < n; i++)); do
        [ -n "${_LIM_NAME[i]}" ] || continue
        [ "${_LIM_PCT[i]}" -ge "${_LIM_SHOW[i]}" ] || continue
        join=none
        case "$opened" in *" ${_LIM_GROUP[i]} "*) join=bar ;; esac
        opened="${opened}${_LIM_GROUP[i]} "
        _limits_render "${_LIM_NAME[i]}" "${_LIM_PCT[i]}" "${_LIM_RESET[i]}" \
            "${_LIM_GATE[i]}" "${_LIM_ICON[i]}" "${_LIM_GROUP[i]}" "$join"
    done
}

_seg_cost() {
    [ -n "$SL_COST" ] || return 0
    local formatted
    printf -v formatted '$%.2f' "$SL_COST" 2>/dev/null || return 0
    _add "$formatted" cost
}

# --- color math --------------------------------------------------------------

# Set _WIDTH to the display width (cells) of "$1": UTF-8 codepoints, not
# bytes — every icon and label this script emits is single-width, so
# codepoint count equals cell count. LC_ALL=C forces byte-wise indexing for
# the duration of this function regardless of the ambient locale or this
# bash's own multibyte awareness, so continuation bytes (the 0x80-0xBF range)
# can be counted and subtracted out: every codepoint has exactly one leading
# (non-continuation) byte. No subprocess. Used by bin/cs-subagent-statusline
# (_fixed_width and _truncate); no caller in this file.
_display_width() {
    local LC_ALL=C s="$1" i n=0
    local len=${#s}
    for ((i = 0; i < len; i++)); do
        case "${s:i:1}" in
            [$'\x80'-$'\xBF']) ;;
            *) n=$((n + 1)) ;;
        esac
    done
    _WIDTH=$n
}

# Parse "$1" as an "r;g;b" triplet of 0-255 integers into _R/_G/_B. Returns 1
# (leaving _R/_G/_B unset) if the string doesn't parse — a missing field, an
# extra field, a non-numeric value, and an out-of-range channel are all
# rejected by the same width/format check, so callers need no separate
# validation step: a failed parse is the single "this isn't usable" signal.
_parse_rgb_triplet() {
    local rgb="$1" r g b
    [[ "$rgb" =~ ^[0-9]{1,3}\;[0-9]{1,3}\;[0-9]{1,3}$ ]] || return 1
    IFS=';' read -r r g b <<< "$rgb"
    [ "$r" -le 255 ] && [ "$g" -le 255 ] && [ "$b" -le 255 ] || return 1
    _R="$r"; _G="$g"; _B="$b"
}

# Set _LUM to the BT.709 relative luminance of _R/_G/_B, scaled by 10000 (so
# the mid-grey pivot is 1275000). Reads the channels _parse_rgb_triplet leaves
# behind; fork-free.
_luminance() {
    _LUM=$((2126 * _R + 7152 * _G + 722 * _B))
}

# Set _R/_G/_B to a shade of the color "$1", nudged away from itself: darker
# when it is light, lighter when it is dark, classified by BT.709 luminance.
# Its only caller is the surface: a shade of the terminal background. Returns
# non-zero on a color that does not parse, so callers can fall back.
_bg_shade() {
    _parse_rgb_triplet "$1" || return 1
    local r="$_R" g="$_G" b="$_B" shift=10
    _luminance
    if [ "$_LUM" -ge 1275000 ]; then
        _R=$((r * (100 - shift) / 100))
        _G=$((g * (100 - shift) / 100))
        _B=$((b * (100 - shift) / 100))
    else
        _R=$((r + (255 - r) * shift / 100))
        _G=$((g + (255 - g) * shift / 100))
        _B=$((b + (255 - b) * shift / 100))
    fi
}

# --- render ----------------------------------------------------------------

# One line of capsules on the terminal's own background. Each group of items
# becomes one capsule: a rounded left cap, the items (joined as each asked), a
# rounded right cap, with no fill space between a cap and the item beside it;
# two default-background cells follow the identity capsule and one follows
# every other. The caps are Powerline glyphs (U+E0B6/U+E0B4) drawn as
# fill-coloured ink on the default background, so they read as the capsule's
# rounded ends; CS_STATUSLINE_CAPS=0 drops the glyphs for a font without them
# and each cap is replaced by a fill space, giving the chip a square edge.
# A crit capsule takes the crit fill and paints every item critink bold.
# SGR bold is stateful, so every item emits its intensity explicitly (1 or 22).
# No width accounting and no tail: the line ends at the last cap.

# Whether to draw the Powerline caps. They are the bar's one private-use glyph,
# so nothing draws them until this machine has said its font has them: the
# installer asks once and records the answer in the per-machine caps file
# (`cs -statusline caps` rewrites it). CS_STATUSLINE_CAPS=1/0 in the
# environment overrides the file either way. Unanswered means square ends.
_caps_file() {
    printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/cs/statusline-caps"
}
_caps_wanted() {
    case "${CS_STATUSLINE_CAPS:-}" in
        1) return 0 ;;
        0) return 1 ;;
    esac
    local f answer=""
    f=$(_caps_file)
    # A regular, readable file only: a directory at the path would print "Is a
    # directory" on every repaint, and a broken symlink is no answer either.
    [ -f "$f" ] && [ -r "$f" ] && { IFS= read -r answer < "$f"; } 2>/dev/null
    [ "$answer" = "on" ]
}

_render() {
    local n=${#_SEG_TEXT[@]}
    [ "$n" -gt 0 ] || return 0
    local i g="" out=""

    if [ "$LEVEL" = "plain" ]; then
        local k first
        for ((k = 0; k < ${#_GROUPS[@]}; k++)); do
            g="${_GROUPS[k]}"
            [ "$k" -gt 0 ] && out+=" > "
            first=1
            for ((i = 0; i < n; i++)); do
                [ "${_SEG_GROUP[i]}" = "$g" ] || continue
                if [ -z "$first" ]; then
                    case "${_SEG_JOIN[i]}" in
                        dot)       out+=" · " ;;
                        bar)       out+=" ⋮ " ;;
                        pad|space) out+=" " ;;
                    esac
                fi
                first=""
                out+="${_SEG_TEXT[i]}"
            done
        done
        printf '%s\n' "$out"
        return 0
    fi

    local esc=$'\033' reset=$'\033[0m'
    local capl=$'\xee\x82\xb6' capr=$'\xee\x82\xb4'   # U+E0B6, U+E0B4
    _caps_wanted || { capl=""; capr=""; }
    local fill fillsgr capsgr ink weight first k critink=critink
    # A red capsule's text pulses white/critshade on the same epoch-second
    # clock as the attention mark, so a crit reading moves while the bar idles.
    if [ -n "$_CRIT_GROUPS" ]; then
        _sl_now
        [ $(( ${_NOW:-0} % 2 )) -eq 1 ] && critink=critshade
    fi
    out="$reset"
    # Capsules in first-seen group order; a group's items in their own order,
    # even when CS_STATUSLINE_SEGMENTS interleaves them (session,ctx,model).
    for ((k = 0; k < ${#_GROUPS[@]}; k++)); do
        g="${_GROUPS[k]}"
        fill=surface
        case "$_CRIT_GROUPS" in *" $g "*) fill=crit ;; esac
        _sgr 48 "$fill"; fillsgr="$_SGR"
        _sgr 38 "$fill"; capsgr="$_SGR"
        if [ -n "$capl" ]; then
            out+="${esc}[49;${capsgr}m${capl}"
        else
            out+="${esc}[${fillsgr}m "
        fi
        first=1
        for ((i = 0; i < n; i++)); do
            [ "${_SEG_GROUP[i]}" = "$g" ] || continue
            if [ -z "$first" ]; then
                case "${_SEG_JOIN[i]}" in
                    dot)   _sgr 38 ink2; out+="${esc}[${fillsgr};${_SGR};22m  ·  " ;;
                    bar)   _sgr 38 ink2; out+="${esc}[${fillsgr};${_SGR};22m ⋮ " ;;
                    pad)   out+="${esc}[${fillsgr}m  " ;;
                    space) out+="${esc}[${fillsgr}m " ;;
                esac
            fi
            first=""
            ink="${_SEG_INK[i]}"; weight=22
            [ -n "${_SEG_BOLD[i]}" ] && weight=1
            if [ "$fill" = "crit" ]; then ink="$critink"; weight=1; fi
            _sgr 38 "$ink"
            out+="${esc}[${fillsgr};${_SGR};${weight}m${_SEG_TEXT[i]}"
        done
        if [ -n "$capr" ]; then
            out+="${esc}[49;${capsgr}m${capr}"
        else
            out+="${esc}[${fillsgr}m "
        fi
        out+="$reset"
        [ $((k + 1)) -lt ${#_GROUPS[@]} ] && out+=" "
    done
    printf '%s\n' "$out"
}

# --- main ------------------------------------------------------------------

main() {
    [ "${CS_STATUSLINE_DISABLE:-}" = "1" ] && exit 0

    # Out-of-band refresh mode. Re-invoking this script rather than installing a
    # second binary keeps the feature to one file and off the install manifest.
    if [ "${1:-}" = "--refresh-usage" ]; then
        _NOW=""
        _SL_NOW_READY=""
        _refresh_usage
        exit 0
    fi

    # Sanitize the shared-clock memo at the start of every render: neither the
    # value nor its ready flag may be seeded by an inherited environment variable
    # of the same name. Otherwise a stale/garbage _NOW would poison the limits
    # stamp and crash the pulse arithmetic (bash 3.2 set -u). Free, no fork.
    _NOW=""
    _SL_NOW_READY=""

    _read_stdin
    _parse_stdin "$_STDIN" || _fallback

    _detect_level

    local segments="${CS_STATUSLINE_SEGMENTS:-logo,session,notes,mail,git,model,ctx,limits}"
    _LIMITS_NAMED=""
    case ",$segments," in *,limits,*) _LIMITS_NAMED=1 ;; esac
    local name names
    IFS=',' read -ra names <<< "$segments"
    for name in "${names[@]}"; do
        case "$name" in
            logo)    _seg_logo ;;
            session) _seg_session ;;
            notes)   _seg_notes ;;
            mail)    _seg_mail ;;
            pane)    _seg_pane ;;
            ctx)     _seg_ctx ;;
            model)   _seg_model ;;
            git)     _seg_git ;;
            limits)  _seg_limits ;;
            fable)   _seg_fable ;;
            cost)    _seg_cost ;;
        esac
    done

    _render
}

# Sourced with CS_STATUSLINE_LIB=1, this file is a library: the palette, color
# ladder, and width helpers load without rendering. `return` is not usable here
# because it is an error outside a function in an executed script.
[ "${CS_STATUSLINE_LIB:-}" = "1" ] || main "$@"
