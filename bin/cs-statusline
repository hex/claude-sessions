#!/usr/bin/env bash
# ABOUTME: Claude Code statusLine command — renders one line of rounded capsules on the terminal's own background
# ABOUTME: Reads the statusline JSON on stdin and prints session/ctx/model/git/limits/cost

set -uo pipefail

# cs's settings files fill every CS_* key the environment does not pin, before
# any read below, so a file edit reaches the next repaint.
# >>> lib/03-config.sh (spliced by build.sh; edit lib/03-config.sh, never this block)
# The allow-list, one record per key, in the order `cs -config list` prints:
#   KEY|group|label|edit|check|choices|default|when|whenText
# edit is what the panel offers (flag toggles, choice asks with choices, text
# asks for free text, shell is changed from a shell only); check names the
# arm of _cs_config_check that accepts what the key's readers accept; when is
# now, /clear, launch or now+launch. Walked with parameter expansion only, so
# loading forks nothing.
_CS_CONFIG_SPEC=(
    'CS_STATUSLINE_DISABLE|Status line|Hide the status line|flag|flag|-|off|now|applies at the next repaint'
    'CS_STATUSLINE_LAYOUT|Status line|Layout|choice|enum|quiet,band,capsules|quiet|now|applies at the next repaint'
    'CS_STATUSLINE_SEGMENTS|Status line|Segments|text|segments|-|logo,session,notes,mail,git,model,ctx,limits|now|applies at the next repaint'
    'CS_STATUSLINE_BAND|Status line|Band colour|text|band|-|session|now|applies at the next repaint'
    'CS_STATUSLINE_COLS|Status line|Width in columns|text|cols|-|measured|now|applies at the next repaint'
    'CS_STATUSLINE_FRAME|Status line|Frame columns|text|num|-|4|now|applies at the next repaint'
    'CS_STATUSLINE_CTX_WARN|Status line|Context warn %|text|num|-|40|now|applies at the next repaint'
    'CS_STATUSLINE_CTX_CRIT|Status line|Context critical %|text|num|-|65|now|applies at the next repaint'
    'CS_USAGE_NO_REFRESH|Status line|Usage from cache only|flag|flag|-|off|now|applies at the next repaint'
    'CS_SUBAGENT_STATUSLINE_DISABLE|Status line|Hide the subagent rows|flag|flag|-|off|now|applies at the next repaint'
    'CS_SCOPE_DISABLE|Prompts|No scope grounding|flag|flag|-|off|now|applies at your next prompt'
    'CS_SCOPE_TRACE_DISABLE|Prompts|No scope trace|flag|flag|-|off|now|applies at your next prompt'
    'CS_SCOPE_BUDGET_MS|Prompts|Scope scan budget (ms)|text|ms|-|1500|now|applies at your next prompt'
    'CS_OBJECTIVE_CAPTURE_DISABLE|Prompts|No objective capture|flag|flag|-|off|now|applies at your next prompt'
    'CS_DATE_REMINDER_DISABLE|Prompts|No date reminder|flag|flag|-|off|now|applies at your next prompt'
    'CS_CLARIFY_DISABLE|Prompts|No clarifying questions|flag|flag|-|off|now|applies at your next prompt'
    'CS_CTX_WARN_CTX|Turn end|Context warning %|text|num|-|40|now|applies when the next turn ends'
    'CS_ROTATE_NUDGE_CTX|Turn end|Rotation nudge %|text|num|-|65|now|applies when the next turn ends'
    'CS_QUEUE_MAX_FAILURES|Turn end|Queue stops after failures|text|num|-|5|now|applies when the next turn ends'
    'CS_QUEUE_MAX_CTX|Turn end|Queue stops past context %|text|num|-|85|now|applies when the next turn ends'
    'CS_QUEUE_MAX_5H|Turn end|Queue stops past 5h limit %|text|num|-|85|now|applies when the next turn ends'
    'CS_MAIL_WAKE_MAX|Turn end|Mail wakes in a row|text|num|-|5|now|applies when the next turn ends'
    'CS_NO_MAIL_WAKE|Turn end|No mail wake|flag|flag|-|off|now|applies when the next turn ends'
    'CS_NARRATIVE_MAX_BYTES|Turn end|Narrative budget (bytes)|text|bytes|-|131072|now|applies when the next turn ends'
    'CS_NARRATIVE_KEEP_BYTES|Turn end|Narrative tail kept (bytes)|text|bytes|-|65536|now|applies when the next turn ends'
    'CS_ROTATE_FORCE_CTX|Rotation|Rotate on its own past %|text|force|-|80|now|applies by your next prompt'
    'CS_ROTATE_BUTTON_CTX|Rotation|Rotate button from %|text|num|-|the warn %|now|applies by your next prompt'
    'CS_NO_ROTATION_WAKE|Rotation|No wake after /clear|flag|flag|-|off|/clear|applies at the next /clear or launch'
    'CS_ROTATION_KICK_DELAY|Rotation|Wake delay (s)|text|secs|-|2|now|applies at the next rotation'
    'CS_REWRITE_PROVIDER|Rewriter (ctrl+g)|Provider|choice|enum|claude,claude-api,openai,openai-api,gemini,gemini-api,grok,xai|claude|now|applies at the next ctrl+g'
    'CS_REWRITE_MODEL|Rewriter (ctrl+g)|Model|text|model|-|per provider|now|applies at the next ctrl+g'
    'CS_REWRITE_TIMEOUT|Rewriter (ctrl+g)|Timeout (s)|text|secs|-|25|now|applies at the next ctrl+g'
    'CS_REWRITE_PROGRESS|Rewriter (ctrl+g)|Progress|choice|enum|screen,native,line,static|screen|now|applies at the next ctrl+g'
    'CS_REWRITE_DISABLE|Rewriter (ctrl+g)|No rewrite|flag|flag|-|off|now+launch|on: the next ctrl+g passes through. Off after a launch with it on: the next launch, which installs the ctrl+g shim.'
    'CS_TERM_THEME|Terminal|Theme|choice|enum|light,dark|detected|now|applies at the next repaint'
    'CS_TERM_BG_RGB|Terminal|Background r;g;b|text|rgb|-|detected|now|applies at the next repaint'
    'CS_NO_ITERM2|Terminal|No iTerm2 features|flag|flag|-|off|now+launch|the tab title, the bell bounce and the iTerm reads of the bar: now. The iTerm tmux path of the launch: the next launch.'
    'CS_NERD_FONTS|Terminal|Nerd Font glyphs|flag|flag|-|off|now|applies at the next cs command'
    'CS_NO_TASK_TOOLS|Launch|No task tools|flag|flag|-|off|launch|applies at the next launch'
    'CS_NO_UPDATE_CHECK|Launch|No update check|flag|flag|-|off|launch|applies at the next launch'
    'CS_NO_FUNCTION_HOOKS|Launch|No mods|shell|flag|-|off|launch|applies at the next launch; on, it loads no mod, the cs panel included'
)

# Keys a file never sets, each with the reason the writer gives. Each names a
# secret, a program cs runs, a path, where secrets live, or a setting with a
# record of its own: a file a plugin can write must choose none of them.
_CS_CONFIG_EXCLUDED=(
    'CS_SECRETS_PASSWORD|it is a secret, and the file is plain text'
    'CLAUDE_CODE_BIN|it names a program cs runs, which a file a plugin can write must not choose'
    'CS_TMUX_BIN|it names a program cs runs, which a file a plugin can write must not choose'
    'CS_REWRITE_CMD|it names a program cs runs, which a file a plugin can write must not choose'
    'CS_REAL_EDITOR|it names a program cs runs, which a file a plugin can write must not choose'
    'CS_SESSIONS_ROOT|it names where every session lives, and each process keys on it'
    'CS_SECRETS_BACKEND|it moves where cs-secrets looks, and every stored secret would vanish from view until it moved back'
    'CS_PLATFORM_OVERRIDE|it moves where cs-secrets looks, and every stored secret would vanish from view until it moved back'
    'CS_USAGE_DIR|it names a directory the status line writes to'
    'CS_ACTOR|identity has its own per-session file, .cs/local/identity, which outranks a machine-wide name'
    'CS_STATUSLINE_CAPS|it has its own record, which cs -statusline caps on|off|ask writes'
)

# Each key's check arm and choices, as "<arm>|<choices>" in _CS_CFG_R_<KEY>,
# so a line's key is looked up without a walk of the table. Built once a
# process, the first time a file or a value is checked: a reader on a machine
# with no settings file never pays for it.
_cs_config_index() {
    local rec key
    [ "${_CS_CFG_INDEXED:-}" != "$$" ] || return 0
    for rec in "${_CS_CONFIG_SPEC[@]}"; do
        key=${rec%%|*}
        rec=${rec#*|*|*|*|}
        printf -v "_CS_CFG_R_$key" '%s' "${rec%|*|*|*}"
    done
    _CS_CFG_INDEXED=$$
}

# <key>'s check arm in _CS_CFG_ARM and its choices in _CS_CFG_CHOICES; status
# 1, nothing set, for a key outside the allow-list. Runs after
# _cs_config_index.
_cs_config_record() {  # key
    # Indirect expansion evaluates an array subscript in the name: a key that
    # is not a name is no setting, and never reaches it.
    case "$1" in ''|[!A-Za-z_]*|*[!A-Za-z0-9_]*) return 1 ;; esac
    local r="_CS_CFG_R_$1"
    [ -n "${!r-}" ] || return 1
    _CS_CFG_ARM=${!r%%|*}
    _CS_CFG_CHOICES=${!r#*|}
}

# "a, b or c" from "a,b,c", in _CS_CONFIG_WHY.
_cs_config_or_list() {  # csv
    local rest="$1" out=""
    while :; do
        case "$rest" in
            *,*) out="${out:+$out, }${rest%%,*}"; rest=${rest#*,} ;;
            *) out="${out:+$out or }$rest"; break ;;
        esac
    done
    _CS_CONFIG_WHY=$out
}

# Whether <value> is an r;g;b triplet, each part 0 to 255 in one to three
# digits: what the status line's _parse_rgb_triplet takes.
_cs_config_rgb() {  # value
    local v="$1" part n=0
    case "$v" in ''|*[!0-9\;]*) return 1 ;; esac
    while :; do
        part=${v%%;*}
        case "$part" in ''|????*) return 1 ;; esac
        [ "$((10#$part))" -le 255 ] || return 1
        n=$((n + 1))
        case "$v" in *\;*) v=${v#*;} ;; *) break ;; esac
    done
    [ "$n" -eq 3 ]
}

# Whether <value> passes check arm <arm> (choices for enum), 0 or 1; on a
# refusal, what the arm accepts in _CS_CONFIG_WHY, phrased to follow "is" or
# "not". Each arm takes what its readers take today; none takes an empty value
# or a control character. A value that passes sets nothing: the readers check
# every line of a file on every repaint.
_cs_config_check() {  # arm, choices, value
    case "$1" in
        flag) case "$3" in 0|1) return 0 ;; esac ;;
        enum) case "$3" in ''|*,*) ;; *) case ",$2," in *",$3,"*) return 0 ;; esac ;; esac ;;
        num) case "$3" in ''|*[!0-9]*|????*) ;; *) return 0 ;; esac ;;
        ms|secs) case "$3" in ''|*[!0-9]*|????????*) ;; *) return 0 ;; esac ;;
        cols) case "$3" in ''|0*|*[!0-9]*|?????*) ;; *) return 0 ;; esac ;;
        bytes)
            case "$3" in
                ''|*[!0-9]*|????????????????*) ;;
                *) [ "$((10#$3))" -eq 0 ] || return 0 ;;
            esac
            ;;
        force)
            case "$3" in
                [oO][fF][fF]) return 0 ;;
                ''|*[!0-9]*|????*) ;;
                *) [ "$((10#$3))" -gt 100 ] || return 0 ;;
            esac
            ;;
        band)
            case "$3" in red|blue|green|yellow|purple|orange|pink|cyan|brand|periwinkle|session|none) return 0 ;; esac
            ! _cs_config_rgb "$3" || return 0
            ;;
        rgb) ! _cs_config_rgb "$3" || return 0 ;;
        segments) ! _cs_config_segments "$3" || return 0 ;;
        model)
            case "$3" in
                [A-Za-z0-9]*) case "$3" in *[!A-Za-z0-9._:/-]*) ;; *) [ "${#3}" -gt 128 ] || return 0 ;; esac ;;
            esac
            ;;
    esac
    _cs_config_why "$1" "$2"
    return 1
}

# Whether <value> is a comma-separated list of status line segments, each at
# most once: the names bin/cs-statusline draws.
_cs_config_segments() {  # value
    local rest="$1" item seen=","
    while :; do
        item=${rest%%,*}
        case "$item" in
            logo|session|notes|mail|pane|git|model|ctx|limits|fable|cost) ;;
            *) return 1 ;;
        esac
        case "$seen" in *",$item,"*) return 1 ;; esac
        seen="$seen$item,"
        case "$rest" in *,*) rest=${rest#*,} ;; *) return 0 ;; esac
    done
}

# What check arm <arm> accepts, in _CS_CONFIG_WHY.
_cs_config_why() {  # arm, choices
    case "$1" in
        flag) _CS_CONFIG_WHY="1 (on) or 0 (off)" ;;
        enum) _cs_config_or_list "$2" ;;
        num) _CS_CONFIG_WHY="a whole number of 1 to 3 digits" ;;
        ms) _CS_CONFIG_WHY="a whole number of milliseconds of 1 to 7 digits (0 skips the scan)" ;;
        secs) _CS_CONFIG_WHY="a whole number of seconds of 1 to 7 digits" ;;
        cols) _CS_CONFIG_WHY="a column count from 1 to 9999" ;;
        bytes) _CS_CONFIG_WHY="a byte count above 0 of at most 15 digits" ;;
        force) _CS_CONFIG_WHY="off, 0 or a percentage from 1 to 100" ;;
        band) _CS_CONFIG_WHY="a palette name, brand, periwinkle, session, none or r;g;b" ;;
        rgb) _CS_CONFIG_WHY="r;g;b, each 0 to 255" ;;
        segments) _CS_CONFIG_WHY="a comma-separated list of logo, session, notes, mail, pane, git, model, ctx, limits, fable and cost, each at most once" ;;
        model) _CS_CONFIG_WHY="a model name of letters, digits and . _ : / -, starting with a letter or digit, at most 128 characters" ;;
        *)
            _CS_CONFIG_WHY="a value of check arm '$1', which cs does not have"
            echo "cs: _cs_config_check has no arm named '$1'" >&2
            ;;
    esac
}

# Whether <value> is one an allowed <key> takes; what it takes in
# _CS_CONFIG_WHY. The key must be in the allow-list: an unknown one is a
# caller's bug, said on stderr, status 2.
cs_config_valid() {  # key, value
    _cs_config_index
    if ! _cs_config_record "$1"; then
        echo "cs: cs_config_valid: $1 is not in the allow-list" >&2
        return 2
    fi
    _cs_config_check "$_CS_CFG_ARM" "$_CS_CFG_CHOICES" "$2"
}

# Whether <key> is one a file never sets; the reason in _CS_CONFIG_WHY.
_cs_config_excluded() {  # key
    local rec
    for rec in "${_CS_CONFIG_EXCLUDED[@]}"; do
        if [ "${rec%%|*}" = "$1" ]; then
            _CS_CONFIG_WHY=${rec#*|}
            return 0
        fi
    done
    return 1
}

# One skipped line, appended to _CS_CONFIG_IGNORED as
# "<scope>\t<line no>\t<line>\t<why>\n", its control characters shown as ?.
_cs_config_skip() {  # scope, line no, line, why
    _CS_CONFIG_IGNORED+="$1"$'\t'"$2"$'\t'"${3//[[:cntrl:]]/?}"$'\t'"$4"$'\n'
}

# Reads one settings file, scope M (this machine's) or S (the session's),
# line by line with read -r: never sourced, nothing expanded. A good line
# sets _CS_CFG_<scope>_<KEY> and names the key in _CS_CFG_READ_<scope>
# (" KEY KEY "); any other is skipped and named in _CS_CONFIG_IGNORED. A
# value its key refuses is also kept in _CS_CFG_<scope>BAD_<KEY> as
# "line <n>: <line>: <why>", the key named in _CS_CFG_BAD_<scope>, the value
# that would otherwise apply, until a later good line of the key in the same
# file replaces it. A per-key variable counts only while its list names the
# key, so one the environment carried in is never read as a file's. A missing file, a
# directory at the path or an unreadable file reads as empty, status 0, so a
# reader under set -e goes on with the environment alone. The loop body is
# written out rather than called per line: the status line reads every line
# on every repaint.
_cs_config_read() {  # file, scope
    local line n=0 key value list
    [ -f "$1" ] && [ -r "$1" ] || return 0
    {
        while IFS= read -r line || [ -n "$line" ]; do
            n=$((n + 1))
            case "$line" in *[![:space:]]*) ;; *) continue ;; esac
            case "$line" in
                '#'*) continue ;;
                *=*) key=${line%%=*}; value=${line#*=} ;;
                *) _cs_config_skip "$2" "$n" "$line" "not KEY=value"; continue ;;
            esac
            case "$key" in
                ''|[!A-Za-z_]*|*[!A-Za-z0-9_]*) _cs_config_skip "$2" "$n" "$line" "not KEY=value"; continue ;;
            esac
            list="_CS_CFG_R_$key"
            list=${!list-}
            if [ -z "$list" ]; then
                if _cs_config_excluded "$key"; then
                    # One such key is a secret: the listing and doctor name
                    # the key, never the value.
                    _cs_config_skip "$2" "$n" "$key=(hidden)" "not kept in cs's config"
                else
                    _cs_config_skip "$2" "$n" "$line" "not a cs setting"
                fi
                continue
            fi
            if ! _cs_config_check "${list%%|*}" "${list#*|}" "$value"; then
                _cs_config_skip "$2" "$n" "$line" "not $_CS_CONFIG_WHY"
                printf -v "_CS_CFG_${2}BAD_$key" '%s' "line $n: ${line//[[:cntrl:]]/?}: not $_CS_CONFIG_WHY"
                list="_CS_CFG_BAD_$2"
                case "${!list}" in *" $key "*) ;; *) printf -v "$list" '%s' "${!list}$key " ;; esac
                continue
            fi
            printf -v "_CS_CFG_${2}_$key" '%s' "$value"
            list="_CS_CFG_READ_$2"
            case "${!list}" in
                *" $key "*) ;;
                *)
                    printf -v "$list" '%s' "${!list}$key "
                    if [ "$2" = M ]; then
                        _CS_CONFIG_COUNT_M=$((_CS_CONFIG_COUNT_M + 1))
                    else
                        _CS_CONFIG_COUNT_S=$((_CS_CONFIG_COUNT_S + 1))
                    fi
                    ;;
            esac
            list="_CS_CFG_BAD_$2"
            if [ "${!list}" != " " ]; then
                value=${!list}
                printf -v "$list" '%s' "${value/ $key / }"
            fi
        done < "$1"
    } 2>/dev/null || true
    return 0
}

# Where <key>'s value comes from, in _CS_CFG_SOURCE: shell (the environment
# pins it), launch (the launch measured it: CS_TERM_THEME beside
# CS_TERM_THEME_AUTO, and CS_TERM_BG_RGB under that marker without
# CS_TERM_BG_RGB_PINNED, the rule the status line's _sl_bg_pinned states),
# session, machine or default. A key the loader has not looked at in this
# process holds what the process started with, so its value answers.
cs_config_source() {  # key
    local src="_CS_CFG_SRC_$1"
    case "${_CS_CFG_SEEN-}" in
        *" $1 "*) _CS_CFG_SOURCE=${!src}; return 0 ;;
    esac
    if [ -z "${!1-}" ]; then
        _CS_CFG_SOURCE=default
    elif [ -z "${CS_TERM_THEME_AUTO:-}" ]; then
        _CS_CFG_SOURCE=shell
    else
        case "$1" in
            CS_TERM_THEME) _CS_CFG_SOURCE=launch ;;
            CS_TERM_BG_RGB) if [ -n "${CS_TERM_BG_RGB_PINNED:-}" ]; then _CS_CFG_SOURCE=shell; else _CS_CFG_SOURCE=launch; fi ;;
            *) _CS_CFG_SOURCE=shell ;;
        esac
    fi
}

# Decides, once a process, where <key>'s value comes from (cs_config_source),
# in _CS_CFG_SRC_<KEY>, and lists the key in _CS_CFG_SEEN.
_cs_config_see() {  # key
    case "${_CS_CFG_SEEN-}" in *" $1 "*) return 0 ;; esac
    cs_config_source "$1"
    printf -v "_CS_CFG_SRC_$1" '%s' "$_CS_CFG_SOURCE"
    _CS_CFG_SEEN="${_CS_CFG_SEEN-}$1 "
}

# Fills each allowed key the environment does not pin from the session's file
# (<session_dir>/.cs/local/config), else this machine's
# (${XDG_CONFIG_HOME:-$HOME/.config}/cs/config), in this shell only: every
# fill is unexported, so a child reads the files itself and an edit reaches
# the next repaint and the next hook, and nothing a launch hands claude can
# pose as a pin. A flag's 0 fills as unset, so readers testing = "1" and
# readers testing -n both see off. A key no file sets is unset only when an
# earlier call filled it; a value the environment supplied is never touched.
#
# Whether the environment pins a key is decided the first time a file names
# it in this process, before its first fill, so the value it has then is the
# one the process started with (_CS_CFG_SEEN lists the keys decided, and
# _CS_CFG_SRC_<KEY> says where each value came from). Keyed on $$, which a
# subshell shares and a child does not: a copy sourced again in the same
# process keeps those answers, and a child takes its own. Only the keys a file
# names, or an earlier call filled, are walked: a status line repaint with a
# short file pays for its lines, not for the table. Skipped lines:
# _CS_CONFIG_IGNORED.
cs_config_load() {  # [session_dir]
    local rec key arm src have from cand
    # No XDG_CONFIG_HOME and no HOME (a hook Claude Code runs with a bare
    # environment) names no machine file at all, rather than /.config.
    _CS_CONFIG_MACHINE=""
    if [ -n "${XDG_CONFIG_HOME:-}" ]; then
        _CS_CONFIG_MACHINE="$XDG_CONFIG_HOME/cs/config"
    elif [ -n "${HOME:-}" ]; then
        _CS_CONFIG_MACHINE="$HOME/.config/cs/config"
    fi
    _CS_CONFIG_SESSION=""
    [ -z "${1:-}" ] || _CS_CONFIG_SESSION="$1/.cs/local/config"
    _CS_CONFIG_IGNORED=""
    _CS_CONFIG_COUNT_M=0
    _CS_CONFIG_COUNT_S=0
    _CS_CFG_READ_M=" "
    _CS_CFG_READ_S=" "
    _CS_CFG_BAD_M=" "
    _CS_CFG_BAD_S=" "
    if [ "${_CS_CFG_PID:-}" != "$$" ]; then
        _CS_CFG_PID=$$
        _CS_CFG_SEEN=" "
        _CS_CFG_FILLED=""
        _CS_CFG_MEASURED_THEME=""
        _CS_CFG_BG_PINNED_BY_FILE=""
    fi
    # No file to read and nothing an earlier call filled: the environment
    # stands as it is, at the cost of two tests, every reader's lot on a
    # machine with no settings file.
    if [ -z "${_CS_CFG_FILLED-}" ] && { [ -z "$_CS_CONFIG_MACHINE" ] || [ ! -f "$_CS_CONFIG_MACHINE" ]; } \
        && { [ -z "$_CS_CONFIG_SESSION" ] || [ ! -f "$_CS_CONFIG_SESSION" ]; }; then
        return 0
    fi
    _cs_config_index
    # The theme and the background are judged together, before any fill: a
    # theme from a file drops the marker that makes the background a
    # measurement rather than a pin. The theme the launch measured is kept
    # across calls: a fill replaces the value, and the background's fate
    # below compares against it.
    _cs_config_see CS_TERM_THEME
    _cs_config_see CS_TERM_BG_RGB
    if [ "$_CS_CFG_SRC_CS_TERM_THEME" = launch ]; then
        _CS_CFG_MEASURED_THEME=$CS_TERM_THEME
    fi
    [ -z "$_CS_CONFIG_MACHINE" ] || _cs_config_read "$_CS_CONFIG_MACHINE" M
    [ -z "$_CS_CONFIG_SESSION" ] || _cs_config_read "$_CS_CONFIG_SESSION" S
    cand="$_CS_CFG_READ_S$_CS_CFG_READ_M${_CS_CFG_SEEN-}"
    for rec in "${_CS_CONFIG_SPEC[@]}"; do
        key=${rec%%|*}
        case "$cand" in *" $key "*) ;; *) continue ;; esac
        src="_CS_CFG_SRC_$key"
        _cs_config_see "$key"
        [ "${!src}" != shell ] || continue
        if case "$_CS_CFG_READ_S" in *" $key "*) true ;; *) false ;; esac; then
            have="_CS_CFG_S_$key"
            from=session
        elif case "$_CS_CFG_READ_M" in *" $key "*) true ;; *) false ;; esac; then
            have="_CS_CFG_M_$key"
            from=machine
        else
            case "${!src}" in
                session|machine)
                    unset "$key"
                    printf -v "$src" '%s' default
                    ;;
            esac
            continue
        fi
        arm=${rec#*|*|*|*|}
        if [ "${arm%%|*}" = flag ] && [ "${!have}" = 0 ]; then
            unset "$key"
        else
            printf -v "$key" '%s' "${!have}"
            # shellcheck disable=SC2163  # the variable named by $key, unexported
            export -n "$key"
        fi
        printf -v "$src" '%s' "$from"
        _CS_CFG_FILLED=1
    done
    # A theme from a file that is not the measured one is a pin: the marker
    # that called the variable a measurement goes, and so does the measured
    # background when no file sets one, as the status line would otherwise
    # tint toward a background of the other theme. A file theme equal to the
    # measured one leaves the measurement whole, the theme exported under its
    # marker (put back when an earlier load for another file dropped it), so
    # a child of this process reads the three as the launch's and not as a
    # pin nobody exported. A background from a file is a pin too, which
    # CS_TERM_BG_RGB_PINNED says.
    case "$_CS_CFG_SRC_CS_TERM_THEME" in
        session|machine)
            if [ "${CS_TERM_THEME:-}" != "${_CS_CFG_MEASURED_THEME-}" ]; then
                unset CS_TERM_THEME_AUTO
                if [ "$_CS_CFG_SRC_CS_TERM_BG_RGB" = launch ]; then
                    unset CS_TERM_BG_RGB
                    _CS_CFG_SRC_CS_TERM_BG_RGB=default
                fi
            else
                export CS_TERM_THEME
                CS_TERM_THEME_AUTO=1
                export CS_TERM_THEME_AUTO
            fi
            ;;
    esac
    case "$_CS_CFG_SRC_CS_TERM_BG_RGB" in
        session|machine)
            CS_TERM_BG_RGB_PINNED=1
            export -n CS_TERM_BG_RGB_PINNED
            _CS_CFG_BG_PINNED_BY_FILE=1
            ;;
        *)
            if [ -n "${_CS_CFG_BG_PINNED_BY_FILE-}" ]; then
                unset CS_TERM_BG_RGB_PINNED
                _CS_CFG_BG_PINNED_BY_FILE=""
            fi
            ;;
    esac
    return 0
}

# At source time, so bin/cs's own top-level reads (CS_NERD_FONTS while it
# loads), every hook that sources a delivery and the status line see the
# files before their first read.
cs_config_load "${CLAUDE_SESSION_DIR:-}"
# <<< lib/03-config.sh

SESSIONS_ROOT="${CS_SESSIONS_ROOT:-$HOME/.claude-sessions}"

# The shared-clock memo (see _sl_now) starts empty: neither the value nor its
# ready flag may be seeded by an inherited environment variable of the same
# name, or a stale/garbage _NOW would poison the limits stamp. Once, here,
# before the theme ladder below
# first reads the clock, and nowhere later: a bash without a builtin clock
# (3.2) forks date to fill the memo, and a second reset would fork it again.
_NOW=""
_SL_NOW_READY=""
# The ancestry walker's ps deadline is set only by the detached walker this
# script spawns (see _sl_defer_tmux_verdict); a value of the same name in the
# environment is never read.
_SL_WALK_DEADLINE=""

# This file re-invokes itself for the out-of-band usage refresh, so it needs its
# own path — resolved at load, since $0 is the sourcing shell under the library
# mode the test suite uses.
_SL_SELF="${BASH_SOURCE[0]}"

# Read-only status query; never take the index lock from a render.
export GIT_OPTIONAL_LOCKS=0

# Current epoch for this render, read at most once. Honors CS_STATUSLINE_NOW
# (test/pin), then the fork-free printf builtin, then a date fork (macOS bash
# 3.2 lacks %(...)T). Memoized so the stamps, the countdown, and the cache
# ages share one clock instead of each forking date.
# The memo gate is a dedicated flag, not the value: even when every clock source
# fails and _NOW ends empty, the flag records that this render already tried, so
# a later caller does not re-fork date. main() zeroes both _NOW and the flag at
# render start, so an inherited value can never seed the memo. Always overwrites
# _NOW in-process and validates it numeric; leaves it empty when every source
# fails, so callers apply their own fallback.
_sl_now() {
    [ -n "${_SL_NOW_READY:-}" ] && return 0
    _SL_NOW_READY=1
    if [ -n "${CS_STATUSLINE_NOW:-}" ]; then
        _NOW="$CS_STATUSLINE_NOW"
    else
        printf -v _NOW '%(%s)T' -1 2>/dev/null
        [[ "${_NOW:-}" =~ ^[0-9]+$ ]] || _NOW=$(date +%s 2>/dev/null)
    fi
    # Normalize to canonical base-10: a leading-zero value (e.g. a pin of 08) is
    # read as octal by bash arithmetic and aborts on an 8/9 digit. 10# forces
    # base-10 so the countdown, stamps, and cache ages all get a safe integer.
    # Fifteen digits at most, for the reason the Retry-After branch gives: a
    # longer value wraps past 64 bits and every clock reading built on it is
    # wrong. An unusable stamp is no stamp.
    if [[ "${_NOW:-}" =~ ^[0-9]{1,15}$ ]]; then _NOW=$((10#$_NOW)); else _NOW=""; fi
}

# --- render caches ----------------------------------------------------------
#
# What a render forks, it forks once per interval, not once per render: the
# answers live under ~/.cache/cs/<kind>/<key>, two lines each. The first is
# `epoch<TAB>identity`, the identity being the raw value the key was made from
# (a workspace path, a config path, `<parent pid>,<TMUX>`), so two values that
# sanitise to one key can never answer for each other; the second is the text.
# Written by a builtin printf, so a torn read, a missing file or a foreign
# identity is a miss and never a wrong answer. Ages are arithmetic against the
# render's one clock, never a stat or find.

# The file-name key for identity $1, in _CACHE_KEY; empty when it cannot be
# keyed. Slashes become dashes, anything else outside a safe set an underscore,
# and the tail of a long value is kept (NAME_MAX is 255).
_cache_key() {
    local key="${1//\//-}"
    key="${key//[^A-Za-z0-9._,-]/_}"
    [ "${#key}" -gt 200 ] && key="${key: -200}"
    case "$key" in ''|.|..) key="" ;; esac
    _CACHE_KEY="$key"
}

# Read kind $1's entry for identity $2, no older than $3 seconds: 0 with the
# text in _CACHE_TEXT, 1 on any miss.
_cache_read() {
    _CACHE_TEXT=""
    _cache_key "$2"; [ -n "$_CACHE_KEY" ] || return 1
    local f="$HOME/.cache/cs/$1/$_CACHE_KEY" head="" text="" when
    [ -f "$f" ] || return 1
    # Both lines must be complete (each read succeeds only at a newline): a
    # write caught halfway is a miss, not an empty or partial answer.
    { IFS= read -r head && IFS= read -r text; } < "$f" || return 1
    [ "${head#*$'\t'}" = "$2" ] || return 1
    when="${head%%$'\t'*}"
    [[ "$when" =~ ^[0-9]+$ ]] || return 1
    _sl_now
    [[ "${_NOW:-}" =~ ^[0-9]+$ ]] || return 1
    [ $(( _NOW - when )) -le "$3" ] || return 1
    _CACHE_TEXT="$text"
}

# Write kind $1's entry for identity $2 with text $3, stamped now. Best effort.
_cache_write() {
    _cache_key "$2"; [ -n "$_CACHE_KEY" ] || return 0
    _sl_now
    [[ "${_NOW:-}" =~ ^[0-9]+$ ]] || return 0
    local d="$HOME/.cache/cs/$1"
    [ -d "$d" ] || mkdir -p "$d" 2>/dev/null || return 0
    { printf '%s\t%s\n%s\n' "$_NOW" "$2" "$3" > "$d/$_CACHE_KEY"; } 2>/dev/null || true
}

# Drop kind $1's entry for identity $2, so the next read is a miss. Best
# effort, and it forks: no render path calls it.
_cache_forget() {
    _cache_key "$2"; [ -n "$_CACHE_KEY" ] || return 0
    rm -f "$HOME/.cache/cs/$1/$_CACHE_KEY" 2>/dev/null || true
}

# The process the per-conversation caches are keyed on. Claude Code is the
# render's parent and the same for every render of a conversation, so PPID is
# the key. A program Claude Code runs in this script's place (a status-line
# bridge that then runs this script, a new process each tick) names the pid it
# is itself the child of in CS_STATUSLINE_PARENT; that program sets it per run,
# and a launch never exports it, so it cannot make an impostor a member.
_sl_parent_pid() {
    _PARENT="$PPID"
    case "${CS_STATUSLINE_PARENT:-}" in
        ''|*[!0-9]*) ;;
        *) _PARENT="$CS_STATUSLINE_PARENT" ;;
    esac
}

# This render's own terminal device, in _OWN_TTY, empty when it has none.
# `tty` names the terminal on stdin, and Claude Code runs the render with the
# JSON payload piped to stdin, so under Claude Code the answer is always empty
# (`not a tty`) and only a render started from a shell gets a device. The
# answer is the same for every render of a conversation either way, and `tty`
# is a program, so asking it on every render costs a process per render in every
# open session: it is cached by the same parent identity the tmux caches use. An entry expires with the pid it is
# keyed on becoming plausibly reusable, not with the terminal, which is why the
# age is the tmux ancestry cache's rather than a terminal session's.
OWN_TTY_MAX_AGE=300
_sl_own_tty() {
    _OWN_TTY=""
    _sl_parent_pid
    if _cache_read tty "$_PARENT" "$OWN_TTY_MAX_AGE"; then
        _OWN_TTY="$_CACHE_TEXT"
        return 0
    fi
    _OWN_TTY=$(tty 2>/dev/null) || _OWN_TTY=""
    _cache_write tty "$_PARENT" "$_OWN_TTY"
}

# Resolve SL_THEME for this render. CS_TERM_THEME set on its own (no
# CS_TERM_THEME_AUTO marker) is an explicit user pin (see `cs -help`) and wins.
# When launch auto-detected the theme it exports CS_TERM_THEME plus the
# CS_TERM_THEME_AUTO=1 marker: that value can't follow a mid-session terminal
# theme switch (macOS auto dark mode), and re-querying the terminal here would
# corrupt claude's TUI, so the ladder below asks the terminal instead. Assigns
# SL_THEME directly rather than via `$(...)`, per this file's fork-free-hot-path
# convention.
#
# The ladder asks the terminal, never the operating system. What macOS is
# wearing says nothing about a terminal with a fixed scheme or one embedded in
# an app, and that is exactly where it was reliably wrong; a terminal that can
# answer for itself does so through the rungs below, and one that cannot is
# taken to be dark rather than guessed at from the system.

# The attached client's own reported theme, which tmux records when the terminal
# tells it (Ghostty, kitty, WezTerm and the like; most terminals report nothing,
# and then this answers nothing). Live, unlike anything captured at launch, and
# it describes the terminal rather than the OS. Talks to the tmux server over
# its socket, never the tty, so it is safe from a render.
_sl_theme_from_tmux_client() {
    _sl_tmux_client
    case "${_TMUX_CLIENT_THEME:-}" in
        dark|light) SL_THEME="$_TMUX_CLIENT_THEME"; return 0 ;;
        *) return 1 ;;
    esac
}

# Ask the tmux server, once per theme pass, what the attached client reports
# as its theme, which tty it is on, how wide this pane is, whether the client
# is in control mode and what terminal tmux learned it is: one query for the
# rungs that need them (the band layout reads the width, the iTerm rung the
# last two). Tab-separated so an empty field (most terminals report no theme)
# still leaves the ones after it in their places. The answer is kept for
# TMUX_CLIENT_CACHE_TTL under the parent pid and the TMUX claim, so renders
# while Claude works ask tmux once in five seconds: a theme toggle or a
# re-attach from another terminal shows at the next render after that,
# within a minute while idle. Sets _TMUX_CLIENT_THEME, _TMUX_CLIENT_TTY,
# _TMUX_CLIENT_WIDTH, _TMUX_CLIENT_CONTROL and _TMUX_CLIENT_TERMTYPE; all empty
# when tmux cannot answer. The bucket is tmux-client3 because its entries hold
# five fields: an entry of the tmux-client or tmux-client2 bucket, with two or
# three, can never be read as one.
TMUX_CLIENT_CACHE_TTL=5
_TMUX_CLIENT_ASKED=""; _TMUX_CLIENT_THEME=""; _TMUX_CLIENT_TTY=""; _TMUX_CLIENT_WIDTH=""
_TMUX_CLIENT_CONTROL=""; _TMUX_CLIENT_TERMTYPE=""
_sl_tmux_client() {
    [ -z "$_TMUX_CLIENT_ASKED" ] || return 0
    _TMUX_CLIENT_ASKED=1
    _TMUX_CLIENT_THEME=""; _TMUX_CLIENT_TTY=""; _TMUX_CLIENT_WIDTH=""
    _TMUX_CLIENT_CONTROL=""; _TMUX_CLIENT_TERMTYPE=""
    local out rest t=$'\t'
    local fmt="#{client_theme}$t#{client_tty}$t#{pane_width}$t#{client_control_mode}$t#{client_termtype}"
    _sl_parent_pid
    if _cache_read tmux-client3 "$_PARENT,${TMUX:-}" "$TMUX_CLIENT_CACHE_TTL"; then
        out="$_CACHE_TEXT"
    else
        if [ -n "${TMUX_PANE:-}" ]; then
            out=$(tmux display-message -p -t "$TMUX_PANE" "$fmt" 2>/dev/null) || return 0
        else
            out=$(tmux display-message -p "$fmt" 2>/dev/null) || return 0
        fi
        case "$out" in *"$t"*) _cache_write tmux-client3 "$_PARENT,${TMUX:-}" "$out" ;; esac
    fi
    case "$out" in *"$t"*) ;; *) return 0 ;; esac
    _TMUX_CLIENT_THEME="${out%%"$t"*}"; rest="${out#*"$t"}"
    _TMUX_CLIENT_TTY="${rest%%"$t"*}"
    case "$rest" in *"$t"*) rest="${rest#*"$t"}" ;; *) return 0 ;; esac
    _TMUX_CLIENT_WIDTH="${rest%%"$t"*}"
    case "$rest" in *"$t"*) rest="${rest#*"$t"}" ;; *) return 0 ;; esac
    _TMUX_CLIENT_CONTROL="${rest%%"$t"*}"
    case "$rest" in *"$t"*) _TMUX_CLIENT_TERMTYPE="${rest#*"$t"}" ;; esac
}

# The theme and background of the iTerm2 profile this pane was opened with,
# read from iTerm's preferences. iTerm reports no theme to tmux, and the theme
# cs measured at launch goes stale when macOS flips between light and dark
# mode. A profile with separate light and dark colours follows the macOS
# appearance (so does iTerm's own, unless its theme is pinned light or dark in
# Settings, which this cannot see); any other profile is light or dark by its
# one background. Inside tmux, ITERM_PROFILE and LC_TERMINAL are what the pane
# was started with, and the client attached now may be another terminal, so the
# profile answers only while that client is iTerm2: in control mode (iTerm's
# tmux integration) or of a terminal type tmux reports as iTerm2. Sets SL_THEME
# and _SL_LIVE_BG; 1 when this is not a local iTerm pane, CS_NO_ITERM2 is set,
# or the profile cannot be read. The profile is read at most once in
# ITERM_PROFILE_CACHE_TTL, a miss included, and the appearance once in
# MACOS_APPEARANCE_CACHE_TTL.
ITERM_PREFS="$HOME/Library/Preferences/com.googlecode.iterm2.plist"
ITERM_PROFILE_CACHE_TTL=60
MACOS_APPEARANCE_CACHE_TTL=5
_SL_LIVE_BG=""
_sl_theme_from_iterm() {
    [ -n "${ITERM_PROFILE:-}" ] && [ -z "${SSH_CONNECTION:-}" ] && [ -z "${CS_NO_ITERM2:-}" ] || return 1
    [ "${TERM_PROGRAM:-}" = "iTerm.app" ] || [ "${LC_TERMINAL:-}" = "iTerm2" ] || return 1
    if [ -n "${TMUX:-}" ]; then
        _sl_tmux_client
        [ "$_TMUX_CLIENT_CONTROL" = "1" ] || [[ "$_TMUX_CLIENT_TERMTYPE" == iTerm2* ]] || return 1
    fi
    # _parse_rgb_triplet is defined further down than this runs.
    local colours dark light bg rgb='^([0-9]+);([0-9]+);([0-9]+)$'
    if _cache_read iterm-profile "$ITERM_PROFILE" "$ITERM_PROFILE_CACHE_TTL"; then
        colours="$_CACHE_TEXT"
    else
        _sl_iterm_profile_colours
        colours="$_ITERM_COLOURS"
        _cache_write iterm-profile "$ITERM_PROFILE" "$colours"
    fi
    case "$colours" in
        separate\ *\ *)
            dark="${colours#separate }"; light="${dark#* }"; dark="${dark%% *}"
            _sl_macos_appearance
            if [ "$_MACOS_APPEARANCE" = "dark" ]; then bg="$dark"; else bg="$light"; fi
            [[ "$bg" =~ $rgb ]] || return 1
            SL_THEME="$_MACOS_APPEARANCE" ;;
        single\ *)
            bg="${colours#single }"
            [[ "$bg" =~ $rgb ]] || return 1
            # The launch's BT.709 line (lib/70-statusline.sh) and _luminance's,
            # so a mid tone reads as the theme the launch measured.
            if [ $(( 2126 * BASH_REMATCH[1] + 7152 * BASH_REMATCH[2] + 722 * BASH_REMATCH[3] )) -lt 1275000 ]; then
                SL_THEME="dark"
            else
                SL_THEME="light"
            fi ;;
        *) return 1 ;;
    esac
    _SL_LIVE_BG="$bg"
}

# The background colours of the profile named ITERM_PROFILE, in _ITERM_COLOURS:
# `separate <dark r;g;b> <light r;g;b>`, `single <r;g;b>`, or `none` when the
# preferences, the profile or its colours cannot be read. Each value is printed
# on its own line and a missing one prints nothing, so the components count as
# read only when all of them are there. PlistBuddy prints nothing at all for a
# call of 15 or more commands, so the names are read 8 at a time, until a batch
# comes back short: the end of the profiles. A profile with no name shortens
# its batch the same way, so the name is read back at the index found, and a
# mismatch is a profile that cannot be read.
_sl_iterm_profile_colours() {
    _ITERM_COLOURS="none"
    local pb=/usr/libexec/PlistBuddy i start idx="" name names out sep key rgbs args=() sets=()
    [ -x "$pb" ] && [ -f "$ITERM_PREFS" ] || return 0
    for ((start = 0; ; start += 8)); do
        args=()
        for ((i = start; i < start + 8; i++)); do args+=(-c "Print ':New Bookmarks:$i:Name'"); done
        names=$("$pb" "${args[@]}" "$ITERM_PREFS" 2>/dev/null)
        [ -n "$names" ] || return 0
        i=$start
        while IFS= read -r name; do
            [ "$name" = "$ITERM_PROFILE" ] && { idx=$i; break 2; }
            i=$((i + 1))
        done <<< "$names"
        [ "$i" -eq $((start + 8)) ] || return 0
    done
    out=$("$pb" -c "Print ':New Bookmarks:$idx:Name'" \
        -c "Print ':New Bookmarks:$idx:Use Separate Colors for Light and Dark Mode'" "$ITERM_PREFS" 2>/dev/null)
    [ "${out%%$'\n'*}" = "$ITERM_PROFILE" ] || return 0
    sep=""
    case "$out" in *$'\n'*) sep="${out#*$'\n'}" ;; esac
    if [ "$sep" = "true" ]; then
        sets=("Background Color (Dark)" "Background Color (Light)")
    else
        sets=("Background Color")
    fi
    args=()
    for key in "${sets[@]}"; do
        args+=(-c "Print ':New Bookmarks:$idx:$key:Red Component'"
               -c "Print ':New Bookmarks:$idx:$key:Green Component'"
               -c "Print ':New Bookmarks:$idx:$key:Blue Component'")
    done
    rgbs=$("$pb" "${args[@]}" "$ITERM_PREFS" 2>/dev/null | awk -v want=$((3 * ${#sets[@]})) '
        $0 !~ /^-?[0-9]*\.?[0-9]+$/ { bad = 1 }
        { v[NR] = int($0 * 255 + 0.5); if (v[NR] > 255) v[NR] = 255; if (v[NR] < 0) v[NR] = 0 }
        END {
            if (bad || NR != want) exit
            for (i = 1; i <= NR; i += 3) printf "%s%d;%d;%d", (i > 1 ? " " : ""), v[i], v[i + 1], v[i + 2]
        }')
    [ -n "$rgbs" ] || return 0
    if [ "$sep" = "true" ]; then _ITERM_COLOURS="separate $rgbs"; else _ITERM_COLOURS="single $rgbs"; fi
}

# The macOS appearance in _MACOS_APPEARANCE, dark or light: AppleInterfaceStyle
# reads Dark in dark mode and is absent in light mode.
_sl_macos_appearance() {
    if _cache_read macos-appearance global "$MACOS_APPEARANCE_CACHE_TTL"; then
        case "$_CACHE_TEXT" in dark|light) _MACOS_APPEARANCE="$_CACHE_TEXT"; return 0 ;; esac
    fi
    _MACOS_APPEARANCE="light"
    [ "$(defaults read -g AppleInterfaceStyle 2>/dev/null)" = "Dark" ] && _MACOS_APPEARANCE="dark"
    _cache_write macos-appearance global "$_MACOS_APPEARANCE"
}

# COLORFGBG, outside tmux only. Inside it is the tmux server's start-time
# snapshot and goes stale across theme changes — 15;0 has been observed there
# under a light terminal — which is why the launch detector consults it in its
# non-tmux branch alone. KEEP the classification IN SYNC with
# _theme_from_colorfgbg in lib/70-statusline.sh.
_sl_theme_from_colorfgbg() {
    case "${COLORFGBG##*;}" in
        7|9|1[0-5]) SL_THEME="light"; return 0 ;;
        [0-8])      SL_THEME="dark";  return 0 ;;
        *)          return 1 ;;
    esac
}

# Whether this process is genuinely inside the tmux server $TMUX names.
#
# TMUX is ordinary environment and is inherited wholesale: a program launched
# from a tmux pane passes it to everything it spawns, including a window it
# opens in a terminal of its own. That child then claims a tmux membership it
# does not have, and every rung that keys off TMUX reads the wrong terminal —
# the client rung asks a client that is not ours, and the COLORFGBG rung is
# skipped to avoid a tmux staleness that does not apply.
#
# The second field of TMUX is the tmux SERVER pid (a daemon, reparented to 1).
# It is the one part of the claim that can be checked rather than believed: a
# process in a real pane has that server among its ancestors, an impostor does
# not. One `ps` covers the whole walk, so this costs a single fork.
#
# $1: pid to start from (defaults to this process; the parameter exists so the
# walk can be tested against a fixed table instead of the live process tree).
# Cached per parent process: the parent (Claude Code, for a render) is the same
# across every render of a conversation, and a process the parent did not spawn
# into this pane cannot inherit its verdict because the parent pid is not
# environment. Keyed on the parent pid and the TMUX claim, expiring after
# TMUX_REAL_CACHE_TTL so a recycled pid cannot inherit a stale verdict for
# long. The walk itself is two forks (ps and awk), so a hit saves both.
TMUX_REAL_CACHE_TTL=300

# How long a walk that has been spawned is assumed to still be running. A walk
# that can answer takes a fraction of a second (155-415 ms measured), so this
# only ever gates a `ps` that has stalled: without it such a walk is respawned
# on every render, per conversation, for as long as the session is
# open, and each one waits on a `ps` that never returns. Past the TTL one
# render tries again, so a child that died before clearing its mark wedges
# nothing.
TMUX_WALK_MARK_TTL=10

# How long the detached walker waits on its ps before killing it, in wall time
# (see _sl_ps_table_by_deadline). Shorter than the mark, so a stalled walker is
# gone before the render that replaces it can be spawned: at most one is ever
# alive.
TMUX_WALK_DEADLINE=5

_sl_tmux_is_real() {
    [ -n "${TMUX:-}" ] || return 1
    local srv start
    _sl_tmux_server || return 1
    srv="$_SRV"
    start=${1:-$$}
    # A caller that names a start pid is a test of the walk itself; only the
    # render's own question is cached.
    local ident=""
    if [ -z "${1:-}" ]; then _sl_parent_pid; ident="$_PARENT,$TMUX"; fi
    _sl_tmux_cached_walk "$start" "$srv" "$ident"
}

# The tmux server pid from the TMUX claim, in _SRV. Non-zero when the claim
# carries no pid to check, which is not a tmux this process can be inside.
_sl_tmux_server() {
    _SRV=${TMUX#*,}; _SRV=${_SRV%%,*}
    case "$_SRV" in ''|*[!0-9]*) return 1 ;; esac
}

# The walk with its cache around it: $1 start pid, $2 server pid, $3 the
# identity to key the verdict on, empty to answer without reading or writing
# an entry. Returns the walk's own verdict, with an unanswerable ps read as
# real (see _sl_tmux_walk) and left uncached.
_sl_tmux_cached_walk() {
    local ident="$3" verdict
    if [ -n "$ident" ] && _cache_read tmux-real "$ident" "$TMUX_REAL_CACHE_TTL"; then
        case "$_CACHE_TEXT" in
            real) return 0 ;;
            foreign) return 1 ;;
        esac
    fi
    _sl_tmux_walk "$1" "$2"
    local rc=$?
    if [ -n "$ident" ] && [ "$rc" -ne 2 ]; then
        verdict=foreign; [ "$rc" -eq 0 ] && verdict=real
        _cache_write tmux-real "$ident" "$verdict"
    fi
    [ "$rc" -eq 2 ] && rc=0
    return "$rc"
}

# The walk itself: 0 when the tmux server pid $2 is an ancestor of $1, 1 when
# it is not, 2 when ps could not answer (treated as real by the caller, and
# never cached, because a tool failure is not evidence of the negative).
_sl_tmux_walk() {  # start-pid server-pid
    local start="$1" srv="$2"
    # The loop is capped: a ppid table can be cyclic if a pid is reused between
    # the read and the walk, and an uncapped walk would spin forever.
    # Capture first: under `set -o pipefail` a failing ps would decide the
    # pipeline's status whatever awk concluded. An empty table means ps is
    # missing or restricted, not that the server is absent — return 2 there,
    # because a tool failure is not evidence of the negative, and scoring it as
    # one makes a genuine pane render dark and lose its pane id.
    # The deadline is read only as a whole number of seconds: it reaches shell
    # arithmetic, which would run a command substitution held in any other
    # text. Anything else walks without a deadline.
    local table
    case "${_SL_WALK_DEADLINE:-}" in
        ''|0*|*[!0-9]*)
            table=$(ps -ax -o pid=,ppid= 2>/dev/null) || table="" ;;
        *)
            _sl_ps_table_by_deadline "$_SL_WALK_DEADLINE"; table="$_PS_TABLE" ;;
    esac
    [ -n "$table" ] || return 2
    printf '%s\n' "$table" | awk -v p="$start" -v s="$srv" '
        { pp[$1] = $2 }
        END {
            for (n = 0; n < 24; n++) {
                if (p == s) exit 0
                if (!(p in pp)) exit 1
                p = pp[p]
                if (p <= 1) exit 1
            }
            exit 1
        }'
}

# The ps table in _PS_TABLE, empty when ps has not answered within $1 seconds.
# A ps that stalls is killed by the pid recorded at its start, so the walker
# that ran it ends too: nothing outlives the deadline.
#
# The deadline is one sleep of $1 seconds in a watchdog, never a count of short
# sleeps: on a loaded machine each sleep costs its fork on top of what it asks
# for, and one sleep runs long by one fork. The watchdog kills ps when its
# sleep ends, however that sleep ends, so a sleep that cannot run fails
# closed; it kills only a ps still alive, since the parent may have reaped it
# in the moment before the watchdog's own TERM lands. A ps that answers first
# ends the wait at once, and the watchdog and its sleep are stopped. Three forks a walk (ps, the watchdog, its sleep), which is why only
# the detached walker takes this path.
_sl_ps_table_by_deadline() {
    _PS_TABLE=""
    local out="$HOME/.cache/cs/tmux-walking/.ps.$$.$RANDOM" pid dog
    ps -ax -o pid=,ppid= > "$out" 2>/dev/null &
    pid=$!
    # The sleep runs in the background and the watchdog waits on it, because
    # a trap waits for a foreground child to finish before it runs. A TERM
    # this process inherited as ignored (SIG_IGN across an exec) cannot be
    # trapped, and then an answered walk waits out the deadline; cs's launch
    # path does not ignore TERM.
    ( trap 'kill "${s:-}" 2>/dev/null; exit 0' TERM
      sleep "$1" & s=$!
      wait "$s"
      kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null ) >/dev/null 2>&1 &
    dog=$!
    if wait "$pid" 2>/dev/null; then
        _PS_TABLE=$(< "$out")
    fi
    kill "$dog" 2>/dev/null
    wait "$dog" 2>/dev/null
    rm -f "$out" 2>/dev/null || true
}

# Whether the environment describes a terminal this process is not in. Settled
# once per render, before anything reads it: an explicit CS_TERM_THEME pin
# short-circuits theme detection, but the pane id still needs to know, and
# "am I in this tmux" is a fact about the environment rather than the palette.
_sl_mark_foreign_env() {
    SL_ENV_FOREIGN=""
    [ -n "${TMUX:-}" ] || return 0
    [ -n "${_SL_DEFER_TMUX_REAL:-}" ] && _sl_defer_tmux_verdict && return 0
    _sl_tmux_is_real || SL_ENV_FOREIGN=1
}

# The ancestry verdict, kept off a conversation's first render.
#
# It is the one cost a render pays exactly once: it appears in a conversation's
# first render and in none after, and the first render is the one Claude Code
# kills for running too long. So on a miss this render answers real — what
# every pane cs launches is — and a detached child does the walk and leaves the
# verdict where the next render reads it. A foreign environment draws
# its own terminal's palette for one render and is corrected on the next; a
# real one never sees a wrong palette at all.
#
# The child walks from the PARENT, not from this render. The subshell orphans
# it, this render exits at once, and a pid that has gone has no ancestors to
# walk. The parent is the conversation, alive for as long as an entry keyed on
# it can be read, and its chain to the server is this render's chain without
# the first hop — the same verdict, from a pid that stays.
#
# Returns 0 when SL_ENV_FOREIGN is settled, 1 when the caller must walk here.
_sl_defer_tmux_verdict() {
    _sl_tmux_server || return 1
    _sl_parent_pid
    local ident="$_PARENT,$TMUX"
    if _cache_read tmux-real "$ident" "$TMUX_REAL_CACHE_TTL"; then
        case "$_CACHE_TEXT" in
            real)    return 0 ;;
            foreign) SL_ENV_FOREIGN=1; return 0 ;;
        esac
    fi
    # One walk in flight at a time. The mark is written before the spawn and
    # cleared by the child, so a render on the common path pays one file write
    # on a miss and nothing at all on a hit, and no fork either way.
    _cache_read tmux-walking "$ident" "$TMUX_WALK_MARK_TTL" && return 0
    _cache_write tmux-walking "$ident" "walking"
    # Detached, and with descriptors of its own: an inherited stdout holds the
    # render's output open, and Claude Code would wait on the walk after all.
    # A ps that answers with a failure leaves no verdict but does clear the
    # mark, so the next render walks again — the cost of the walk it replaced,
    # not a new one.
    local deadline="$TMUX_WALK_DEADLINE"
    case "${CS_STATUSLINE_WALK_DEADLINE:-}" in
        ''|*[!0-9]*|0*) ;;
        *) [ "$CS_STATUSLINE_WALK_DEADLINE" -lt "$TMUX_WALK_MARK_TTL" ] \
               && deadline="$CS_STATUSLINE_WALK_DEADLINE" ;;
    esac
    ( { _SL_WALK_DEADLINE="$deadline"
        _sl_tmux_cached_walk "$_PARENT" "$_SRV" "$ident"
        _cache_forget tmux-walking "$ident"; } >/dev/null 2>&1 & ) >/dev/null 2>&1
    return 0
}

# The terminal cs measured, found by the one identity a render can establish
# for itself: which tmux client this pane is attached to.
#
# A pane cs did not launch carries none of cs's environment — an agent-teams
# teammate is spawned straight off the tmux server and inherits TMUX but no
# CS_TERM_*, so it falls to the dark default and draws a dark bar on a light
# terminal. It can still ask tmux which client it is on, over the socket and
# never the tty, which is safe from a render. cs writes its launch measurement
# under that key, so every pane on the same client finds it.
#
# Keying on the client tty is what makes this safe where a tmux session
# variable was not (see the attach-probe revert): a session variable is shared
# by every pane whatever terminal they are on, while the tty IS the terminal's
# identity. Re-attach from a different terminal and the key differs, so the
# lookup misses and the ladder falls through. The key is not sufficient on its
# own, though — tty names are recycled — so entries also expire by age.
TERM_CACHE_MAX_AGE=43200   # twelve hours, a plausible terminal session

_sl_theme_from_client_cache() {
    local tty key line theme rgb
    # Inside tmux the terminal is the attached client; outside it, it is this
    # process's own tty — which is the key _write_term_cache already uses, so
    # refusing to look there left the answer on disk unreachable.
    if [ -n "${TMUX:-}" ]; then
        _sl_tmux_client
        tty="${_TMUX_CLIENT_TTY:-}"
    else
        _sl_own_tty
        tty="${_OWN_TTY:-}"
    fi
    [ -n "$tty" ] || return 1
    key=${tty#/dev/}; key=${key//\//-}
    # Refuse anything that is not a plain device name, so a hostile or garbled
    # client tty cannot reach outside the cache directory.
    case "$key" in ''|*[!A-Za-z0-9._-]*|.|..) return 1 ;; esac
    local entry="$HOME/.cache/cs/term/$key"
    [ -f "$entry" ] || return 1
    # tty device names are recycled by the OS: a dark terminal on ttys002
    # closes, a light one opens on the same device, and the entry becomes a
    # confidently wrong answer rather than the miss the key alone would give.
    # Age is the only signal available here, so an entry that has outlived a
    # plausible terminal session is refused rather than trusted. The entry
    # carries the epoch it was written at (third field; the writer is
    # _write_term_cache in lib/70-statusline.sh, KEEP IN SYNC), so the age
    # check is arithmetic rather than a find fork; an entry without one is
    # refused the same way.
    local written
    IFS= read -r line < "$entry" || return 1
    theme=${line%% *}
    case "$theme" in dark|light) ;; *) return 1 ;; esac
    written=${line##* }
    [[ "$written" =~ ^[0-9]+$ ]] || return 1
    _sl_now
    [[ "${_NOW:-}" =~ ^[0-9]+$ ]] || return 1
    [ $(( _NOW - written )) -le "$TERM_CACHE_MAX_AGE" ] || return 1
    rgb=${line#* }; rgb=${rgb% *}
    [ "$rgb" = "-" ] && rgb=""
    SL_THEME="$theme"
    # Only supplies what is missing: a background set by hand is the user's and
    # outranks anything cs measured earlier.
    if [ -n "$rgb" ] && [ -z "${CS_TERM_BG_RGB:-}" ]; then
        case "$rgb" in
            *[!0-9\;]*) ;;
            *) export CS_TERM_BG_RGB="$rgb" ;;
        esac
    fi
    return 0
}

_sl_detect_theme() {
    # One tmux query serves every rung of this pass; a later pass asks again.
    _TMUX_CLIENT_ASKED=""
    _SL_LIVE_BG=""
    # An explicit pin outranks every measurement, so it is read before the probe
    # file is allowed to overwrite anything.
    if [ -n "${CS_TERM_THEME:-}" ] && [ -z "${CS_TERM_THEME_AUTO:-}" ]; then
        SL_THEME="$CS_TERM_THEME"
        return 0
    fi
    # TMUX set but this process is not in that server: the environment was
    # inherited from a terminal that is not the one being drawn on, so every
    # value in it describes somewhere else. CS_TERM_THEME included — it is cs's
    # measurement of the ORIGINAL terminal, and believing it is what paints a
    # light bar on a dark window. Take dark, the answer cs gives everywhere it
    # has nothing trustworthy to go on, and mark the environment so the
    # background RGB and the pane id are not trusted either.
    if [ -n "${SL_ENV_FOREIGN:-}" ]; then
        SL_THEME="dark"
        return 0
    fi
    if [ -n "${TMUX:-}" ] && _sl_theme_from_tmux_client; then
        : # SL_THEME set from the attached client's own reported theme
    elif _sl_theme_from_iterm; then
        : # SL_THEME and the background read live from the iTerm profile
    elif [ -z "${TMUX:-}" ] && [ -n "${COLORFGBG:-}" ] && _sl_theme_from_colorfgbg; then
        : # SL_THEME set from the terminal's own statement about itself
    elif _sl_theme_from_client_cache; then
        : # the terminal cs measured, found by which tmux client this pane is on
    else
        # Whatever cs measured at launch, and dark when it measured nothing.
        #
        # The OS appearance is not consulted. It describes the system, and the
        # capsules are drawn on the terminal — unrelated for a terminal with a
        # fixed scheme or one embedded in an app, which is where it was reliably
        # wrong. It was only ever a guess that happened to be right when the
        # terminal followed the system, and the rungs above now cover the
        # terminals that can answer for themselves. Dark is the same assumption
        # the rest of cs makes with nothing to go on (lib/05-term.sh, and the
        # rewriter shim), so one unknown yields one palette.
        #
        # The cost, accepted: a light terminal that reports nothing and was not
        # launched by cs renders the dark palette. Pin CS_TERM_THEME=light there.
        SL_THEME="${CS_TERM_THEME:-dark}"
    fi
}

# Whether CS_TERM_BG_RGB is the user's own: set with no launch detection
# behind it, or set before a launch that detected the theme, which marks it with
# CS_TERM_BG_RGB_PINNED since CS_TERM_THEME_AUTO speaks for the theme alone.
_sl_bg_pinned() {
    [ -n "${CS_TERM_BG_RGB:-}" ] && { [ -z "${CS_TERM_THEME_AUTO:-}" ] || [ -n "${CS_TERM_BG_RGB_PINNED:-}" ]; }
}

# Blank CS_TERM_BG_RGB when the launch-captured background is stale: once the
# live theme (SL_THEME) has switched away from the theme cs detected at launch
# (CS_TERM_THEME, present with the auto marker), the RGB no longer matches the
# terminal, so drop it and let the gauge surface fall back to
# theme-based values instead of tinting toward the old background (which could
# leave light text on a near-light surface). An RGB the user set
# (_sl_bg_pinned) is never dropped.
_sl_invalidate_stale_bg() {
    if [ -n "${CS_TERM_BG_RGB:-}" ] && ! _sl_bg_pinned &&
       { [ -n "${SL_ENV_FOREIGN:-}" ] || [ "$SL_THEME" != "${CS_TERM_THEME:-}" ]; }; then
        CS_TERM_BG_RGB=""
    fi
}

# Only a render defers the walk; the library mode the test suite sources takes
# the verdict in hand, so the walk's own tests run it where they can see it.
_SL_DEFER_TMUX_REAL=""
[ "${CS_STATUSLINE_LIB:-}" = "1" ] || _SL_DEFER_TMUX_REAL=1

# The usage refresher paints no bar, so it settles none of this: no ancestry
# walk, no theme, no tmux client lookup. A walk here would run with no deadline
# ahead of the refresher's lock, and a ps that stalls would hold every
# refresher short of it while the renders kept launching more.
if [ "${1:-}" != "--refresh-usage" ]; then
    _sl_mark_foreign_env
    _sl_detect_theme
    _sl_invalidate_stale_bg
fi

# Parsed stdin fields (filled by _parse_stdin).
SL_SESSION=""; SL_CTX=""; SL_MODEL=""; SL_EFFORT=""
SL_5H=""; SL_5H_RESET=""; SL_WK=""; SL_WK_RESET=""; SL_COST=""; SL_DIR=""
SL_COLUMNS=""
# The session's machine-local directory (.cs/local), empty outside a cs
# session: the stamps write there and the band reads its colour from there.
SL_LOCAL_DIR=""

# Collected segments (parallel arrays) and chosen color level.
_SEG_TEXT=(); _SEG_GROUP=(); _SEG_INK=(); _SEG_BOLD=(); _SEG_JOIN=(); _SEG_ROLE=()
_GROUPS=(); _GROUPS_SEEN=""
LEVEL="basic"

# Scratch globals used in place of command substitution (keeps the per-render
# hot path fork-free; this script runs on every assistant message).
_SGR=""; _COLOR=""; _HOT_WEIGHT=""; _RGB=""
_WIDTH=""; _R=""; _G=""; _B=""; _LUM=""
# The gauge surface is a shade of the terminal background — the same for every
# gauge — so it is resolved once per render (process) and cached here.
_SURFACE_RGB=""

# Per-segment icons. Standard Unicode (Geometric Shapes + dingbats) that render
# in any monospace font — not Nerd Font private-use glyphs — so the bar looks
# right without a patched font. The session segment carries no icon.
ICON_CTX=$'\xe2\x97\x94 '       # U+25D4 quarter pie (gauge, the healthy band)
ICON_CTX_EMPTY=$'\xe2\x97\x8b ' # U+25CB empty pie (a fresh context)
ICON_CTX_HALF=$'\xe2\x97\x91 '  # U+25D1 half pie (the amber band)
ICON_CTX_3Q=$'\xe2\x97\x95 '    # U+25D5 three-quarter pie (crit)
ICON_CTX_FULL=$'\xe2\x97\x8f '  # U+25CF full pie (88 and up)
ICON_MODEL=$'\xe2\x9c\xa6 '     # U+2726 four-pointed star
ICON_GIT=$'\xe2\x8e\x87 '       # U+2387 branch
ICON_5H=$'\xe2\x97\xb7 '        # U+25F7 clock
ICON_WK=$'\xe2\x97\xb6 '        # U+25F6 lower-left quadrant (the week; ◑ is the ctx half pie)
ICON_NOTES=$'\xe2\x96\xa4 '     # U+25A4 square with horizontal fill (notes queue)
ICON_MAIL=$'\xe2\x9c\x89 '      # U+2709 envelope (unread cross-session mail)
ICON_LOGO=$'\xe2\x9c\xb3'       # U+2733 eight-spoked asterisk (Claude mark)
ICON_PANE=$'\xe2\x97\xab '      # U+25EB square with vertical bisect (tmux pane)
ICON_FABLE=$'\xe2\x9c\xa7 '     # U+2727 white four-pointed star (model-scoped limit)
ICON_LOCK=$'\xef\x80\xa3'       # U+F023 Nerd Font lock (encrypted session; needs the caps consent)

# --- stdin -----------------------------------------------------------------

# Run a command with a wall-clock cap when timeout(1) is available, else plain.
_timeout() {
    local secs="$1"; shift
    if command -v timeout >/dev/null 2>&1; then
        timeout "$secs" "$@"
    elif command -v gtimeout >/dev/null 2>&1; then
        gtimeout "$secs" "$@"
    else
        "$@"
    fi
}

# Slurp stdin into _STDIN with a builtin read so no subprocess is spawned and
# a stuck pipe cannot hang the render past one second. Handles single-line
# compact JSON (the common case) and multi-line pretty JSON alike.
_read_stdin() {
    _STDIN=""
    [ -t 0 ] && return 0
    local line=""
    while IFS= read -r -t 1 line; do
        _STDIN+="$line"$'\n'
    done
    _STDIN+="$line"   # trailing partial line (no newline) or empty
}


# Extract every field we need in one jq pass, one value per line. Returns
# non-zero (caller falls back) when jq is missing, stdin is empty, or the JSON
# does not parse. One value per line (not @tsv) because `read` collapses
# consecutive tab delimiters, which would drop empty fields and shift values.
_parse_stdin() {
    local input="$1" fields
    command -v jq >/dev/null 2>&1 || return 1
    [ -n "$input" ] || return 1
    SL_LOCAL_DIR=""
    [ -n "${CLAUDE_SESSION_NAME:-}" ] && SL_LOCAL_DIR="$SESSIONS_ROOT/$CLAUDE_SESSION_NAME/.cs/local"
    # A here-string, not a `printf |` pipe: each side of a pipeline is its own
    # process, so the pipe cost two births a render on top of jq's.
    fields=$(jq -r '
        [ (.session_id // ""),
          (.session_name // ""),
          (.context_window.used_percentage // "" | tostring),
          (.model.display_name // ""),
          (.model.id // ""),
          (.effort.level // ""),
          (.rate_limits.five_hour.used_percentage // "" | tostring),
          (.rate_limits.five_hour.resets_at // "" | tostring),
          (.rate_limits.seven_day.used_percentage // "" | tostring),
          (.rate_limits.seven_day.resets_at // "" | tostring),
          (.cost.total_cost_usd // "" | tostring),
          (.workspace.current_dir // .cwd // ""),
          (.columns // "" | tostring)
        ] | .[]' <<< "$input" 2>/dev/null) || return 1
    {
        IFS= read -r SL_SESSION_ID
        IFS= read -r SL_SESSION
        IFS= read -r SL_CTX
        # Stamp context % for the task-queue gate (the Stop hook reads this file).
        # Machine-local, per the .cs/local partition; truncated to an integer.
        # The file is also the liveness heartbeat (its mtime), so every
        # conversation touches it, but only the launched conversation named in
        # .cs/local/state writes the value: a tmux teammate shares this
        # directory and runs this same statusline with nothing in its
        # environment to tell it apart, and its reading would replace the
        # lead's for every gate that reads the file.
        #
        # The write is a fork (mv, or touch), and the bar repaints on every
        # Claude Code event and once a minute when idle, so it runs only when
        # the value changed or the last write is
        # older than STAMP_EVERY: the heartbeat readers allow 900 s, the limits
        # readers 1800 s. The sibling `.at` file holds the last write's epoch,
        # because a render cannot read an mtime without forking stat.
        #
        # Only the last level, .cs/local, is made, inside a .cs that is there:
        # a claude still running after `cs -rm <name> --force` keeps rendering,
        # and making the whole path would build the removed session again. A
        # .cs/local a hook made in between is the directory the stamp wanted.
        if [ -n "${CLAUDE_SESSION_NAME:-}" ] && [ -n "${SL_CTX:-}" ] && ! _session_files_tracked; then
            _pctdir="$SL_LOCAL_DIR"
            if [ -d "$_pctdir" ] || mkdir "$_pctdir" 2>/dev/null || [ -d "$_pctdir" ]; then
                _read_state_key "$_pctdir/state" claude_session_id
                if [ -z "$_STATE_VALUE" ] || [ "$_STATE_VALUE" = "${SL_SESSION_ID:-}" ]; then
                    _stamp_due "$_pctdir/context-pct" "${SL_CTX%%.*}"
                    if [ -n "$_STAMP_DUE" ]; then
                        printf '%s\n' "${SL_CTX%%.*}" > "$_pctdir/context-pct.tmp" 2>/dev/null \
                            && mv "$_pctdir/context-pct.tmp" "$_pctdir/context-pct" 2>/dev/null \
                            && _stamp_written "$_pctdir/context-pct"
                    fi
                else
                    # Its own cadence record: sharing the lead's would make
                    # each side see the other's value as a change.
                    _stamp_due "$_pctdir/context-pct.heartbeat" ""
                    if [ -n "$_STAMP_DUE" ]; then
                        touch "$_pctdir/context-pct" 2>/dev/null && _stamp_written "$_pctdir/context-pct.heartbeat"
                    fi
                fi
            fi
        fi
        IFS= read -r SL_MODEL
        IFS= read -r SL_MODEL_ID
        IFS= read -r SL_EFFORT
        IFS= read -r SL_5H
        IFS= read -r SL_5H_RESET
        IFS= read -r SL_WK
        IFS= read -r SL_WK_RESET
        IFS= read -r SL_COST
        IFS= read -r SL_DIR
        IFS= read -r SL_COLUMNS
    } <<EOF
$fields
EOF
    # Stamp rate-limit state for cs -usage window anchoring. Same partition
    # rules as context-pct: machine-local, atomic, best-effort.
    if [ -n "${CLAUDE_SESSION_NAME:-}" ] && { [ -n "${SL_5H:-}" ] || [ -n "${SL_WK:-}" ]; } && ! _session_files_tracked; then
        _limdir="$SL_LOCAL_DIR"
        if [ -d "$_limdir" ] || mkdir "$_limdir" 2>/dev/null || [ -d "$_limdir" ]; then
            _sl_now
            _stamp_due "$_limdir/limits" "${SL_5H%%.*} ${SL_5H_RESET:-} ${SL_WK%%.*} ${SL_WK_RESET:-}"
            if [ -n "$_STAMP_DUE" ]; then
                {
                    printf 'five_hour_used_pct: %s\n' "${SL_5H%%.*}"
                    printf 'five_hour_resets_at: %s\n' "${SL_5H_RESET:-}"
                    printf 'seven_day_used_pct: %s\n' "${SL_WK%%.*}"
                    printf 'seven_day_resets_at: %s\n' "${SL_WK_RESET:-}"
                    printf 'stamped_at: %s\n' "${_NOW}"
                } > "$_limdir/limits.tmp" 2>/dev/null \
                    && mv "$_limdir/limits.tmp" "$_limdir/limits" 2>/dev/null \
                    && _stamp_written "$_limdir/limits"
            fi
        fi
    fi
    return 0
}

# Whether git tracks this session's control files, as the hooks last found it:
# each hook run marks the session under ~/.cache/cs/tracked while it does
# (_cs_note_tracked_files in hooks/cs-resolve.sh), and the stamps above then
# add, change and remove nothing in .cs/local. A render cannot afford to ask
# git, so a pull lands unseen until the next hook runs. Builtins only.
# The mark is read for the names the hooks write one for, so a name the
# writer never marks reads as untracked: KEEP IN SYNC with the case and the
# HOME test in _cs_note_tracked_files.
_session_files_tracked() {
    case "${CLAUDE_SESSION_NAME:-}" in
        ''|*/*) return 1 ;;
    esac
    [ -n "${HOME:-}" ] || return 1
    [ -e "$HOME/.cache/cs/tracked/$CLAUDE_SESSION_NAME" ]
}

# Seconds between rewrites of a stamp file whose value has not changed. The
# stamp files are read for their mtime (the liveness heartbeat, 900 s window)
# and their stamped_at (the limits readers, 1800 s window); a minute keeps
# both fresh without a fork per render.
STAMP_EVERY=60

# Whether stamp file $1 needs rewriting for value $2: yes when its sibling
# `$1.at` does not record a write, records a different value, or records one
# older than STAMP_EVERY. Sets _STAMP_DUE (1 or empty). Builtins only.
_stamp_due() {  # file value
    _STAMP_DUE=1; _STAMP_VALUE="$2"
    local at="$1.at" line="" when
    [ -f "$at" ] || return 0
    IFS= read -r line < "$at" || return 0
    when="${line%% *}"
    [[ "$when" =~ ^[0-9]+$ ]] || return 0
    [ "${line#* }" = "$2" ] || return 0
    _sl_now
    [[ "${_NOW:-}" =~ ^[0-9]+$ ]] || return 0
    [ $(( _NOW - when )) -ge "$STAMP_EVERY" ] || _STAMP_DUE=""
}

# Record that stamp file $1 was just written with value $2 (the value _stamp_due
# was asked about). A builtin write; a torn read of it only costs one early
# rewrite.
_stamp_written() {  # file
    _sl_now
    { printf '%s %s\n' "${_NOW:-0}" "$_STAMP_VALUE" > "$1.at"; } 2>/dev/null || true
}

# Print the dir basename as a last-resort plain status, then exit cleanly.
_fallback() {
    printf '%s\n' "$(basename "${PWD:-/}")"
    exit 0
}

# --- color ladder ----------------------------------------------------------

# Choose the richest color level the terminal advertises.
_detect_level() {
    if [ "${FORCE_COLOR:-}" = "0" ] || [ -n "${NO_COLOR:-}" ] || [ "${TERM:-}" = "dumb" ]; then
        LEVEL="plain"
    # Inside tmux the host mutes a truecolor status line to a fallback palette
    # unless CLAUDE_CODE_TMUX_TRUECOLOR is set; cs exports it at launch, so a
    # pane cs launched keeps full colour. A pane cs did NOT launch — an
    # agent-teams teammate is spawned straight off the tmux server and inherits
    # nothing — does not have it, and its 24-bit output is snapped to the 256
    # cube. That snap is not neutral: a warm off-white's nearest neighbour is
    # index 224, a pink, so a smooth ramp came out as flat blocks with a pink
    # one in the middle. When the output is going to be quantised anyway, emit
    # palette entries in the first place and the quantisation becomes a no-op.
    elif [ -n "${TMUX:-}" ] && [ -z "${SL_ENV_FOREIGN:-}" ] \
        && [ -z "${CLAUDE_CODE_TMUX_TRUECOLOR:-}" ]; then
        # SL_ENV_FOREIGN is settled before this runs: a process that merely
        # inherited TMUX is drawing on its own terminal, nothing is muting it,
        # and downgrading would cost it colour for no reason. And the mute is
        # the host's decision, not TERM's — gating on a "256color" substring
        # skipped every tmux whose default-terminal is screen or similar,
        # which is the population the workaround exists for.
        LEVEL="256"
    elif [ "${COLORTERM:-}" = "truecolor" ] || [ "${COLORTERM:-}" = "24bit" ] \
        || [ "${TERM_PROGRAM:-}" = "iTerm.app" ] || [ "${TERM_PROGRAM:-}" = "WezTerm" ]; then
        LEVEL="truecolor"
    elif [[ "${TERM:-}" == *256color* ]]; then
        LEVEL="256"
    else
        LEVEL="basic"
    fi
}

# Set _SGR to the SGR parameters painting a color name for the active level.
# $1 = 38 (foreground) or 48 (background); $2 = color name. No subprocess.
_sgr() {
    local kind="$1" name="$2"
    case "$LEVEL" in
        truecolor)
            local rgb
            case "$name" in
                # Session-color palette: Claude Code's own /color values (the
                # shared dark/light theme `*_FOR_SUBAGENTS_ONLY` tokens): the
                # session pill and Claude Code's own session accent share this
                # palette. KEEP IN SYNC with _session_color_rgb in bin/cs (the pill).
                red)    rgb="220;38;38" ;;
                blue)   rgb="106;155;204" ;;
                green)  rgb="22;163;74" ;;
                yellow) rgb="202;138;4" ;;
                purple) rgb="130;125;189" ;;
                orange) rgb="217;119;87" ;;
                pink)   rgb="196;102;134" ;;
                cyan)   rgb="8;145;178" ;;
                # The agent rows' model name: a violet distinct from the
                # session palette and from amber.
                periwinkle)
                    [ "$SL_THEME" = "dark" ] && rgb="196;181;253" || rgb="76;29;149" ;;
                rowname)
                    # A subagent row's agent name sits on the bare terminal, not
                    # a capsule, so it takes ink that contrasts the canvas: near-white
                    # on a dark terminal, dark on a light one.
                    [ "$SL_THEME" = "dark" ] && rgb="240;242;255" || rgb="48;42;36" ;;
                rowmeta)
                    # The row's description, ctx and elapsed: quieter than the
                    # name, still readable against the terminal on either theme.
                    [ "$SL_THEME" = "dark" ] && rgb="170;161;148" || rgb="128;116;106" ;;
                # Inks. `amber` is a foreground: the hot number's colour on
                # the neutral capsule, dark enough to hold contrast on cream and
                # bright enough on a dark surface. Nothing paints amber as a
                # fill.
                # It pivots on the measured terminal background when there is
                # one (the bar's surface is a shade of it, the agent rows sit on
                # it directly) and on the theme flag only without a measurement:
                # a light background under a theme that resolved dark would
                # otherwise get the dark-theme amber on cream. The pivot is `ink`'s
                # (1530000), not `_bg_shade`'s: a mid-grey terminal gets white
                # ink, so its amber must be the dark-theme one too.
                amber)
                    if _parse_rgb_triplet "${CS_TERM_BG_RGB:-}"; then
                        _luminance
                        [ "$_LUM" -ge 1530000 ] && rgb="180;83;9" || rgb="251;191;36"
                    elif [ "$SL_THEME" = "dark" ]; then rgb="251;191;36"
                    else rgb="180;83;9"; fi ;;
                # Primary text on the capsule surface: a 35% shade of the
                # surface on a light one, the soft white on a dark one — the same
                # contrast pivot the old surface text used, resolved from the
                # surface's own luminance rather than the theme flag.
                ink)
                    _sgr 48 surface
                    if _parse_rgb_triplet "$_RGB" && { _luminance; [ "$_LUM" -ge 1530000 ]; }; then
                        rgb="$((_R * 35 / 100));$((_G * 35 / 100));$((_B * 35 / 100))"
                    elif [ "$SL_THEME" = "dark" ]; then rgb="230;230;230"
                    else rgb="255;255;255"; fi ;;
                # Secondary text: separators, effort, gauge labels, resting
                # numbers. A shade of the surface like `ink`, so it tracks the
                # measured or assumed background; the 256 and
                # basic arms instead pick fixed values that contrast their
                # fixed fills.
                ink2)
                    _sgr 48 surface
                    _parse_rgb_triplet "$_RGB"
                    _luminance
                    if [ "$_LUM" -ge 1530000 ]; then
                        rgb="$((_R * 55 / 100));$((_G * 55 / 100));$((_B * 55 / 100))"
                    else
                        rgb="$((_R + (255 - _R) * 55 / 100));$((_G + (255 - _G) * 55 / 100));$((_B + (255 - _B) * 55 / 100))"
                    fi ;;
                # The inverted capsule at crit. Its own token, never the session
                # palette's red: that palette is the session pill's and may change.
                crit)
                    [ "$SL_THEME" = "dark" ] && rgb="255;69;58" || rgb="215;0;21" ;;
                # White on the red fill whatever the theme: the fill is the
                # same hue on both, so its ink is too.
                critink) rgb="255;255;255" ;;
                # The effort word wears Claude Code's own /effort picker
                # colours (pixel-sampled from the light picker); on dark they
                # are lifted a third of the way to white so they keep reading
                # on the dark surface. max is a gradient across its letters.
                effort-low)    [ "$SL_THEME" = "dark" ] && rgb="187;159;109" || rgb="150;108;30" ;;
                effort-medium) [ "$SL_THEME" = "dark" ] && rgb="118;169;126" || rgb="44;122;57" ;;
                effort-high)   [ "$SL_THEME" = "dark" ] && rgb="146;158;250" || rgb="87;105;247" ;;
                effort-xhigh)  [ "$SL_THEME" = "dark" ] && rgb="177;89;255" || rgb="135;0;255" ;;
                effort-max-1)  [ "$SL_THEME" = "dark" ] && rgb="174;200;232" || rgb="130;170;220" ;;
                effort-max-2)  [ "$SL_THEME" = "dark" ] && rgb="190;174;219" || rgb="155;130;200" ;;
                effort-max-3)  [ "$SL_THEME" = "dark" ] && rgb="219;174;206" || rgb="200;130;179" ;;
                brand)  rgb="217;119;87" ;;   # Claude coral (#D97757)
                brandshade)
                    # The mark while the attention marker exists: a coral a
                    # shade darker than brand, distinct enough to read as a
                    # change without looking like a foreign color.
                    rgb="184;101;74" ;;
                white)
                    # Softer text on dark terminals to avoid glare.
                    [ "$SL_THEME" = "dark" ] && rgb="230;230;230" || rgb="255;255;255" ;;
                surface)
                    # The capsule surface, tinted from the terminal background
                    # so they harmonize with it instead of sitting on top: a
                    # shade of CS_TERM_BG_RGB (darker on a light terminal,
                    # lighter on a dark one), resolved once per render and cached
                    # since every gauge shares it. Without a measurement, shade
                    # an assumed background in the theme's family.
                    if [ -z "$_SURFACE_RGB" ]; then
                        if ! _bg_shade "${CS_TERM_BG_RGB:-}"; then
                            if [ "$SL_THEME" = "dark" ]; then _bg_shade "28;28;28"
                            else _bg_shade "255;255;255"; fi
                        fi
                        _SURFACE_RGB="$_R;$_G;$_B"
                    fi
                    rgb="$_SURFACE_RGB" ;;
                # Unreachable from rendering; unknown names use the surface.
                *) _sgr "$kind" surface; return ;;
            esac
            _SGR="${kind};2;${rgb}"; _RGB="$rgb" ;;
        256)
            local idx
            case "$name" in
                red)    idx=160 ;;
                blue)   idx=25 ;;
                green)  idx=28 ;;
                yellow) idx=136 ;;
                purple) idx=55 ;;
                orange) idx=166 ;;
                pink)   idx=162 ;;
                cyan)   idx=30 ;;
                periwinkle) [ "$SL_THEME" = "dark" ] && idx=147 || idx=55 ;;
                rowname) [ "$SL_THEME" = "dark" ] && idx=231 || idx=235 ;;
                rowmeta) [ "$SL_THEME" = "dark" ] && idx=248 || idx=244 ;;
                amber)   [ "$SL_THEME" = "dark" ] && idx=214 || idx=130 ;;
                ink)     [ "$SL_THEME" = "dark" ] && idx=255 || idx=236 ;;
                ink2)    [ "$SL_THEME" = "dark" ] && idx=250 || idx=241 ;;
                crit)    [ "$SL_THEME" = "dark" ] && idx=203 || idx=160 ;;
                critink) idx=231 ;;
                effort-low)    [ "$SL_THEME" = "dark" ] && idx=179 || idx=136 ;;
                effort-medium) [ "$SL_THEME" = "dark" ] && idx=71  || idx=28 ;;
                effort-high)   [ "$SL_THEME" = "dark" ] && idx=105 || idx=63 ;;
                effort-xhigh)  [ "$SL_THEME" = "dark" ] && idx=135 || idx=93 ;;
                effort-max-1)  [ "$SL_THEME" = "dark" ] && idx=153 || idx=110 ;;
                effort-max-2)  [ "$SL_THEME" = "dark" ] && idx=183 || idx=140 ;;
                effort-max-3)  [ "$SL_THEME" = "dark" ] && idx=218 || idx=175 ;;
                brand)  idx=173 ;;
                brandshade) idx=167 ;;
                white)
                    [ "$SL_THEME" = "dark" ] && idx=254 || idx=255 ;;
                # The capsule fill: reads like the truecolor surface on a
                # cream terminal without CS_TERM_BG_RGB to shade (a tmux pane
                # cs did not launch has no truecolor flag and no measured
                # background, so this is what an agent-team teammate's row
                # renders in).
                surface)
                    [ "$SL_THEME" = "dark" ] && idx=237 || idx=254 ;;
                # Unknown names fall back to the surface value rather than a
                # stray grey. Safe only because every ink this file paints is
                # one of the named cases above: an unlisted foreground token
                # would land on the same code as its own fill and paint
                # invisible. _seg_session paints primary ink, so a bogus
                # claude_session_color never reaches here as a foreground
                # name.
                *)
                    [ "$SL_THEME" = "dark" ] && idx=237 || idx=254 ;;
            esac
            _SGR="${kind};5;${idx}" ;;
        *)
            local base
            case "$name" in
                red)    base=31 ;;
                blue)   base=34 ;;
                green)  base=32 ;;
                yellow) base=33 ;;
                purple) base=35 ;;
                orange) base=33 ;;
                pink)   base=95 ;;
                cyan)   base=36 ;;
                periwinkle) [ "$SL_THEME" = "dark" ] && base=95 || base=35 ;;
                rowname) [ "$SL_THEME" = "dark" ] && base=97 || base=30 ;;
                rowmeta) base=90 ;;
                amber)  [ "$SL_THEME" = "dark" ] && base=93 || base=33 ;;
                ink)     base=97 ;;
                ink2)    [ "$SL_THEME" = "dark" ] && base=97 || base=37 ;;
                crit)    base=31 ;;
                critink) base=97 ;;
                effort-low)    base=33 ;;
                effort-medium) base=32 ;;
                effort-high)   base=34 ;;
                effort-xhigh)  base=35 ;;
                effort-max-1)  base=36 ;;
                effort-max-2)  base=35 ;;
                effort-max-3)  base=95 ;;
                white)  base=97 ;;
                brand)  base=33 ;;
                brandshade) base=31 ;;   # red, the way the 256 shade leans; brand's 33 would hide it
                *)      base=90 ;;
            esac
            if [ "$kind" = "48" ]; then _SGR=$((base + 10)); else _SGR="$base"; fi ;;
    esac
}

# --- segment helpers -------------------------------------------------------

# Append one item to a capsule. $1 text; $2 capsule group ("identity", "ctx",
# "lim-5h", "cost" …) — items sharing a group render inside one capsule, in
# first-seen order; $3 ink token (default the secondary ink); $4 "bold" or
# empty; $5 how this item joins the one before it inside the capsule: "dot"
# (default) a secondary-ink "  ·  ", "pad" two fill spaces, "space" one,
# "none" nothing. The first item of a capsule never gets a joiner.
_add() {
    _SEG_TEXT+=("$1")
    _SEG_GROUP+=("$2")
    _SEG_INK+=("${3:-ink2}")
    _SEG_BOLD+=("${4:-}")
    _SEG_JOIN+=("${5:-dot}")
    _SEG_ROLE+=("")
    # First-seen group order, the order capsules render in.
    case " ${_GROUPS_SEEN:-} " in *" $2 "*) ;; *) _GROUPS+=("$2"); _GROUPS_SEEN="${_GROUPS_SEEN:-} $2" ;; esac
}

# Give the item just added a role the quiet layout draws by: `chip` for the
# mark and the session name, `value` for a reading, `model` and `branch`.
_role() {
    _SEG_ROLE[$((${#_SEG_TEXT[@]} - 1))]="$1"
}

# Mark a capsule crit: the renderer fills it with `crit` and paints every item
# in it critink bold. A space-delimited list so bash 3.2 needs no map.
_CRIT_GROUPS=""
_invert() {
    _CRIT_GROUPS="$_CRIT_GROUPS $1 "
}

# Resolve a threshold override into _NUM: the value when it is a plain integer
# of at most three digits, the default otherwise. Thresholds arrive from the
# environment and land in `[ ... -ge ... ]`, where a word and a number too wide
# for a signed integer both error to stderr and leave the band unrendered. Three
# digits rather than 0-100 so a value above 100 still reads as "turn this band
# off", the idiom the Stop hook's tiers already use.
_num_or() {  # value, default -> _NUM (the hook's namesake prints instead)
    case "$1" in
        ''|*[!0-9]*|????*) _NUM="$2" ;;
        *)                 _NUM="$1" ;;
    esac
}

# Set _COLOR by mapping a value against warn/crit thresholds: `crit` at or past
# crit, `amber` at or past warn, else the healthy name ($4, default the
# secondary ink). Callers paint the NUMBER with it; `crit` also tells the
# renderer to invert the whole capsule.
_thresh_color() {
    local v="$1" warn="$2" crit="$3" healthy="${4:-ink2}"
    _HOT_WEIGHT=""
    if [ "$v" -ge "$crit" ]; then
        _COLOR=crit
    elif [ "$v" -ge "$warn" ]; then
        _COLOR=amber; _HOT_WEIGHT=bold
    else
        _COLOR="$healthy"
    fi
}

# Convert an ISO 8601 timestamp into epoch seconds in _EPOCH; empty when the
# value is missing or unparseable. The usage endpoint sends fractional seconds
# and an explicit "+00:00" offset ("2026-08-29T03:59:59.686034+00:00"), so both
# are trimmed and the remainder read as UTC.
#
# Any other offset is refused rather than assumed: reading "+02:00" as UTC would
# put the reset two hours late, and a countdown that is confidently wrong is
# worse than no countdown. The glob then pins the field widths so a value that
# is not a timestamp at all never reaches `date`. It does NOT catch day
# overflow — BSD `date -j -f` normalises "2026-02-31" into March — which is
# tolerable only because the field this parses is machine-generated.
#
# BSD date (macOS, the 3.2 floor) takes -j -f; GNU date takes -d, and each
# rejects the other's flags, so trying both in order needs no platform probe.
_iso_epoch() {
    _EPOCH=""
    local iso="${1:-}" base
    [ -n "$iso" ] || return 0
    case "$iso" in
        *+00:00|*+0000|*Z) ;;                 # explicit UTC
        *+*|*T*-*) return 0 ;;                # any other offset: refuse
    esac
    base="${iso%%.*}"     # drop fractional seconds
    base="${base%%+*}"    # drop the "+00:00" offset
    base="${base%Z}"      # drop a trailing Z
    case "$base" in
        [0-9][0-9][0-9][0-9]-[0-1][0-9]-[0-3][0-9]T[0-2][0-9]:[0-5][0-9]:[0-6][0-9]) ;;
        *) return 0 ;;
    esac
    _EPOCH=$(TZ=UTC date -j -f "%Y-%m-%dT%H:%M:%S" "$base" +%s 2>/dev/null)
    [ -n "$_EPOCH" ] || _EPOCH=$(date -u -d "$base" +%s 2>/dev/null)
    [[ "${_EPOCH:-}" =~ ^[0-9]+$ ]] || _EPOCH=""
}

# Format seconds-until-reset into a compact "2h14m" / "45m" countdown in _REST.
# $1 is the resets_at value (Unix epoch seconds, per the statusline schema).
# Empty when it is missing, non-numeric, or already in the past. `now` comes
# from the printf builtin (bash 4.2+) so the hot path stays fork-free; on an
# older bash (e.g. macOS stock 3.2) the builtin is unavailable, so it falls
# back to a `date +%s` fork so the countdown still renders.
_fmt_rest() {
    _REST=""
    local at="$1" now rem h m
    [[ "$at" =~ ^[0-9]+$ ]] || return 0
    # Shared per-render clock (see _sl_now); empty only if every source failed.
    _sl_now
    now="${_NOW:-}"
    [[ "$now" =~ ^[0-9]+$ ]] || return 0
    rem=$(( at - now ))
    [ "$rem" -gt 0 ] || return 0
    local d
    d=$(( rem / 86400 ))
    h=$(( (rem % 86400) / 3600 ))   # hours within the day; == rem/3600 when d==0
    m=$(( (rem % 3600) / 60 ))
    if [ "$d" -gt 0 ]; then
        # Past a day, read in days+hours (dropping minutes, which are noise at
        # that scale) so a weekly window shows "5d16h", not "136h14m".
        _REST="${d}d${h}h"
    elif [ "$h" -gt 0 ]; then
        _REST="${h}h${m}m"
    elif [ "$m" -gt 0 ]; then
        _REST="${m}m"
    else
        _REST="<1m"
    fi
}

# --- fable usage cache ------------------------------------------------------
#
# Fable's weekly window is model-scoped, and Claude Code puts only the two
# plan-wide windows on the statusline's stdin, so this one figure has to be
# fetched. It is fetched out of band and read from a cache: the render itself
# never touches the network.
#
# The cache is machine-global, not per-session, because the endpoint admits only
# ~28-30 requests per account per rolling hour — capacity returns as old
# requests age out, so a burst saturates the account for a full hour — and that
# budget is shared with Claude Code itself and anything else on the machine. One
# cache plus the interval floor below holds cs to ~6 requests an hour per
# account, however many sessions are open.
USAGE_URL="https://api.anthropic.com/api/oauth/usage"
USAGE_BETA="oauth-2025-04-20"
# 600, not 300: the endpoint's ceiling is ~28-30 requests per account per hour,
# and claude-swap — which many cs users run alongside — polls the same account
# on its own 180s floor. At 300 the two together (12/h + 20/h) already exceed
# the ceiling before Claude Code's own polls. 600 costs nothing visible, since
# USAGE_MAX_AGE is 1800.
USAGE_MIN_INTERVAL=600     # floor between successful polls
USAGE_FAIL_BACKOFF=600     # a 429 does not reliably clear at its stated horizon
USAGE_MAX_BACKOFF=3600     # the longest a Retry-After may hold usage polling off

_usage_cache_dir() { printf '%s\n' "${CS_USAGE_DIR:-$SESSIONS_ROOT/.usage}"; }

# The cache file for one account. Per-account, not one file for the machine:
# with a single file an org mismatch had to override the interval (a cache
# holding someone else's reading must be replaced now, not when its window
# elapses), so two sessions signed into different accounts each bypassed the
# other's stamped backoff and fetched on every render — measured at 12 requests
# inside one 600s window against a ~28-30/hour budget. Giving each account its
# own file lets the interval and the account check stop competing: every record
# belongs to the account reading it, so the cadence is simply honoured.
#
# The org is a server-supplied UUID and lands in a path, so it is reduced to the
# characters a UUID actually uses; anything else (including the traversal that a
# hostile value would need) cannot survive. An empty org has no file at all.
# The organizationUuid of the account signed in now, from $1 (Claude Code's
# global config), in _ORG; empty when the file is missing or will not parse.
# `--stream` walks the document instead of building it: this file accumulates
# per-project prompt history and grows without bound, and the render path reads
# it on every repaint. Measured on a 5.5 MB config, streaming a single key beats
# parsing the whole document by roughly an order of magnitude.
# The account changes at a sign-in, not between repaints, so a render takes the
# answer kept for ORG_CACHE_TTL under the config's path: a swap shows within
# five minutes, six while idle, instead of costing a jq walk of a multi-megabyte
# file per render. The refresher passes `fresh`: it attributes a reading and
# detects a swap across its own fetch, and a cached identity there would file
# one account's usage under another. Its fresh answer renews the cache.
ORG_CACHE_TTL=300

_read_org_from() {  # config [fresh]
    _ORG=""
    local cfg="${1:-}"
    [ -f "$cfg" ] || return 0
    if [ "${2:-}" != "fresh" ] && _cache_read org "$cfg" "$ORG_CACHE_TTL"; then
        _ORG="$_CACHE_TEXT"
        return 0
    fi
    # `first(...)` inside jq rather than a `head` pipe: piping would add a fork
    # and, worse, a PATH dependency on a render path that must keep working
    # when PATH holds little more than jq.
    _ORG=$(jq -r --stream 'first(
        select(length == 2 and .[0] == ["oauthAccount","organizationUuid"]) | .[1]
    ) // empty' "$cfg" 2>/dev/null) || _ORG=""
    [ "${_ORG:-}" = "null" ] && _ORG=""
    # An empty answer is not cached: a config caught mid-rewrite yields none,
    # and remembering that would blank the Fable window for the whole TTL.
    [ -n "$_ORG" ] && _cache_write org "$cfg" "$_ORG"
    return 0
}

_usage_cache_file() {
    _CACHE_FILE=""
    local org="${1:-}"
    org="${org//[^A-Za-z0-9._-]/}"
    org="${org//../}"
    [ -n "$org" ] || return 1
    _CACHE_FILE="$(_usage_cache_dir)/fable.$org.json"
}

# Claude Code's global config, whose oauthAccount names the account now signed
# in. Mirrors Claude Code's own resolution: CLAUDE_CONFIG_DIR, else the homedir
# (note the asymmetry — .claude.json sits beside ~/.claude, not inside it).
_claude_config_file() { printf '%s\n' "${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json"; }

# Seconds since $1 was last modified, in _AGE; empty when it cannot be read.
# BSD stat takes -f %m and GNU stat -c %Y, and each rejects the other's flag, so
# trying both in order needs no platform probe.
_file_age() {
    _AGE=""
    local m
    m=$(stat -f %m "$1" 2>/dev/null) || m=$(stat -c %Y "$1" 2>/dev/null) || return 0
    [[ "$m" =~ ^[0-9]+$ ]] || return 0
    _sl_now
    [[ "${_NOW:-}" =~ ^[0-9]+$ ]] || return 0
    _AGE=$(( _NOW - m ))
}

# Run "$@" with a hard wall-clock bound, echoing its stdout. Prefers coreutils
# timeout, then perl's alarm (present on every macOS, where coreutils is not),
# then bare execution. Unlike _timeout this never silently drops the bound on a
# stock macOS, which matters when the caller holds a lock across the call.
_bounded_capture() {
    local secs="$1"; shift
    if command -v timeout >/dev/null 2>&1; then
        timeout "$secs" "$@"
    elif command -v gtimeout >/dev/null 2>&1; then
        gtimeout "$secs" "$@"
    elif [ -x /usr/bin/perl ]; then
        /usr/bin/perl -e 'alarm shift; exec @ARGV or exit 127' "$secs" "$@"
    else
        "$@"
    fi
}

# Rewrite the cache atomically. $1 org, $2 pct (or "-" to carry the previous
# reading forward untouched), $3 resets_at, $4 seconds until the next poll.
# Carrying forward matters on a failed fetch: a transient 429 should cost the
# bar its freshness, not its number — but it must not restamp fetched_at, or a
# permanently failing account would look fresh forever.
_usage_write() {
    local org="$1" pct="$2" reset="$3" offset="$4"
    local dir cache tmp
    dir=$(_usage_cache_dir)
    # A reading nobody can attribute must not be stored: _read_org_from yields
    # empty for a torn or missing config, and an unattributed reading would be
    # rendered by whichever account looked next. But the request still spent
    # budget, so the schedule is recorded under a reserved name — no reading,
    # no attribution, just a next_poll_at the cadence check can honour.
    # Without it an unreadable config meant no file, so no interval was read
    # and none written, and every render fetched again.
    if ! _usage_cache_file "$org"; then
        _CACHE_FILE="$dir/fable.unattributed.json"
        pct=null; reset=""
    fi
    cache="$_CACHE_FILE"; tmp="$cache.tmp.$$"
    _sl_now
    [[ "${_NOW:-}" =~ ^[0-9]+$ ]] || return 0
    local fetched="$_NOW"
    if [ "$pct" = "-" ]; then
        pct=null; reset=""; fetched=0
        if [ -f "$cache" ]; then
            local prev prev_org=""
            prev=$(jq -r '[(.org // ""), (.pct // "null" | tostring), (.resets_at // ""), (.fetched_at // 0 | tostring)] | .[]' \
                "$cache" 2>/dev/null) || prev=""
            if [ -n "$prev" ]; then
                { IFS= read -r prev_org; IFS= read -r pct; IFS= read -r reset; IFS= read -r fetched; } <<EOF
$prev
EOF
                # Carrying a reading forward is only ever valid within one
                # account. Across a swap the old number would be re-labelled
                # with the new org and keep the old fetched_at, so it would read
                # as fresh — blanking nothing and suppressing the retry.
                if [ "$prev_org" != "$org" ]; then pct=null; reset=""; fetched=0; fi
            fi
        fi
    fi
    [ -n "$pct" ] || pct=null
    [[ "${fetched:-}" =~ ^[0-9]+$ ]] || fetched=0
    if jq -n --arg org "$org" --argjson pct "$pct" --arg reset "$reset" \
        --argjson fetched "$fetched" --argjson next "$(( _NOW + offset ))" \
        '{org:$org, pct:$pct, resets_at:$reset, fetched_at:$fetched, next_poll_at:$next}' \
        > "$tmp" 2>/dev/null && mv "$tmp" "$cache" 2>/dev/null; then
        local shown="$pct"; [ "$shown" = "null" ] && shown=""
        _iso_epoch "$reset"
        _usage_fields_write "$cache" "$shown" "$reset" "$fetched" "$(( _NOW + offset ))" "${_EPOCH:-}"
    fi
    rm -f "$tmp" 2>/dev/null
}

# Fetch the Fable weekly window and rewrite the cache. Detached from the render
# and serialised machine-wide by a mkdir lock, so concurrent sessions cannot
# stampede the endpoint. Every exit path stamps next_poll_at, including the
# failures: without that, a broken account would make every render fire another
# request at a budget that is already the scarce resource here.
_refresh_usage() {
    command -v jq >/dev/null 2>&1 || return 0
    command -v curl >/dev/null 2>&1 || return 0
    local dir lock
    dir=$(_usage_cache_dir); lock="$dir/.lock"
    mkdir -p "$dir" 2>/dev/null || return 0
    # Reclaim a lock left behind by a refresher killed mid-flight. The reclaim
    # is a rename, not an rmdir: with rmdir, two contenders that both see the
    # stale lock can both proceed — the second removes the first's *fresh* lock
    # and takes its own, and the first's EXIT trap then releases the second's.
    # `mv` is atomic, so exactly one contender can move the stale directory
    # aside and the loser's mv fails harmlessly.
    if [ -d "$lock" ]; then
        _file_age "$lock"
        if [ -n "${_AGE:-}" ] && [ "$_AGE" -gt 120 ]; then
            mv "$lock" "$lock.reclaimed.$$" 2>/dev/null && rmdir "$lock.reclaimed.$$" 2>/dev/null
        fi
    fi
    mkdir "$lock" 2>/dev/null || return 0
    # The trap body is evaluated at exit, by which point a `local` is long out
    # of scope; the path has to survive in a global for the release to fire.
    _USAGE_LOCK="$lock"
    _USAGE_TMP="$dir/.resp.$$ $dir/.hdr.$$"
    # shellcheck disable=SC2064
    trap 'rm -f ${_USAGE_TMP:-} 2>/dev/null; rmdir "${_USAGE_LOCK:-}" 2>/dev/null' EXIT
    # Sweep anything a SIGKILLed predecessor left behind — the EXIT trap cannot
    # fire for that one, and nothing else ever prunes this directory.
    find "$dir" -maxdepth 1 -type f -name '.resp.*' -mmin +5 -delete 2>/dev/null
    find "$dir" -maxdepth 1 -type f -name '.hdr.*' -mmin +5 -delete 2>/dev/null
    # And any lock a reclaim renamed aside but could not remove; -type f above
    # never matches a directory, so nothing else would ever clear these.
    find "$dir" -maxdepth 1 -type d -name '.lock.reclaimed.*' -mmin +5 -exec rm -rf {} + 2>/dev/null
    # The render caches keyed on the parent pid mint an entry per
    # conversation, so they track conversations-ever. An entry an hour old is
    # far past every one of their TTLs (5 s, 300 s) and already a miss, so
    # removing it costs
    # at most one recomputation, whether its conversation is gone or only
    # idle. The render never forks to sweep, so this worker does it. The other
    # buckets are keyed on identities that repeat and stay small.
    local bucket
    for bucket in tmux-client tmux-client2 tmux-client3 tmux-real tmux-walking tty stty; do
        [ -d "$HOME/.cache/cs/$bucket" ] || continue
        find "$HOME/.cache/cs/$bucket" -maxdepth 1 -type f -mmin +60 -delete 2>/dev/null
    done

    local org="" cfg
    cfg=$(_claude_config_file)
    _read_org_from "$cfg" fresh; org="$_ORG"

    # Honour the cadence under the lock. The render kicks on _FABLE_DUE, which
    # is deliberately raised by conditions that are not "the interval elapsed" —
    # a corrupt cache, an unreadable config — so without this a stray DUE spends
    # a request the schedule had already booked. Re-read here rather than trust
    # the caller: this is the one place that sees the cache under the lock,
    # after any concurrent refresher has written.
    #
    # The account check comes FIRST and overrides the interval: a cache holding
    # another account's reading must be replaced now, not when its window
    # happens to elapse. Ordering these the other way silently reintroduced the
    # cross-account defect this file's own test exists to catch.
    # Honour the cadence under the lock, reading THIS account's own record. The
    # render kicks on _FABLE_DUE, which is deliberately raised by conditions
    # that are not "the interval elapsed" — a corrupt cache, an unreadable
    # config — so without this a stray DUE spends a request the schedule had
    # already booked. Because the record is per-account, the account check and
    # the interval no longer compete: no mismatch can bypass a backoff.
    local cache=""
    _usage_cache_file "$org" || _CACHE_FILE="$dir/fable.unattributed.json"
    if [ -f "$_CACHE_FILE" ]; then
        cache="$_CACHE_FILE"
        # The JSON is the record; its schedule is the one honoured, so a
        # backoff a 429 recorded is never skipped. A sidecar that disagrees
        # with it (a refresher killed between writing the two, or a record an
        # older cs wrote alone) is rewritten from the JSON here, without a
        # fetch: the render reads the sidecar, so the disagreement is what it
        # kicked this refresher over.
        local due_at
        due_at=$(jq -r '(.next_poll_at // 0 | tostring)' "$cache" 2>/dev/null) || due_at=0
        _usage_fields_repair "$cache" "$due_at"
        [[ "${due_at:-}" =~ ^[0-9]+$ ]] || due_at=0
        _sl_now
        if [[ "${_NOW:-}" =~ ^[0-9]+$ ]] && [ "$_NOW" -lt "$due_at" ]; then return 0; fi
    fi

    # Claude Code's own credential, read and never written: it owns the refresh
    # cycle, so an expired token is a 401 to back off from, not ours to repair.
    # The default path is absolute so a `security` planted earlier on PATH
    # cannot intercept a credential read. CS_SECURITY_BIN overrides it for the
    # test suite; that is not a weakening, because anyone who can set the
    # environment of this process can already redirect its `curl` and `jq`.
    local creds="" token="" sec="${CS_SECURITY_BIN:-/usr/bin/security}"
    if [ -x "$sec" ]; then
        # A locked login keychain can put `security` behind a SecurityAgent
        # prompt that never gets answered on a headless or ssh host, and this
        # process holds the machine-wide refresh lock while it waits.
        #
        # _timeout is not enough here: it falls through to bare execution when
        # neither timeout nor gtimeout exists, and stock macOS ships neither —
        # which is the only platform where that prompt exists at all, so the
        # bound would be missing exactly where it is needed. /usr/bin/perl is on
        # every macOS and its alarm() needs no coreutils.
        creds=$(_bounded_capture 5 "$sec" find-generic-password \
            -a "${USER:-$(id -un 2>/dev/null)}" -s "Claude Code-credentials" -w 2>/dev/null) || creds=""
    fi
    if [ -z "$creds" ]; then
        # Linux and WSL2 have no Keychain; Claude Code keeps the same document
        # in plaintext there. Same shape, so the same extraction works.
        local plain="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.credentials.json"
        [ -f "$plain" ] && creds=$(cat "$plain" 2>/dev/null)
    fi
    if [ -n "$creds" ]; then
        token=$(printf '%s' "$creds" | jq -r '.claudeAiOauth.accessToken // empty' 2>/dev/null) || token=""
    fi
    creds=""
    if [ -z "$token" ]; then
        _usage_write "$org" - "" "$USAGE_FAIL_BACKOFF"
        return 0
    fi

    local body="$dir/.resp.$$" hdr="$dir/.hdr.$$" code
    # The bearer goes to curl on stdin as a -K config line. On argv it would sit
    # in `ps` output for every process on the machine to read.
    code=$(printf 'header = "Authorization: Bearer %s"\n' "$token" | curl -sS -K - \
        --max-time 8 -o "$body" -D "$hdr" -w '%{http_code}' \
        -H "anthropic-beta: $USAGE_BETA" -H "User-Agent: cs-statusline" \
        "$USAGE_URL" 2>/dev/null) || code=000
    token=""

    # An account swap during the request would otherwise stamp the account we
    # asked about with the org that is signed in now — the same defect as
    # re-labelling a carried-forward reading, but reached through success, so
    # the carry-forward guard cannot see it. Discard rather than guess.
    #
    # Only two populated, differing values are evidence of a swap. An empty
    # reading means the config was briefly unreadable, which _fable_read already
    # treats as unknown; disagreeing with it here would throw away a good
    # reading for the right account and blank the capsule for a whole interval.
    _read_org_from "$cfg" fresh
    if [ -n "$_ORG" ] && [ -n "$org" ] && [ "$_ORG" != "$org" ]; then
        # Discard the result: it belongs to the account we started under, which
        # is no longer signed in. Record the schedule against THAT account —
        # its budget paid for the request — and leave the account swapped TO
        # untouched. Writing to $_ORG here would blank a reading it already
        # holds and restamp it fresh, emptying the capsule for a full interval on
        # the account that just became active, which is the swap case the whole
        # feature is for. If it has no reading, the next render is due anyway.
        _usage_write "$org" - "" "$USAGE_MIN_INTERVAL"
        rm -f "$body" "$hdr" 2>/dev/null
        return 0
    fi

    # A 200 whose body is not this API's JSON — a captive portal or proxy
    # interstitial — parses to no Fable window, which is indistinguishable from
    # "this account has no Fable bucket" and would wipe the last good reading
    # AND stamp it fresh. Require the response to be the shape we asked for;
    # anything else is a failure, and the failure paths carry forward.
    if [ "$code" = "200" ] && ! jq -e 'has("limits") or has("five_hour") or has("seven_day")' "$body" >/dev/null 2>&1; then
        code="bad-body"
    fi

    if [ "$code" = "200" ]; then
        # The unified windows ride in the same limits[] array with a null model
        # scope, so the Fable bucket is selected by its model display name —
        # never by position, which would silently record the 5-hour number.
        local fable pct="" reset=""
        fable=$(jq -r 'first(.limits[]? | select((.scope.model.display_name // "") | test("^fable"; "i")))
                       | [(.percent // "" | tostring), (.resets_at // "")] | .[]' "$body" 2>/dev/null) || fable=""
        if [ -n "$fable" ]; then
            { IFS= read -r pct; IFS= read -r reset; } <<EOF
$fable
EOF
        fi
        [[ "${pct:-}" =~ ^[0-9]+(\.[0-9]+)?$ ]] || pct=""
        _usage_write "$org" "${pct:-null}" "${reset:-}" "$USAGE_MIN_INTERVAL"
    else
        local wait="$USAGE_FAIL_BACKOFF" ra=""
        if [ "$code" = "429" ] && [ -f "$hdr" ]; then
            # No `exit` in the awk: an early-exiting pipe consumer SIGPIPEs its
            # producer, which under `set -o pipefail` reports failure.
            ra=$(tr -d '\r' < "$hdr" | awk 'tolower($1)=="retry-after:"{v=$2} END{print v}') || ra=""
            # 10# forces base 10: a zero-padded value would otherwise be read
            # as octal by $(( )) and abort the arithmetic on an 8 or 9. At most
            # fifteen digits: a longer header wraps past 64 bits to a positive
            # number centuries out, and cs would never poll again. A header cs
            # cannot judge takes the floor, like one that is not a number.
            if [[ "${ra:-}" =~ ^[0-9]{1,15}$ ]] && [ $(( 10#$ra + 60 )) -gt "$wait" ]; then
                wait=$(( 10#$ra + 60 ))
                # A server may name any horizon, and a wrong one is unfalsifiable
                # from here: the cache honours whatever deadline lands, so an
                # hour is the longest this backoff will hold a machine out. The
                # next render reads the header again anyway.
                [ "$wait" -le "$USAGE_MAX_BACKOFF" ] || wait="$USAGE_MAX_BACKOFF"
            fi
        fi
        _usage_write "$org" - "" "$wait"
    fi
    rm -f "$body" "$hdr" 2>/dev/null
}

USAGE_MAX_AGE=1800   # past this a reading is too old to sit beside a live countdown

# Read the cached Fable window into _FABLE_PCT (integer) and _FABLE_RESET
# (epoch), and raise _FABLE_DUE when a refresh should be kicked. Identity is
# structural rather than checked: the record is addressed by the account signed
# in now, so a reading can never be found under the wrong one and no comparison
# is needed. Anything unreadable or too old yields no reading at all — the capsule
# may be absent, but it must never carry a number that is not this account's.
_fable_read() {
    _FABLE_PCT=""
    _FABLE_RESET=""
    _FABLE_DUE=""
    command -v jq >/dev/null 2>&1 || return 0
    local cache cfg
    cfg=$(_claude_config_file)
    [ -f "$cfg" ] || return 0
    # Read this account's own record. Addressing by account rather than
    # filtering one shared file means a reading can never be found under the
    # wrong identity; an unreadable config yields no account and so no file.
    _read_org_from "$cfg"
    _usage_cache_file "${_ORG:-}" || return 0
    cache="$_CACHE_FILE"
    if [ ! -f "$cache" ]; then _FABLE_DUE=1; return 0; fi
    _sl_now
    [[ "${_NOW:-}" =~ ^[0-9]+$ ]] || return 0
    # The record's fields, one per line, from the sibling `.fields` file the
    # refresher writes with the JSON (see _usage_fields_write): pct, resets_at,
    # fetched_at, next_poll_at, and resets_at as an epoch, so the render neither
    # parses JSON nor forks date. A record without one (written before the
    # sidecar existed) is parsed with jq until the next refresh, within the
    # poll interval; the render never writes the sidecar itself, so it cannot
    # race a refresher's newer one with an older parse.
    local pct="" reset="" fetched="" next="" reset_epoch=""
    if [ -f "$cache.fields" ]; then
        {
            IFS= read -r pct
            IFS= read -r reset
            IFS= read -r fetched
            IFS= read -r next
            IFS= read -r reset_epoch
        } < "$cache.fields"
    else
        local fields
        fields=$(jq -r '
            [ (.pct // "" | tostring),
                (.resets_at // ""),
                (.fetched_at // 0 | tostring),
                (.next_poll_at // 0 | tostring) ] | .[]' "$cache" 2>/dev/null) || { _FABLE_DUE=1; return 0; }
        if [ -z "$fields" ]; then _FABLE_DUE=1; return 0; fi
        {
            IFS= read -r pct
            IFS= read -r reset
            IFS= read -r fetched
            IFS= read -r next
        } <<EOF
$fields
EOF
        _iso_epoch "$reset"; reset_epoch="${_EPOCH:-}"
    fi
    [[ "${next:-}" =~ ^[0-9]+$ ]] || next=0
    [ "$_NOW" -ge "$next" ] && _FABLE_DUE=1
    [[ "${fetched:-}" =~ ^[0-9]+$ ]] || return 0
    [ $(( _NOW - fetched )) -le "$USAGE_MAX_AGE" ] || return 0
    [[ "${pct:-}" =~ ^[0-9]+(\.[0-9]+)?$ ]] || return 0
    _FABLE_PCT="${pct%%.*}"
    [[ "${reset_epoch:-}" =~ ^[0-9]+$ ]] || reset_epoch=""
    _FABLE_RESET="$reset_epoch"
}

# Rewrite cache file $1's sidecar from its JSON when the sidecar is missing or
# its schedule is not $2 (the JSON's next_poll_at). Best effort.
_usage_fields_repair() {  # cache next_poll_at
    local have=""
    if [ -f "$1.fields" ]; then
        { IFS= read -r have; IFS= read -r have; IFS= read -r have; IFS= read -r have; } < "$1.fields"
        [ "$have" = "$2" ] && return 0
    fi
    local fields pct="" reset="" fetched="" next=""
    fields=$(jq -r '[ (.pct // "" | tostring), (.resets_at // ""),
        (.fetched_at // 0 | tostring), (.next_poll_at // 0 | tostring) ] | .[]' "$1" 2>/dev/null) || return 0
    [ -n "$fields" ] || return 0
    { IFS= read -r pct; IFS= read -r reset; IFS= read -r fetched; IFS= read -r next; } <<EOF
$fields
EOF
    [ "$pct" = "null" ] && pct=""
    _iso_epoch "$reset"
    _usage_fields_write "$1" "$pct" "$reset" "$fetched" "$next" "${_EPOCH:-}"
}

# The render-side copy of a usage record: cache file $1's fields one per line
# (pct, resets_at, fetched_at, next_poll_at, resets_at as an epoch), written
# beside the JSON by the refresher, the JSON's only writer, so a render reads
# it with builtins. Best effort; a missing file only costs the render a jq.
_usage_fields_write() {  # cache pct reset fetched next reset_epoch
    { printf '%s\n' "$2" "$3" "$4" "$5" "$6" > "$1.fields.tmp.$$" \
        && mv "$1.fields.tmp.$$" "$1.fields"; } 2>/dev/null || rm -f "$1.fields.tmp.$$" 2>/dev/null
}

# Read one key from a session's machine-local state file (.cs/local/state)
# into _STATE_VALUE (empty if none). Pure bash: this runs per render, where an
# awk fork is real cost. KEEP THE FORMAT IN SYNC WITH bin/cs's
# _read_local_state.
_read_state_key() {  # state-file key
    _STATE_VALUE=""
    local state="$1" key="$2" line v
    [ -f "$state" ] || return 0
    while IFS= read -r line; do
        case "$line" in
            "$key":*)
                v="${line#"$key":}"
                v="${v#"${v%%[![:space:]]*}"}"
                _STATE_VALUE="${v//\"/}"
                return 0
                ;;
        esac
    done < "$state"
}

# Format the git segment text for a workspace dir into _GIT_TEXT, empty when
# it is not a git repo / git is unavailable / git times out.
# git status is the one fork here that also reads the working tree, and the bar
# repaints on every Claude Code event; a reading is reused for GIT_CACHE_TTL
# seconds, keyed by the workspace path, so one render per window pays for it.
GIT_CACHE_TTL=5

_git_text() {
    _GIT_TEXT=""
    local dir="$1"
    [ -n "$dir" ] || return 0
    # The workspace directory follows the Bash tool's cwd, so a subdirectory
    # of the checkout must read as the checkout: climb to the nearest ancestor
    # holding .git (a directory, or the file a worktree keeps), in-process, and
    # key the cache on it so every subdirectory shares one entry. Trailing
    # slashes are dropped at every step, so `/repo/`, `/repo//sub/` and
    # `/repo/sub` all name the `/repo` entry; the climb ends at `/` itself,
    # checked once. A relative path climbs its own components and never `.`
    # (the workspace path is absolute).
    while :; do
        while [ "$dir" != / ] && [ "${dir%/}" != "$dir" ]; do dir="${dir%/}"; done
        [ -e "$dir/.git" ] && break
        case "$dir" in
            /) return 0 ;;
            */*) dir="${dir%/*}"; [ -n "$dir" ] || dir=/ ;;
            *) return 0 ;;
        esac
    done
    if _cache_read git "$dir" "$GIT_CACHE_TTL"; then
        _GIT_TEXT="$_CACHE_TEXT"
        return 0
    fi
    _git_status_text "$dir"
    _cache_write git "$dir" "$_GIT_TEXT"
}

# One git status, parsed into _GIT_TEXT (empty when git is unavailable, times
# out, or reports no branch).
_git_status_text() {
    local dir="$1" out
    out=$(_timeout 2 git -C "$dir" status --porcelain=v1 -b 2>/dev/null) || return 0
    local branch="" ahead=0 behind=0 staged=0 modified=0 first=1 line x y h
    while IFS= read -r line; do
        if [ "$first" = "1" ]; then
            first=0
            h="${line#\#\# }"
            case "$h" in
                "No commits yet on "*) branch="${h#No commits yet on }" ;;
                "HEAD (no branch)")    branch="HEAD" ;;
                *)
                    branch="${h%%...*}"
                    [[ "$h" =~ ahead\ ([0-9]+) ]] && ahead="${BASH_REMATCH[1]}"
                    [[ "$h" =~ behind\ ([0-9]+) ]] && behind="${BASH_REMATCH[1]}"
                    ;;
            esac
        else
            x="${line:0:1}"; y="${line:1:1}"
            # Untracked entries are `??` in both columns; exclude `?` from both
            # counts so untracked files do not show as a phantom modified `!`.
            [ "$x" != " " ] && [ "$x" != "?" ] && staged=$((staged + 1))
            [ "$y" != " " ] && [ "$y" != "?" ] && modified=$((modified + 1))
        fi
    done <<EOF
$out
EOF
    [ -n "$branch" ] || return 0
    local text="$branch"
    # Brace the expansion: a bare $text↑ would let set -u read the arrow's first
    # UTF-8 byte as part of the variable name and abort on "unbound variable".
    [ "$ahead" -gt 0 ] && text="${text}↑${ahead}"
    [ "$behind" -gt 0 ] && text="${text}↓${behind}"
    local marks=""
    [ "$staged" -gt 0 ] && marks="+$staged"
    [ "$modified" -gt 0 ] && marks="$marks!$modified"
    [ -n "$marks" ] && text="$text $marks"
    _GIT_TEXT="$text"
}

# --- segments --------------------------------------------------------------

# The Claude mark, coral ink on the identity capsule. While the session's
# attention marker exists (raised by the Stop hook when Claude finishes a turn,
# cleared on the next prompt) the mark takes brandshade instead of brand. The
# ink holds steady because an idle bar repaints only once a minute, and a timed
# blink would freeze on whichever phase it last drew. Plain mode has no colour,
# so no mark.
_seg_logo() {
    [ "$LEVEL" = "plain" ] && return 0
    local ink=brand
    if [ -n "${CLAUDE_SESSION_NAME:-}" ] \
        && [ -f "$SESSIONS_ROOT/$CLAUDE_SESSION_NAME/.cs/local/attention" ]; then
        ink=brandshade
    fi
    _add "${ICON_LOGO}" identity "$ink" bold
    _role chip
}

# The session name, bold, in primary ink.
_seg_session() {
    local name="$SL_SESSION"
    [ -n "$name" ] || name="${CLAUDE_SESSION_NAME:-}"
    if [ -z "$name" ]; then
        local dir="${SL_DIR:-$PWD}"
        name="${dir##*/}"
    fi
    _add "${name}" identity ink bold space
    _role chip
    _session_encrypted "$name" || return 0
    # The lock is a private-use glyph, so it waits on the same font consent as
    # the capsule caps; unconfirmed fonts get a word instead of a box.
    if _caps_wanted; then
        _add "$ICON_LOCK" identity ink2 "" space
    else
        _add "enc" identity ink2 "" space
    fi
    _role chip
}

# True when the session's README frontmatter lists the `encrypted` tag, the
# marker a session carries when it keeps its notes in an encrypted volume.
# Reads the flow-style `tags: [a, b]` line the TUI and `cs -tag` share,
# in-process; the item must be `encrypted` exactly, quoted or not.
_session_encrypted() {  # session_name
    local readme="$SESSIONS_ROOT/$1/.cs/README.md" line n=0 item
    [ -f "$readme" ] && [ -r "$readme" ] || return 1
    while IFS= read -r line || [ -n "$line" ]; do
        n=$((n + 1))
        if [ "$n" -eq 1 ]; then
            [ "$line" = "---" ] || return 1
            continue
        fi
        [ "$line" = "---" ] && return 1
        case "$line" in
            tags:*) ;;
            *) continue ;;
        esac
        line="${line#tags:}"
        line="${line#*[}"
        line="${line%]*}"
        while [ -n "$line" ]; do
            item="${line%%,*}"
            case "$line" in *,*) line="${line#*,}" ;; *) line="" ;; esac
            item="${item#"${item%%[![:space:]]*}"}"
            item="${item%"${item##*[![:space:]]}"}"
            item="${item#\"}"; item="${item%\"}"
            [ "$item" = "encrypted" ] && return 0
        done
        return 1
    done < "$readme"
    return 1
}

# Where the current session's cs content files live: .cs/private in an
# encrypted session (a link into its vault; while it dangles nothing under it
# reads, so its segments show nothing), else .cs/local. cs_private_dir's rule,
# inlined: the bar sources no library.
_sl_cs_files() {
    local meta="$SESSIONS_ROOT/$CLAUDE_SESSION_NAME/.cs"
    if [ -L "$meta/private" ] || [ -e "$meta/private" ]; then
        printf '%s' "$meta/private"
    else
        printf '%s' "$meta/local"
    fi
}

# Count of queued tasks for the current session (one file per task in the
# queue/ directory), shown right after the session name. Hidden when the
# queue is empty or absent. Only regular files count, so a subdirectory or
# an unmatched glob (bash 3.2 has no nullglob) never inflates the count.
_seg_notes() {
    [ -n "${CLAUDE_SESSION_NAME:-}" ] || return 0
    local qdir
    qdir="$(_sl_cs_files)/queue"
    [ -d "$qdir" ] || return 0
    local n=0 f
    for f in "$qdir"/*; do
        [ -f "$f" ] || continue
        n=$((n + 1))
    done
    [ "$n" -gt 0 ] || return 0
    _add "${ICON_NOTES}${n}" identity amber "" pad
}

# Unread cross-session mail for the current session, shown after the notes
# queue. Hidden when nothing is unread or the maildir is absent. Unread is the
# count of mail/new/*.json documents (cs -msg moves what it prints to cur/) —
# the same basis as the shell reader and the TUI. Only *.json files count: a
# .DS_Store, a staging leftover or a subdirectory must not show a phantom
# unread that never clears. The [ -f ] guard also covers bash 3.2's lack of
# nullglob (an unmatched glob comes back literal).
_seg_mail() {
    [ -n "${CLAUDE_SESSION_NAME:-}" ] || return 0
    local mdir
    mdir="$(_sl_cs_files)/mail"
    [ -d "$mdir/new" ] || return 0
    local unread=0 f
    for f in "$mdir"/new/*.json; do
        [ -f "$f" ] || continue
        unread=$((unread + 1))
    done
    [ "$unread" -gt 0 ] || return 0
    _add "${ICON_MAIL}${unread}" identity amber "" pad
}

# The tmux pane hosting this conversation, "◫ 7": the number without its "%"
# so it cannot read as a percentage; prefix it back for a tmux target. Both
# vars are inherited environment, so neither is evidence on its own (see
# SL_ENV_FOREIGN). Off the default order; renders when named.
_seg_pane() {
    [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ] || return 0
    [ -z "${SL_ENV_FOREIGN:-}" ] || return 0
    _add "${ICON_PANE}${TMUX_PANE#%}" identity ink2 "" pad
}

# The ctx icon is a pie that fills as context does. Its half and
# three-quarter steps sit at the warn and crit thresholds so the shape changes
# exactly where the ink does; the empty, quarter and full steps sit at fixed 0,
# 13 and 88.
_ctx_pie() {  # pct warn crit -> _PIE
    local v="$1" warn="$2" crit="$3"
    if [ "$v" -ge 88 ]; then _PIE="$ICON_CTX_FULL"
    elif [ "$v" -ge "$crit" ]; then _PIE="$ICON_CTX_3Q"
    elif [ "$v" -ge "$warn" ]; then _PIE="$ICON_CTX_HALF"
    elif [ "$v" -ge 13 ]; then _PIE="$ICON_CTX"
    else _PIE="$ICON_CTX_EMPTY"
    fi
}

# Two items in the ctx capsule: the pie and label in secondary ink, the number
# in the threshold colour. At crit the whole capsule inverts.
_seg_ctx() {
    local v="${SL_CTX%%.*}"
    [ -n "$v" ] || return 0
    local warn crit
    _num_or "${CS_STATUSLINE_CTX_WARN:-}" 40; warn="$_NUM"
    _num_or "${CS_STATUSLINE_CTX_CRIT:-}" 65; crit="$_NUM"
    _thresh_color "$v" "$warn" "$crit"
    [ "$_COLOR" = "crit" ] && _invert ctx
    _ctx_pie "$v" "$warn" "$crit"
    _add "${_PIE}ctx" ctx ink2 "" none
    _add "${v}%" ctx "$_COLOR" "$_HOT_WEIGHT" space
    _role value
}

# The effort word after the model wears Claude Code's own /effort colour for
# that level, regular weight; max is painted letter by letter through its
# gradient. A level the picker does not have stays secondary ink.
_seg_model() {
    [ -n "$SL_MODEL" ] || return 0
    _add "${ICON_MODEL}${SL_MODEL}" identity ink bold
    _role model
    [ -n "$SL_EFFORT" ] || return 0
    case "$SL_EFFORT" in
        low|medium|high|xhigh)
            _add "$SL_EFFORT" identity "effort-$SL_EFFORT" "" space ;;
        max)
            _add "m" identity effort-max-1 "" space
            _add "a" identity effort-max-2 "" none
            _add "x" identity effort-max-3 "" none ;;
        *)
            _add "$SL_EFFORT" identity ink2 "" space ;;
    esac
    return 0
}

_seg_git() {
    _git_text "$SL_DIR"
    local t="$_GIT_TEXT"
    [ -n "$t" ] || return 0
    _add "${ICON_GIT}${t}" identity ink bold
    _role branch
}

# One rate-limit window: label in secondary ink, the number in the threshold
# colour. $4 is the usage floor at or above which the reset countdown is
# appended (5h at 70, the reveal; the seven-day windows at 80: the coarse
# windows only make time-to-reset actionable near exhaustion). $6 is the
# capsule the window lands in and $7 the join before its label: 5h and wk
# share the quota capsule, joined by a vertical ellipsis (U+22EE, text height); fable has its own. A crit window
# inverts its whole capsule, so one hot window reddens the pair: throttling is
# near for the account, whichever window tripped.
_limits_render() {
    local name="$1" pct="$2" reset="$3" gate="$4" icon="$5" group="$6" join="$7"
    _thresh_color "$pct" 70 90
    [ "$_COLOR" = "crit" ] && _invert "$group"
    local label="${pct}%"
    if [ "$pct" -ge "$gate" ]; then
        _fmt_rest "$reset"
        [ -n "$_REST" ] && label="$label · $_REST"
    fi
    _add "${icon}${name}" "$group" ink2 "" "$join"
    _add "$label" "$group" "$_COLOR" "$_HOT_WEIGHT" space
    _role value
}

# Read the Fable window into the candidate list. Model-scoped, so it is only
# ever a candidate on a Fable session; the cache read and the refresh kick run
# whether or not the capsule is shown, so a hidden window keeps polling at its
# floor. See _fable_read and _refresh_usage.
_fable_candidate() {
    _FABLE_KICKED=""
    case "${SL_MODEL_ID:-}" in claude-fable*) ;; *) return 0 ;; esac
    _fable_read
    # A machine with no curl can never write the cache, so every render would be
    # due and every render would fork a subshell plus a whole bash load of this
    # script just to bail — on every render, per open Fable session. Check here
    # instead, where the check is free.
    if [ -n "$_FABLE_DUE" ] && [ "${CS_USAGE_NO_REFRESH:-}" != "1" ] \
        && command -v curl >/dev/null 2>&1; then
        _FABLE_KICKED=1
        # Detached, so the render never waits on the network: the subshell exits
        # at once and the refresher is orphaned. Its own lock is what keeps
        # concurrent sessions from stampeding the endpoint.
        ( "${BASH:-bash}" "$_SL_SELF" --refresh-usage >/dev/null 2>&1 & ) >/dev/null 2>&1
    fi
    [ -n "$_FABLE_PCT" ] || return 0
    _LIM_NAME+=("fable"); _LIM_PCT+=("$_FABLE_PCT"); _LIM_RESET+=("$_FABLE_RESET")
    _LIM_GATE+=(80); _LIM_ICON+=("$ICON_FABLE"); _LIM_SHOW+=(50); _LIM_GROUP+=("lim-fable")
}

# The 5h window is the one being spent right now, so it is always on the bar.
# The coarse windows — wk from stdin and, on a Fable session, the model-scoped
# weekly window from the usage cache — arrive at 50 and stay hidden below it;
# their arrival is the signal. The order is fixed: 5h, wk, fable. Reveal and
# colour are separate: every window is neutral below 70, amber from 70, crit
# from 90 (see _limits_render).
_seg_limits() {
    _LIM_NAME=(); _LIM_PCT=(); _LIM_RESET=(); _LIM_GATE=(); _LIM_ICON=(); _LIM_SHOW=(); _LIM_GROUP=()
    local h="${SL_5H%%.*}" w="${SL_WK%%.*}"
    if [ -n "$h" ]; then
        _LIM_NAME+=("5h"); _LIM_PCT+=("$h"); _LIM_RESET+=("$SL_5H_RESET"); _LIM_GATE+=(70); _LIM_ICON+=("$ICON_5H"); _LIM_SHOW+=(0); _LIM_GROUP+=("limits")
    fi
    if [ -n "$w" ]; then
        _LIM_NAME+=("wk"); _LIM_PCT+=("$w"); _LIM_RESET+=("$SL_WK_RESET"); _LIM_GATE+=(80); _LIM_ICON+=("$ICON_WK"); _LIM_SHOW+=(50); _LIM_GROUP+=("limits")
    fi
    _fable_candidate
    _limits_emit_hot
}

# The `fable` name alone: the Fable window only. When `limits` is also named
# (in either order) that segment owns all three windows and this one is a
# no-op, so the two-capsule cap holds across the whole bar. Kept so a
# CS_STATUSLINE_SEGMENTS written before `limits` covered the Fable window still
# shows it.
_seg_fable() {
    [ -z "${_LIMITS_NAMED:-}" ] || return 0
    _LIM_NAME=(); _LIM_PCT=(); _LIM_RESET=(); _LIM_GATE=(); _LIM_ICON=(); _LIM_SHOW=(); _LIM_GROUP=()
    _fable_candidate
    _limits_emit_hot
}

# Render every candidate at or past its own reveal floor (_LIM_SHOW), in the
# order they were registered: 5h, wk, fable. The order is fixed so capsules
# never swap places as the numbers move.
_limits_emit_hot() {
    local n=${#_LIM_NAME[@]} i join opened=" "
    for ((i = 0; i < n; i++)); do
        [ -n "${_LIM_NAME[i]}" ] || continue
        [ "${_LIM_PCT[i]}" -ge "${_LIM_SHOW[i]}" ] || continue
        join=none
        case "$opened" in *" ${_LIM_GROUP[i]} "*) join=bar ;; esac
        opened="${opened}${_LIM_GROUP[i]} "
        _limits_render "${_LIM_NAME[i]}" "${_LIM_PCT[i]}" "${_LIM_RESET[i]}" \
            "${_LIM_GATE[i]}" "${_LIM_ICON[i]}" "${_LIM_GROUP[i]}" "$join"
    done
}

_seg_cost() {
    [ -n "$SL_COST" ] || return 0
    local formatted
    printf -v formatted '$%.2f' "$SL_COST" 2>/dev/null || return 0
    _add "$formatted" cost
    _role value
}

# --- color math --------------------------------------------------------------

# Set _WIDTH to the display width (cells) of "$1": UTF-8 codepoints, not
# bytes — every icon and label this script emits is single-width, so
# codepoint count equals cell count. Every codepoint has exactly one leading
# (non-continuation) byte, so the width is the length of "$1" with its
# continuation bytes (the 0x80-0xBF range) removed. Under a UTF-8 locale bash
# sees whole characters and the pattern removes nothing; under the C locale,
# or in a bash without multibyte support, it sees bytes and removes the
# continuation bytes: the count is the same either way. The shell's own
# locale is never changed, because a bash linked against libintl can die
# setting one inside a command substitution. No subprocess. Used by
# the band layout's cell count and by bin/cs-subagent-statusline (_fixed_width
# and _truncate).
_display_width() {
    local s="${1//[$'\x80'-$'\xBF']/}"
    _WIDTH=${#s}
}

# Parse "$1" as an "r;g;b" triplet of 0-255 integers into _R/_G/_B. Returns 1
# (leaving _R/_G/_B unset) if the string doesn't parse — a missing field, an
# extra field, a non-numeric value, and an out-of-range channel are all
# rejected by the same width/format check, so callers need no separate
# validation step: a failed parse is the single "this isn't usable" signal.
_parse_rgb_triplet() {
    local rgb="$1" r g b
    [[ "$rgb" =~ ^[0-9]{1,3}\;[0-9]{1,3}\;[0-9]{1,3}$ ]] || return 1
    IFS=';' read -r r g b <<< "$rgb"
    [ "$r" -le 255 ] && [ "$g" -le 255 ] && [ "$b" -le 255 ] || return 1
    _R="$r"; _G="$g"; _B="$b"
}

# Set _LUM to the BT.709 relative luminance of _R/_G/_B, scaled by 10000 (so
# the mid-grey pivot is 1275000). Reads the channels _parse_rgb_triplet leaves
# behind; fork-free.
_luminance() {
    _LUM=$((2126 * _R + 7152 * _G + 722 * _B))
}

# Set _R/_G/_B to a shade of the color "$1", nudged away from itself: darker
# when it is light, lighter when it is dark, classified by BT.709 luminance.
# Its only caller is the surface: a shade of the terminal background. Returns
# non-zero on a color that does not parse, so callers can fall back.
_bg_shade() {
    _parse_rgb_triplet "$1" || return 1
    local r="$_R" g="$_G" b="$_B" shift=10
    _luminance
    if [ "$_LUM" -ge 1275000 ]; then
        _R=$((r * (100 - shift) / 100))
        _G=$((g * (100 - shift) / 100))
        _B=$((b * (100 - shift) / 100))
    else
        _R=$((r + (255 - r) * shift / 100))
        _G=$((g + (255 - g) * shift / 100))
        _B=$((b + (255 - b) * shift / 100))
    fi
}

# --- render ----------------------------------------------------------------

# One line of capsules on the terminal's own background. Each group of items
# becomes one capsule: a rounded left cap, the items (joined as each asked), a
# rounded right cap, with no fill space between a cap and the item beside it;
# two default-background cells follow the identity capsule and one follows
# every other. The caps are Powerline glyphs (U+E0B6/U+E0B4) drawn as
# fill-coloured ink on the default background, so they read as the capsule's
# rounded ends; CS_STATUSLINE_CAPS=0 drops the glyphs for a font without them
# and each cap is replaced by a fill space, giving the chip a square edge.
# A crit capsule takes the crit fill and paints every item critink bold.
# SGR bold is stateful, so every item emits its intensity explicitly (1 or 22).
# No width accounting and no tail: the line ends at the last cap.

# Whether to draw the Powerline caps. They are the bar's one private-use glyph,
# so nothing draws them until this machine has said its font has them: the
# installer asks once and records the answer in the per-machine caps file
# (`cs -statusline caps` rewrites it). CS_STATUSLINE_CAPS=1/0 in the
# environment overrides the file either way. Unanswered means square ends.
CAPS_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/cs/statusline-caps"
_caps_wanted() {
    case "${CS_STATUSLINE_CAPS:-}" in
        1) return 0 ;;
        0) return 1 ;;
    esac
    local f="$CAPS_FILE" answer=""
    # A regular, readable file only: a directory at the path would print "Is a
    # directory" on every repaint, and a broken symlink is no answer either.
    [ -f "$f" ] && [ -r "$f" ] && { IFS= read -r answer < "$f"; } 2>/dev/null
    [ "$answer" = "on" ]
}

_render() {
    local n=${#_SEG_TEXT[@]}
    [ "$n" -gt 0 ] || return 0
    local i g="" out=""

    if [ "$LEVEL" = "plain" ]; then
        local k first
        for ((k = 0; k < ${#_GROUPS[@]}; k++)); do
            g="${_GROUPS[k]}"
            [ "$k" -gt 0 ] && out+=" > "
            first=1
            for ((i = 0; i < n; i++)); do
                [ "${_SEG_GROUP[i]}" = "$g" ] || continue
                if [ -z "$first" ]; then
                    case "${_SEG_JOIN[i]}" in
                        dot)       out+=" · " ;;
                        bar)       out+=" ⋮ " ;;
                        pad|space) out+=" " ;;
                    esac
                fi
                first=""
                out+="${_SEG_TEXT[i]}"
            done
        done
        printf '%s\n' "$out"
        return 0
    fi

    local esc=$'\033' reset=$'\033[0m'
    local capl=$'\xee\x82\xb6' capr=$'\xee\x82\xb4'   # U+E0B6, U+E0B4
    _caps_wanted || { capl=""; capr=""; }
    local fill fillsgr capsgr ink weight first k
    out="$reset"
    # Capsules in first-seen group order; a group's items in their own order,
    # even when CS_STATUSLINE_SEGMENTS interleaves them (session,ctx,model).
    for ((k = 0; k < ${#_GROUPS[@]}; k++)); do
        g="${_GROUPS[k]}"
        fill=surface
        case "$_CRIT_GROUPS" in *" $g "*) fill=crit ;; esac
        _sgr 48 "$fill"; fillsgr="$_SGR"
        _sgr 38 "$fill"; capsgr="$_SGR"
        if [ -n "$capl" ]; then
            out+="${esc}[49;${capsgr}m${capl}"
        else
            out+="${esc}[${fillsgr}m "
        fi
        first=1
        for ((i = 0; i < n; i++)); do
            [ "${_SEG_GROUP[i]}" = "$g" ] || continue
            if [ -z "$first" ]; then
                case "${_SEG_JOIN[i]}" in
                    dot)   _sgr 38 ink2; out+="${esc}[${fillsgr};${_SGR};22m  ·  " ;;
                    bar)   _sgr 38 ink2; out+="${esc}[${fillsgr};${_SGR};22m ⋮ " ;;
                    pad)   out+="${esc}[${fillsgr}m  " ;;
                    space) out+="${esc}[${fillsgr}m " ;;
                esac
            fi
            first=""
            ink="${_SEG_INK[i]}"; weight=22
            [ -n "${_SEG_BOLD[i]}" ] && weight=1
            if [ "$fill" = "crit" ]; then ink=critink; weight=1; fi
            _sgr 38 "$ink"
            out+="${esc}[${fillsgr};${_SGR};${weight}m${_SEG_TEXT[i]}"
        done
        if [ -n "$capr" ]; then
            out+="${esc}[49;${capsgr}m${capr}"
        else
            out+="${esc}[${fillsgr}m "
        fi
        out+="$reset"
        [ $((k + 1)) -lt ${#_GROUPS[@]} ] && out+=" "
    done
    printf '%s\n' "$out"
}

# --- band layout -------------------------------------------------------------
#
# CS_STATUSLINE_LAYOUT=band: the same items as the capsules, on one row W
# cells wide whose fill fades from the band colour at cell 0 to the terminal
# background at cell W-1. Items start at cell 1, groups are joined by the dot
# joiner, and blank fill carries the fade to the end.

# Whether $1 is a usable column count: a whole number from 1 to 9999.
_is_cols() {
    case "$1" in ''|0*|*[!0-9]*|?????*) return 1 ;; esac
}

# The terminal's width in columns from stty, in _TTY_COLS; empty when there is
# no terminal to ask. Cached under the parent pid like _sl_own_tty, so a
# conversation forks for it once in OWN_TTY_MAX_AGE, and a resize inside that
# window shows when the entry expires.
_sl_tty_cols() {
    _TTY_COLS=""
    _sl_parent_pid
    # A cached answer is checked like a fresh one: an entry that is not a
    # count (hand-edited, torn, another writer's shape) must not reach `[`
    # or the fill loop, so it reads as no terminal.
    if _cache_read stty "$_PARENT" "$OWN_TTY_MAX_AGE"; then
        _TTY_COLS="$_CACHE_TEXT"
        _is_cols "$_TTY_COLS" || _TTY_COLS=""
        return 0
    fi
    local size
    size=$( { stty size </dev/tty; } 2>/dev/null ) || size=""
    _TTY_COLS="${size#* }"
    _is_cols "$_TTY_COLS" || _TTY_COLS=""
    _cache_write stty "$_PARENT" "$_TTY_COLS"
}

# The band's width in cells, in _BAND_W, never under 20: CS_STATUSLINE_COLS
# as given, since a caller that sets it already knows the cells it may use;
# else a measured width, stdin's .columns, the pane's width inside a tmux this
# process is really in, the terminal's, or 120, less the frame Claude Code
# draws around the status line (CS_STATUSLINE_FRAME, default 4: two columns
# each side, more with statusLine.padding).
_band_width() {
    local cols=""
    if _is_cols "${CS_STATUSLINE_COLS:-}"; then
        _BAND_W="$CS_STATUSLINE_COLS"
    else
        if _is_cols "${SL_COLUMNS:-}"; then
            cols="$SL_COLUMNS"
        elif [ -n "${TMUX:-}" ] && [ -z "${SL_ENV_FOREIGN:-}" ]; then
            _sl_tmux_client
            _is_cols "$_TMUX_CLIENT_WIDTH" && cols="$_TMUX_CLIENT_WIDTH"
        fi
        if [ -z "$cols" ]; then
            _sl_tty_cols
            cols="${_TTY_COLS:-120}"
        fi
        _num_or "${CS_STATUSLINE_FRAME:-}" 4
        _BAND_W=$(( 10#$cols - 10#$_NUM ))
    fi
    [ "$_BAND_W" -ge 20 ] || _BAND_W=20
}

# The terminal background the band fades into, in _BG_R/_BG_G/_BG_B: the one
# read live from iTerm unless a background was set by hand, the measured one,
# else the background the surface token assumes for the theme.
_band_bg() {
    local rgb="${CS_TERM_BG_RGB:-}"
    [ -z "$_SL_LIVE_BG" ] || _sl_bg_pinned || rgb="$_SL_LIVE_BG"
    if ! _parse_rgb_triplet "$rgb"; then
        if [ "$SL_THEME" = "dark" ]; then _parse_rgb_triplet "28;28;28"
        else _parse_rgb_triplet "255;255;255"; fi
    fi
    _BG_R="$_R"; _BG_G="$_G"; _BG_B="$_B"
}

# The band colour in _R/_G/_B, before its pull toward the background, first
# match winning: CS_STATUSLINE_BAND as a palette name, `brand`, `periwinkle` or
# an r;g;b triplet (`none` asks for the neutral outright); the session's own
# colour from its state file; the neutral. An override that names none of these
# is the session colour, so a typo never breaks the bar.
SESSION_PALETTE="red blue green yellow purple orange pink cyan"
_band_from() {
    local want="${CS_STATUSLINE_BAND:-session}"
    # One word only: the list match below would take "red blue" as a name.
    case "$want" in *[[:space:]]*) want=session ;; esac
    case " $SESSION_PALETTE brand periwinkle " in
        *" $want "*) _sgr 48 "$want"; _parse_rgb_triplet "$_RGB"; return 0 ;;
    esac
    [ "$want" = "none" ] && { _band_neutral; return 0; }
    _parse_rgb_triplet "$want" && return 0
    if [ -n "$SL_LOCAL_DIR" ]; then
        _read_state_key "$SL_LOCAL_DIR/state" claude_session_color
        case " $SESSION_PALETTE " in
            *" $_STATE_VALUE "*)
                if [ -n "$_STATE_VALUE" ]; then
                    _sgr 48 "$_STATE_VALUE"; _parse_rgb_triplet "$_RGB"; return 0
                fi ;;
        esac
    fi
    _band_neutral
}

# The neutral band colour in _R/_G/_B: the background lifted a step, lighter
# on a dark terminal and darker on a light one. _BAND_NEUTRAL says it was
# picked.
_band_neutral() {
    _BAND_NEUTRAL=1
    if [ "$SL_THEME" = "dark" ]; then
        _R=$((_BG_R + 40)); _G=$((_BG_G + 40)); _B=$((_BG_B + 50))
        [ "$_R" -le 255 ] || _R=255; [ "$_G" -le 255 ] || _G=255; [ "$_B" -le 255 ] || _B=255
    else
        _R=$((_BG_R - 30)); _G=$((_BG_G - 30)); _B=$((_BG_B - 30))
        [ "$_R" -ge 0 ] || _R=0; [ "$_G" -ge 0 ] || _G=0; [ "$_B" -ge 0 ] || _B=0
    fi
}

# _R/_G/_B moved $4 percent of the way toward $1;$2;$3.
_band_toward() {  # r g b percent
    _R=$((_R + ($1 - _R) * $4 / 100))
    _G=$((_G + ($2 - _G) * $4 / 100))
    _B=$((_B + ($3 - _B) * $4 / 100))
}

# The band's first cell in _FROM_R/_G/_B, and the colour it is made from in
# _HUE_R/_G/_B. A hue is moved halfway to the grey of its own luminance, then
# 78% of the way to the background, so the band is a tint of the terminal and
# ink reads on its start; the neutral is already a step off the background and
# is used as it is.
_band_start() {
    _BAND_NEUTRAL=""
    _band_from
    _HUE_R="$_R"; _HUE_G="$_G"; _HUE_B="$_B"
    if [ -z "$_BAND_NEUTRAL" ]; then
        local lum=$(( (_R * 299 + _G * 587 + _B * 114) / 1000 ))
        _band_toward "$lum" "$lum" "$lum" 50
        _band_toward "$_BG_R" "$_BG_G" "$_BG_B" 78
    fi
    _FROM_R="$_R"; _FROM_G="$_G"; _FROM_B="$_B"
}

# The foreground parameters for item ink $1 (weight $2, "bold" or empty) on the
# band, in _BAND_FG. On truecolor the band has inks of its own, since it is
# brighter than the capsule surface at one end and the terminal at the other:
# a primary for bold text, a secondary for regular text, a dim one for labels
# and joiners. On a light theme they are dark shades of the band's hue
# (_HUE_R/_G/_B), so the text carries the colour the pale band only hints at.
# Tokens with a colour of their own (the brand mark, the effort word, the
# session palette) keep it. Other levels take the capsules' tokens.
_band_ink() {  # token bold
    local role rgb pct=""
    if [ "$LEVEL" = "truecolor" ]; then
        case "$1" in
            white) role=primary ;;
            ink)   role=secondary; [ -n "$2" ] && role=primary ;;
            ink2)  role=dim ;;
        esac
    fi
    if [ -z "${role:-}" ]; then
        _sgr 38 "$1"; _BAND_FG="$_SGR"
        return 0
    fi
    case "$SL_THEME:$role" in
        dark:primary)    rgb="255;255;255" ;;
        dark:secondary)  rgb="214;222;240" ;;
        dark:dim)        rgb="150;165;200" ;;
        *:primary)       pct=34 ;;
        *:secondary)     pct=44 ;;
        *:dim)           pct=56 ;;
    esac
    [ -z "$pct" ] || rgb="$((_HUE_R * pct / 100));$((_HUE_G * pct / 100));$((_HUE_B * pct / 100))"
    _BAND_FG="38;2;$rgb"
}

# The fill under cell _BAND_POS in _CELL_BG: the flat fill below truecolor,
# else the gradient's colour there. A cell past the band's end takes the end's.
_band_cell_bg() {
    if [ -n "$_BAND_FLAT" ]; then
        _CELL_BG="$_BAND_FLAT"
        return 0
    fi
    local p="$_BAND_POS" span=$((_BAND_W - 1))
    [ "$p" -le "$span" ] || p="$span"
    _CELL_BG="48;2;$((_FROM_R + (_BG_R - _FROM_R) * p / span));$((_FROM_G + (_BG_G - _FROM_G) * p / span));$((_FROM_B + (_BG_B - _FROM_B) * p / span))"
}

# Paint text $1 on the band with foreground parameters $2 (empty for blank
# fill) at weight $3. On the gradient each character is its own cell with its
# own fill; a UTF-8 continuation byte, which bash hands over on its own under
# a C locale, stays in its character's cell, the same count _display_width
# makes. On a flat fill the text is one run.
_band_text() {  # text fg weight
    local s="$1" tail="" i c n=${#1}
    [ -n "$2" ] && tail=";$2;$3"
    if [ -n "$_BAND_FLAT" ]; then
        _display_width "$s"
        _BAND_OUT+=$'\033['"${_BAND_FLAT}${tail}m${s}"
        _BAND_POS=$((_BAND_POS + _WIDTH))
        return 0
    fi
    for ((i = 0; i < n; i++)); do
        c="${s:i:1}"
        case "$c" in
            [$'\x80'-$'\xBF']) _BAND_OUT+="$c"; continue ;;
        esac
        _band_cell_bg
        _BAND_OUT+=$'\033['"${_CELL_BG}${tail}m${c}"
        _BAND_POS=$((_BAND_POS + 1))
    done
}

# A solid island: text $3 on fill $1 in ink $2, bold, one run with no gradient
# under it; its cells still count toward the band's positions.
_band_island() {  # fill fg text
    _display_width "$3"
    _BAND_OUT+=$'\033['"$1;$2;1m$3"
    _BAND_POS=$((_BAND_POS + _WIDTH))
}

# The text joiner $1 puts between two items of a group, in _JOIN_TEXT, and in
# _JOIN_INKED whether it is a glyph drawn in the dim ink rather than blank fill.
_band_joiner() {
    _JOIN_INKED=""
    case "$1" in
        dot)   _JOIN_TEXT="  ·  "; _JOIN_INKED=1 ;;
        bar)   _JOIN_TEXT=" ⋮ ";  _JOIN_INKED=1 ;;
        pad)   _JOIN_TEXT="  " ;;
        space) _JOIN_TEXT=" " ;;
        *)     _JOIN_TEXT="" ;;
    esac
}

# $1 cells of blank fill as one run, coloured at its first cell.
_band_blank() {
    _band_cell_bg
    local pad
    printf -v pad '%*s' "$1" ''
    _BAND_OUT+=$'\033['"${_CELL_BG}m${pad}"
    _BAND_POS=$((_BAND_POS + $1))
}

_render_band() {
    local n=${#_SEG_TEXT[@]}
    [ "$n" -gt 0 ] || return 0
    _band_width
    _BAND_OUT=$'\033[0m'; _BAND_POS=0; _BAND_FLAT=""
    if [ "$LEVEL" = "truecolor" ]; then
        _band_bg
        _band_start
    else
        _sgr 48 surface; _BAND_FLAT="$_SGR"
    fi
    _band_blank 1
    local i k g first weight island fill
    for ((k = 0; k < ${#_GROUPS[@]}; k++)); do
        g="${_GROUPS[k]}"
        if [ "$k" -gt 0 ]; then
            _band_ink ink2 ""; _band_text "  ·  " "$_BAND_FG" 22
        fi
        # A crit group is one red island, its joiners inside it.
        case "$_CRIT_GROUPS" in
            *" $g "*)
                island=" "; first=1
                for ((i = 0; i < n; i++)); do
                    [ "${_SEG_GROUP[i]}" = "$g" ] || continue
                    if [ -z "$first" ]; then
                        _band_joiner "${_SEG_JOIN[i]}"; island+="$_JOIN_TEXT"
                    fi
                    first=""
                    island+="${_SEG_TEXT[i]}"
                done
                _sgr 48 crit; fill="$_SGR"; _sgr 38 critink
                _band_island "$fill" "$_SGR" "$island "
                continue ;;
        esac
        first=1
        for ((i = 0; i < n; i++)); do
            [ "${_SEG_GROUP[i]}" = "$g" ] || continue
            if [ -z "$first" ]; then
                _band_joiner "${_SEG_JOIN[i]}"
                if [ -n "$_JOIN_INKED" ]; then
                    _band_ink ink2 ""; _band_text "$_JOIN_TEXT" "$_BAND_FG" 22
                else
                    _band_text "$_JOIN_TEXT" "" ""
                fi
            fi
            first=""
            # An amber item is amber ink, bold on either theme, as on the
            # capsules.
            if [ "${_SEG_INK[i]}" = "amber" ]; then
                _sgr 38 amber; _band_text "${_SEG_TEXT[i]}" "$_SGR" 1
                continue
            fi
            weight=22
            [ -n "${_SEG_BOLD[i]}" ] && [ "$SL_THEME" = "dark" ] && weight=1
            _band_ink "${_SEG_INK[i]}" "${_SEG_BOLD[i]}"
            _band_text "${_SEG_TEXT[i]}" "$_BAND_FG" "$weight"
        done
    done
    # The fade runs on to the last cell in runs of up to four, and the last
    # cell is a run of its own so it lands exactly on the background.
    local last=$((_BAND_W - 1)) step
    while [ "$_BAND_POS" -lt "$last" ]; do
        step=$((last - _BAND_POS))
        [ "$step" -le 4 ] || step=4
        _band_blank "$step"
    done
    [ "$_BAND_POS" -eq "$last" ] && _band_blank 1
    printf '%s\033[0m\n' "$_BAND_OUT"
}

# --- quiet layout ------------------------------------------------------------
#
# The default layout (CS_STATUSLINE_LAYOUT unset, quiet or any value other
# than band and capsules): the items as text on the terminal's own
# background. The mark and the session name sit in one chip tinted with the
# session's colour, the name in a shade of it (_quiet_chip_fill). The readings
# are bold in the terminal's own foreground and the branch is the terminal's
# green, so they read on whatever background the terminal wears, the theme
# detected at launch notwithstanding. The labels and joiners fade, run by run,
# toward the background. An amber reading is bold amber; a crit reading and its
# label are a red chip of their own. The brand mark keeps its coral, and the
# model's glyph wears the effort's colour beside the effort word.

# The quiet ink $1 percent of the way to the background, as foreground
# parameters in _QUIET_FG.
_quiet_fade() {
    _QUIET_FG="38;2;$((_QI_R + (_BG_R - _QI_R) * $1 / 100));$((_QI_G + (_BG_G - _QI_G) * $1 / 100));$((_QI_B + (_BG_B - _QI_B) * $1 / 100))"
}

# The foreground for run $1 of $2 after the chip, in _QUIET_FG: from 35 to 55
# percent of the way to the background, the first run darkest; further, the
# last labels lose the contrast to be read on a light terminal. Below
# truecolor there is no fade: the secondary ink at 256 colours, bright black
# at basic.
_quiet_run_ink() {
    if [ "$LEVEL" = "basic" ]; then
        _QUIET_FG=90
        return 0
    fi
    if [ -z "$_QUIET_TRUE" ]; then
        _sgr 38 ink2; _QUIET_FG="$_SGR"
        return 0
    fi
    local span=$(($2 - 1))
    [ "$span" -ge 1 ] || span=1
    local run="$1"
    [ "$run" -ge 1 ] || run=1
    _quiet_fade $((35 + 20 * (run - 1) / span))
}

# The chip's fill in _R/_G/_B and its text in _CHIP_INK, both from the band's
# colour (CS_STATUSLINE_BAND, else the session's). The fill is that colour seen
# through the terminal background (_band_bg), 35% of it on a dark terminal and
# 15% on a light one; the text is the colour lifted toward white on a dark
# terminal and pressed toward black on a light one. With no colour the fill is
# the neutral step off the background and the text the terminal's own ink.
_quiet_chip_fill() {
    _CHIP_INK=39
    _BAND_NEUTRAL=""
    _band_from
    [ -z "$_BAND_NEUTRAL" ] || return 0
    local r="$_R" g="$_G" b="$_B"
    if [ "$SL_THEME" = "dark" ]; then
        _band_toward 255 255 255 60
        _CHIP_INK="38;2;$_R;$_G;$_B"
        _R="$r"; _G="$g"; _B="$b"
        _band_toward "$_BG_R" "$_BG_G" "$_BG_B" 65
    else
        _band_toward 0 0 0 50
        _CHIP_INK="38;2;$_R;$_G;$_B"
        _R="$r"; _G="$g"; _B="$b"
        _band_toward "$_BG_R" "$_BG_G" "$_BG_B" 85
    fi
}

# Whether item $1 belongs in a red chip: a crit reading, or the label just
# before one in its group.
_quiet_in_crit() {
    [ "${_SEG_INK[$1]}" = "crit" ] && return 0
    local next=$(($1 + 1))
    [ "$next" -lt "${#_SEG_TEXT[@]}" ] || return 1
    [ "${_SEG_INK[$next]}" = "crit" ] && [ "${_SEG_ROLE[$next]}" = "value" ] \
        && [ "${_SEG_GROUP[$next]}" = "${_SEG_GROUP[$1]}" ]
}

# Whether item $1 starts a new run: the first item of a group after the
# first, or an item joined by a dot.
_quiet_new_run() {
    [ "$1" -gt 0 ] || return 1
    [ "${_SEG_GROUP[$1]}" != "${_SEG_GROUP[$(($1 - 1))]}" ] && return 0
    [ "${_SEG_JOIN[$1]}" = "dot" ]
}

_render_quiet() {
    local n=${#_SEG_TEXT[@]}
    [ "$n" -gt 0 ] || return 0
    local e=$'\033' out=$'\033[0m' i runs=0 run=0 join critchip="" critbg critfg chipbg chipfg inchip=""
    _sgr 48 crit; critbg="$_SGR"; _sgr 38 critink; critfg="$_SGR"
    _QUIET_TRUE=""
    [ "$LEVEL" = "truecolor" ] && _QUIET_TRUE=1
    if [ -n "$_QUIET_TRUE" ]; then
        _band_bg
        if [ "$SL_THEME" = "dark" ]; then
            _QI_R=214; _QI_G=222; _QI_B=240
        else
            _QI_R=$((_BG_R * 24 / 100)); _QI_G=$((_BG_G * 24 / 100)); _QI_B=$((_BG_B * 24 / 100))
        fi
        _quiet_chip_fill; chipbg="48;2;$_R;$_G;$_B"; chipfg="$_CHIP_INK"
    elif [ "$SL_THEME" != "dark" ]; then
        chipfg=39
        if [ "$LEVEL" = "256" ]; then chipbg="48;5;253"; else chipbg=47; fi
    elif [ "$LEVEL" = "256" ]; then
        chipbg="48;5;241"; chipfg="38;5;231"
    else
        chipbg=100; chipfg=97
    fi
    for ((i = 0; i < n; i++)); do
        _quiet_new_run "$i" && runs=$((runs + 1))
    done
    for ((i = 0; i < n; i++)); do
        if _quiet_new_run "$i"; then
            run=$((run + 1))
        fi
        _quiet_run_ink "$run" "$runs"
        # The chip closes before the first item that is not part of it.
        if [ -n "$inchip" ] && [ "${_SEG_ROLE[i]}" != "chip" ]; then
            out+="${e}[${chipbg}m ${e}[0m"; inchip=""
        fi
        local closed=""
        if [ -n "$critchip" ] && { [ "${_SEG_GROUP[i]}" != "$critchip" ] || ! _quiet_in_crit "$i"; }; then
            out+="${e}[${critbg}m ${e}[0m"; critchip=""; closed=1
        fi
        if [ "$i" -gt 0 ]; then
            join="${_SEG_JOIN[i]}"
            [ "${_SEG_GROUP[i]}" != "${_SEG_GROUP[$((i - 1))]}" ] && join="dot"
            _band_joiner "$join"
            # A red chip's own pad stands for one space of a two-space joiner
            # beside it; a one-space joiner keeps its space.
            case "$closed:$_JOIN_TEXT" in 1:"  "*) _JOIN_TEXT="${_JOIN_TEXT# }" ;; esac
            if [ -z "$critchip" ] && _quiet_in_crit "$i"; then
                case "$_JOIN_TEXT" in *"  ") _JOIN_TEXT="${_JOIN_TEXT% }" ;; esac
            fi
            if [ -n "$inchip" ]; then
                out+="${e}[${chipbg}m${_JOIN_TEXT}"
            elif [ -n "$critchip" ]; then
                out+="${e}[${critbg};${critfg};1m${_JOIN_TEXT}"
            elif [ -n "$_JOIN_INKED" ]; then
                out+="${e}[0;${_QUIET_FG}m${_JOIN_TEXT}"
            else
                out+="${e}[0m${_JOIN_TEXT}"
            fi
        fi
        # The mark is Claude's coral in the chip, the waiting session's shade
        # included; the session name is bold in the chip's ink.
        if [ "${_SEG_ROLE[i]}" = "chip" ]; then
            [ -n "$inchip" ] || out+="${e}[0;${chipbg}m "
            inchip=1
            case "${_SEG_INK[i]}" in
                brand|brandshade) _sgr 38 brand; out+="${e}[${chipbg};${_SGR};1m${_SEG_TEXT[i]}" ;;
                *)                out+="${e}[${chipbg};${chipfg};1m${_SEG_TEXT[i]}" ;;
            esac
            continue
        fi
        # The branch is the terminal's own green, the path before its last
        # `/` (feat/, fix/) the same green faint; the marks after it, ahead
        # and behind arrows included, fade with the labels.
        if [ "${_SEG_ROLE[i]}" = "branch" ]; then
            local glyph="$ICON_GIT" body name marks="" head="" leaf
            case "${_SEG_TEXT[i]}" in
                "$ICON_GIT"*) body="${_SEG_TEXT[i]#"$ICON_GIT"}" ;;
                *)            glyph=""; body="${_SEG_TEXT[i]}" ;;
            esac
            name="${body%% *}"
            [ "$name" = "$body" ] || marks=" ${body#* }"
            case "$name" in
                *↑*) marks="↑${name#*↑}$marks"; name="${name%%↑*}" ;;
                *↓*) marks="↓${name#*↓}$marks"; name="${name%%↓*}" ;;
            esac
            case "$name" in
                */*) head="${name%/*}/"; leaf="${name##*/}" ;;
                *)   leaf="$name" ;;
            esac
            out+="${e}[0;32m${glyph}"
            [ -z "$head" ] || out+="${e}[0;2;32m${head}${e}[0;32m"
            out+="$leaf"
            [ -z "$marks" ] || out+="${e}[0;${_QUIET_FG}m${marks}"
            continue
        fi
        if _quiet_in_crit "$i"; then
            [ -n "$critchip" ] || out+="${e}[0;${critbg}m "
            critchip="${_SEG_GROUP[i]}"
            out+="${e}[${critbg};${critfg};1m${_SEG_TEXT[i]}"
            continue
        fi
        case "${_SEG_INK[i]}" in
            amber)
                _sgr 38 amber; out+="${e}[0;${_SGR};1m${_SEG_TEXT[i]}"
                continue ;;
            ink|ink2|white) ;;
            *)
                _sgr 38 "${_SEG_INK[i]}"; out+="${e}[0;${_SGR}m${_SEG_TEXT[i]}"
                continue ;;
        esac
        if [ "${_SEG_ROLE[i]}" = "model" ]; then
            local glyph="${ICON_MODEL% }" next=$((i + 1))
            case "${_SEG_TEXT[i]}" in "$ICON_MODEL"*) ;; *) glyph="" ;; esac
            if [ -n "$glyph" ] && [ "$next" -lt "$n" ]; then
                case "${_SEG_INK[$next]}" in
                    effort-*)
                        _sgr 38 "${_SEG_INK[$next]}"
                        out+="${e}[0;${_SGR}m${glyph}${e}[0;${_QUIET_FG}m${_SEG_TEXT[i]#"$glyph"}"
                        continue ;;
                esac
            fi
        fi
        if [ "${_SEG_ROLE[i]}" = "value" ]; then
            out+="${e}[0;39;1m${_SEG_TEXT[i]}"
        else
            out+="${e}[0;${_QUIET_FG}m${_SEG_TEXT[i]}"
        fi
    done
    [ -n "$inchip" ] && out+="${e}[${chipbg}m "
    [ -n "$critchip" ] && out+="${e}[${critbg}m "
    printf '%s\033[0m\n' "$out"
}

# --- main ------------------------------------------------------------------

main() {
    [ "${CS_STATUSLINE_DISABLE:-}" = "1" ] && exit 0

    # Out-of-band refresh mode. Re-invoking this script rather than installing a
    # second binary keeps the feature to one file and off the install manifest.
    if [ "${1:-}" = "--refresh-usage" ]; then
        _refresh_usage
        exit 0
    fi

    _read_stdin
    _parse_stdin "$_STDIN" || _fallback

    _detect_level

    local segments="${CS_STATUSLINE_SEGMENTS:-logo,session,notes,mail,git,model,ctx,limits}"
    _LIMITS_NAMED=""
    case ",$segments," in *,limits,*) _LIMITS_NAMED=1 ;; esac
    local name names
    IFS=',' read -ra names <<< "$segments"
    for name in "${names[@]}"; do
        case "$name" in
            logo)    _seg_logo ;;
            session) _seg_session ;;
            notes)   _seg_notes ;;
            mail)    _seg_mail ;;
            pane)    _seg_pane ;;
            ctx)     _seg_ctx ;;
            model)   _seg_model ;;
            git)     _seg_git ;;
            limits)  _seg_limits ;;
            fable)   _seg_fable ;;
            cost)    _seg_cost ;;
        esac
    done

    # Quiet is the layout unless CS_STATUSLINE_LAYOUT names the band or the
    # capsules; quiet and the band need colour to draw, so plain prints what
    # the capsules print.
    if [ "$LEVEL" = "plain" ]; then
        _render
        return 0
    fi
    case "${CS_STATUSLINE_LAYOUT:-}" in
        capsules) _render ;;
        band)     _render_band ;;
        *)        _render_quiet ;;
    esac
}

# Sourced with CS_STATUSLINE_LIB=1, this file is a library: the palette, color
# ladder, and width helpers load without rendering. `return` is not usable here
# because it is an error outside a function in an executed script.
[ "${CS_STATUSLINE_LIB:-}" = "1" ] || main "$@"
